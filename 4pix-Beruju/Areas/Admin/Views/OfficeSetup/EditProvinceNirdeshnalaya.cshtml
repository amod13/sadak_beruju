@model _4pix_Beruju.Areas.Admin.Models.OfficeSetup

@{
    ViewBag.Title = "AddProvincesMinistry";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
}

<div class="breadcrumb-holder">
    <div class="container-fluid">
        <ul class="breadcrumb">
            <li class="breadcrumb-item"><a href="index.html">Home</a></li>
            <li class="breadcrumb-item active">निर्देशनालय</li>
        </ul>
    </div>
</div>
<section class="forms">
    <div class="container-fluid">
        <!-- Page Header-->
        <header>
            <h3 class="h3 display">निर्देशनालय</h3>
        </header>
        <div class="row">
            <div class="col-lg-12">
                <div class="card">
                    <div class="card-header d-flex align-items-center">

                        @if (ViewBag.ErrorMessage != null)
                        {
                            <h4>@ViewBag.ErrorMessage</h4>
                        }

                    </div>
                    <div class="card-body">

                        @using (Html.BeginForm("EditProvinceNirdeshnalaya", "OfficeSetup", FormMethod.Post,
new { enctype = "multipart/form-data" }))
                        {
                            @Html.HiddenFor(m => m.OfficeDetailId)

                            @Html.ValidationSummary(true)
                        <fieldset>

                            <div class="row">
                                <div class="col-md-4 col-sm-4 form-group">
                                    <label>मन्त्रालय</label>
                                    @Html.DropDownListFor(m => m.OfficeDetailId, _4pix_Beruju.Utilities.GetMinistryList(Model.ProvinceId, 2), new { @class = "form-control form-control-sm", @required = "required", @id = "ddl_ministry", onchange = "GetBivagFromMinistryDD()" })
                                </div>
                            </div>

                            <div class="row">
                                <div class="col-md-4 col-sm-4 form-group">
                                    <label>विभाग</label>
                                    @Html.DropDownListFor(m => m.MainOfficeId, _4pix_Beruju.Utilities.GetNirdeshayalaDefault(), new { @class = "form-control form-control-sm", @required = "required", @id = "ddl_nirdesh" })
                                </div>
                            </div>

                            @Html.Partial("_CreateEdit")

                            <div class="form-group">
                                @*<button type="submit" class="btn btn-secondary"><i class="fa fa-angle-double-left">&nbsp;</i> Back</button> &nbsp; &nbsp; &nbsp;*@
                                <button type="submit" class="btn btn-primary"><i class="fa fa-floppy-o">&nbsp;</i>सुरक्छित गर्नुहोस</button>
                                <a href="@Url.Action("ProvinceNirdeshnalaya","OfficeSetup")" , class="btn btn-sm btn-success">
                                    <i class="fa fa-backward"></i>&nbsp;मूख्य मेनु
                                </a>
                            </div>
                        </fieldset>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>


<script src="~/Scripts/jquery-3.3.1.min.js"></script>
<script src="~/Scripts/jquery.unobtrusive-ajax.js"></script>


<script type="text/javascript">

          function GetDistrictListDD() {

     var value = $("#dll_province option:selected").val();
     $.ajax({
         url: "@Url.Action("GetDistrictListByProvinceIdDefaultValue", "AjaxRequest", new { @area = "Admin" })",
         data: { id: value },
         dataType: "json",
         type: "POST",
         error: function () {
             alert("An error occurred.");
         },
         success: function (data) {
             var items = "";
             $.each(data, function (i, item) {
                 items += "<option value=\"" + item.Value + "\">" + item.Text + "</option>";
             });

             $("#dll_district").html(items);
         }
     })
 };

    function GetVDCMUNListDD() {
        var value = $("#dll_district option:selected").val();
        $.ajax({
            @*url: "@Url.Action("GetVDCMUNDDByDistrictId", "AjaxRequest", new { @area="admin"})",*@
            url: "@Url.Action("GetVDCMUNDDByDistrictIdWithDefaultValue", "AjaxRequest", new { @area = "Admin" })",
            data: { id: value },
            dataType: "json",
            type: "POST",
            error: function () {
                GetVDCMUNDDByDistrictId
                alert("An error occurred.");
            },
            success: function (data) {
                var items = "";
                $.each(data, function (i, item) {
                    items += "<option value=\"" + item.Value + "\">" + item.Text + "</option>";
                });

                $("#dll_vdcmun").html(items);
            }
        })
    };




function GetBivagFromMinistryDD(selectedValue) {
    var value = $("#ddl_ministry option:selected").val();

    $.ajax({
        url: "@Url.Action("GetBivagFromMinistryDD", "AjaxRequest", new { @area = "Admin" })",
        data: { id: value },
        dataType: "json",
        type: "POST",
        error: function () {
            alert("An error occurred while loading Bivag.");
        },
        success: function (data) {
            var items = "";
            $.each(data, function (i, item) {
                items += "<option value='" + item.Value + "'>" + item.Text + "</option>";
            });

            $("#ddl_nirdesh").html(items);

            // ✅ Preselect the existing value in edit mode
            if (selectedValue) {
                $("#ddl_nirdesh").val(selectedValue);
            }
        }
    });
}

$(document).ready(function () {
    // Detect if this is edit mode
    var existingValue = '@Model.MainOfficeId'; // your current saved value

    // Call function with the selected value
    GetBivagFromMinistryDD(existingValue);
});



</script>








