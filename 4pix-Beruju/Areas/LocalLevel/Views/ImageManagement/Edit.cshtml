@model _4pix_Beruju.Models.BerujuFilesByDafaVM
@{
    ViewBag.Title = "Edit";
    Layout = "~/Areas/LocalLevel/Views/Shared/_LocalLevelLayout.cshtml";
}

<div class="breadcrumb-holder">
    <div class="container-fluid">
        <ul class="breadcrumb">
            <li class="breadcrumb-item"><a href="#">Home</a></li>
            <li class="breadcrumb-item active">बेरुजु दफा अनुसार फाईल सम्पादन</li>
        </ul>
    </div>
</div>

<section class="forms">
    <div class="container-fluid">
        <div class="row">
            <div class="col-lg-12">
                <div class="card">
                    <div class="card-body">

                        @using (Html.BeginForm("Edit", "ImageManagement",
                            FormMethod.Post, new { enctype = "multipart/form-data" }))
                        {
                            @Html.AntiForgeryToken()
                            @Html.HiddenFor(m => m.Id)

                            <div class="row">

                                <div class="col-md-3 col-sm-6 form-group">
                                    <label>कार्यालय प्रकार</label>
                                    @Html.DropDownListFor(m => m.OfficeTypeSearchId,
                                        Utilities.GetOfficeTypeDDWithDefaultForSuperAdmin(),
                                        new { @class = "form-control", id = "dll_OfficeType" })
                                </div>

                                <div class="col-md-3 col-sm-6 form-group">
                                    <label>मन्त्रालय</label>
                                    @Html.DropDownListFor(m => m.MininstrySearchId,
                                        Utilities.GetMinistryListWithDefaultForProvinceAdmin(0, 2),
                                        new { @class = "form-control", id = "dll_ministry" })
                                </div>

                                <div class="col-md-3 col-sm-6 form-group">
                                    <label>विभाग</label>
                                    @Html.DropDownListFor(m => m.BivagSearchId,
                                        Utilities.GetNirdeshayalaDefault(),
                                        new { @class = "form-control", id = "dll_bivag" })
                                </div>

                                <div class="col-md-3 col-sm-6 form-group">
                                    <label>निर्देशनालय</label>
                                    @Html.DropDownListFor(m => m.NirdeshnalayaSearchId,
                                        Utilities.GetNirdeshayalaDefault(),
                                        new { @class = "form-control", id = "dll_nirdesh" })
                                </div>

                                <div class="col-md-3 col-sm-6 form-group">
                                    <label>कार्यालय/अन्य</label>
                                    @Html.DropDownListFor(m => m.KaryalayaSearchId,
                                        Utilities.GetNirdeshayalaDefault(),
                                        new { @class = "form-control", id = "dll_office" })
                                </div>

                                <div class="col-md-3">
                                    <label>आर्थिक वर्ष</label>
                                    @Html.DropDownListFor(m => m.FiscalYearId,
                                        _4pix_Beruju.Areas.Admin.functions.GetFiscalYearListWithDefaultDDAll(),
                                        new { @class = "form-control", id = "dll_fyId" })
                                </div>

                                <div class="col-md-3">
                                    <label>कुल बेरुजु दफा</label>
                                    @Html.TextBoxFor(m => m.TotalBerujuDafa,
                                        new { @class = "form-control", type = "number" })
                                </div>
                            </div>

                            <hr />

                            <!-- EXISTING FILES -->
                            <h5>अपलोड भएका फाइलहरू</h5>

                            <table class="table table-bordered">
                                <thead>
                                    <tr>
                                        <th>File</th>
                                        <th width="120">Action</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @if (Model.ExistingFiles != null && Model.ExistingFiles.Any())
                                    {
                                        foreach (var file in Model.ExistingFiles)
                                        {
                                            <tr id="row_@file.DocumentId">
                                                <td>
                                                    <a href="@Url.Content(file.FilePath)" target="_blank">
                                                        @file.FileName
                                                    </a>
                                                </td>
                                                <td>
                                                    <button type="button"
                                                            class="btn btn-danger btn-sm btn-delete-file"
                                                            data-id="@file.DocumentId">
                                                        Delete
                                                    </button>
                                                </td>
                                            </tr>
                                        }
                                    }
                                    else
                                    {
                                        <tr>
                                            <td colspan="2">No files uploaded</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>

                            <hr />

                            <!-- ADD NEW FILES -->
                            <h5>नयाँ फाइल थप्नुहोस्</h5>

                            <div id="fileContainer">
                                <div class="file-row mb-2">
                                    <input type="file" name="Files" class="form-control d-inline-block" style="width:85%" />
                                    <button type="button" class="btn btn-success btn-add">+</button>
                                </div>
                            </div>

                            <br />
                            <button type="submit" class="btn btn-primary">
                                <i class="fa fa-save"></i> अपडेट गर्नुहोस्
                            </button>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- SCRIPTS (LOAD JQUERY ONCE IN LAYOUT, NOT AGAIN) -->
<script src="~/Scripts/jquery-3.3.1.min.js"></script>

<script type="text/javascript" src="https://ajax.googleapis.com/ajax/libs/jquery/1.8.3/jquery.min.js"></script>

<script src="~/Scripts/SweetAlert.min.js"></script>


<script src="~/Scripts/dropdown_helper.js"></script>

<script>
    const url_bivag = '@Url.Action("GetBivagFromMinistryDD", "AjaxRequest", new { area = "admin" })';
    const url_nirdesh = '@Url.Action("GetNirdeshanalayaList", "AjaxRequest", new { area = "admin" })';
    const url_office = '@Url.Action("GetOfficesList", "AjaxRequest", new { area = "admin" })';
</script>

<script>
    jQuery(document).ready(function ($) {

        // ADD FILE INPUT
        $(document).on("click", ".btn-add", function () {
            $("#fileContainer").append(`
                <div class="file-row mb-2">
                    <input type="file" name="Files" class="form-control d-inline-block" style="width:85%" />
                    <button type="button" class="btn btn-danger btn-remove">-</button>
                </div>
            `);
        });

        // REMOVE FILE INPUT
        $(document).on("click", ".btn-remove", function () {
            $(this).closest(".file-row").remove();
        });

        // DELETE EXISTING FILE (AJAX)
        $(document).on("click", ".btn-delete-file", function () {
            var id = $(this).data("id");
            var row = $("#row_" + id);

            if (!confirm("Are you sure you want to delete this file?"))
                return;

            $.post('@Url.Action("DeleteFile", "ImageManagement")',
                {
                    id: id,
                    __RequestVerificationToken: $('input[name="__RequestVerificationToken"]').val()
                },
                function (res) {
                    if (res.success) {
                        row.remove();
                    } else {
                        alert("Failed to delete file");
                    }
                });
        });

    });
</script>
