    <script>
        let currentZoom = 1;
        let currentRotation = 0;
        let currentFileType = '';
        let currentFileUrl = '';

        function resetPreviewState() {
            currentZoom = 1;
            currentRotation = 0;
            currentFileType = '';
            currentFileUrl = '';
        }

        function getFileNameFromPath(path) {
            return path.split('/').pop();
        }

        function getFileIcon(ext) {
            ext = ext.toLowerCase();

            if (['jpg', 'jpeg', 'png', 'gif', 'bmp', 'webp'].includes(ext)) return 'fa-regular fa-image text-info';
            if (ext === 'pdf') return 'fa-regular fa-file-pdf text-danger';
            if (['doc', 'docx'].includes(ext)) return 'fa-regular fa-file-word text-primary';
            if (['xls', 'xlsx', 'csv'].includes(ext)) return 'fa-regular fa-file-excel text-success';
            if (['ppt', 'pptx'].includes(ext)) return 'fa-regular fa-file-powerpoint text-warning';
            if (['txt', 'log', 'json', 'xml'].includes(ext)) return 'fa-regular fa-file-lines text-secondary';
            if (['zip', 'rar', '7z'].includes(ext)) return 'fa-regular fa-file-zipper text-dark';

            return 'fa-regular fa-file text-secondary';
        }

        function previewFile(fileUrl) {
            resetPreviewState();

            currentFileUrl = fileUrl;
            const ext = fileUrl.split('.').pop().toLowerCase();
            currentFileType = ext;

            const previewDiv = document.getElementById("filePreview");
            const fileName = getFileNameFromPath(fileUrl);
            const iconClass = getFileIcon(ext);

            previewDiv.innerHTML = `
            
                <div class="preview-toolbar">
                    <a href="${fileUrl}" download class="btn btn-success btn-sm">
                        <i class="fa-solid fa-download me-1"></i> Download
                    </a>

                    <a href="${fileUrl}" target="_blank" class="btn btn-outline-primary btn-sm">
                        <i class="fa-solid fa-up-right-from-square me-1"></i> Open
                    </a>

                    <button type="button" class="btn btn-outline-secondary btn-sm" onclick="zoomIn()">
                        <i class="fa-solid fa-magnifying-glass-plus me-1"></i> Zoom In
                    </button>

                    <button type="button" class="btn btn-outline-secondary btn-sm" onclick="zoomOut()">
                        <i class="fa-solid fa-magnifying-glass-minus me-1"></i> Zoom Out
                    </button>

                  

                    <button type="button" id="rotateLeftBtn" class="btn btn-outline-warning btn-sm" onclick="rotateLeft()" style="display:none;">
                        <i class="fa-solid fa-rotate-left me-1"></i> 
                    </button>

                    <button type="button" id="rotateRightBtn" class="btn btn-outline-warning btn-sm" onclick="rotateRight()" style="display:none;">
                        <i class="fa-solid fa-rotate-right me-1"></i> 
                    </button>

                      <button type="button" class="btn btn-outline-secondary btn-sm" onclick="resetZoom()">
                          <i class="fa-solid fa-arrows-rotate me-1"></i> Reset
                      </button>

                </div>

                <div class="preview-stage" id="previewStage"></div>
            `;

            const stage = document.getElementById("previewStage");

            // IMAGE PREVIEW
            if (['jpg', 'jpeg', 'png', 'gif', 'bmp', 'webp'].includes(ext)) {
                document.getElementById('rotateLeftBtn').style.display = 'inline-block';
                document.getElementById('rotateRightBtn').style.display = 'inline-block';

                stage.innerHTML = `
                    <img id="previewImage" src="${fileUrl}" alt="${fileName}" />
                `;
            }
            // PDF PREVIEW
            else if (ext === 'pdf') {
                stage.innerHTML = `
                    <div id="pdfWrapper" style="transform: scale(1); transform-origin: top center; transition: transform 0.25s ease;">
                        <embed id="previewPdf" src="${fileUrl}" type="application/pdf" />
                    </div>
                `;
            }
            // TEXT-LIKE PREVIEW
            else if (['txt', 'log', 'csv', 'json', 'xml'].includes(ext)) {
                fetch(fileUrl)
                    .then(r => {
                        if (!r.ok) throw new Error('Cannot load file');
                        return r.text();
                    })
                    .then(txt => {
                        stage.innerHTML = `
                            <pre style="text-align:left; white-space:pre-wrap; word-break:break-word; background:#fff; border:1px solid #e5e7eb; border-radius:8px; padding:15px; max-height:65vh; overflow:auto;">${escapeHtml(txt)}</pre>
                        `;
                    })
                    .catch(() => {
                        stage.innerHTML = `
                            <div class="unsupported-box">
                                <i class="fa-solid fa-triangle-exclamation"></i>
                                <p class="mb-2">Could not preview this text file.</p>
                                <p class="small mb-0">You can still download or open it.</p>
                            </div>
                        `;
                    });
            }
            // OFFICE / UNSUPPORTED
            else {
                stage.innerHTML = `
                    <div class="unsupported-box">
                        <i class="${iconClass}"></i>
                        <h6 class="mb-2">Preview not available in browser</h6>
                        <p class="mb-2">This file type cannot be previewed directly here.</p>
                        <p class="small mb-0">Use <strong>Open</strong> or <strong>Download</strong>.</p>
                    </div>
                `;
            }
        }

        function escapeHtml(str) {
            return str
                .replace(/&/g, "&amp;")
                .replace(/</g, "&lt;")
                .replace(/>/g, "&gt;");
        }

        function applyTransform() {
            // Image transform
            const img = document.getElementById("previewImage");
            if (img) {
                img.style.transform = `scale(${currentZoom}) rotate(${currentRotation}deg)`;
            }

            // PDF transform (zoom only)
            const pdfWrapper = document.getElementById("pdfWrapper");
            if (pdfWrapper) {
                pdfWrapper.style.transform = `scale(${currentZoom})`;
            }
        }

        function zoomIn() {
            currentZoom += 0.1;
            applyTransform();
        }

        function zoomOut() {
            if (currentZoom > 0.2) {
                currentZoom -= 0.1;
                applyTransform();
            }
        }

        function resetZoom() {
            currentZoom = 1;
            currentRotation = 0;
            applyTransform();
        }

        function rotateLeft() {
            if (isImageType()) {
                currentRotation -= 90;
                applyTransform();
            }
        }

        function rotateRight() {
            if (isImageType()) {
                currentRotation += 90;
                applyTransform();
            }
        }

        function isImageType() {
            return ['jpg', 'jpeg', 'png', 'gif', 'bmp', 'webp'].includes(currentFileType);
        }

        // Tree toggle
        document.addEventListener("DOMContentLoaded", function () {
            document.querySelectorAll('.folder-toggle').forEach(function (toggle) {
                toggle.addEventListener('click', function () {
                    var li = this.closest('li');
                    li.classList.toggle('open');

                    var icon = this.querySelector('i');
                    if (icon) {
                        icon.classList.toggle('fa-folder');
                        icon.classList.toggle('fa-folder-open');
                    }
                });
            });
        });
    </script>


@helper RenderTree(_4pix_Beruju.Models.FileTreeNodeVM node, int fiscalYearId)
{
    <li>
        @if (node.IsDirectory)
        {
            <span class="folder-toggle">
                <i class="fa-solid fa-folder text-warning"></i>
                @node.Name
            </span>
            if (node.Children != null && node.Children.Any())
            {
                <ul>
                    @foreach (var child in node.Children)
                    {
                        @RenderTree(child, fiscalYearId)
                    }
                </ul>
            }
        }
        else
        {

            @*<a href="javascript:void(0);" onclick="previewFile('@Url.Content("~/Uploads/BerujuFiles/Raw/" + fiscalYearId + "/" + node.RelativePath)')">
                📄   @node.Name
            </a>*@

            <a href="javascript:void(0);" onclick="previewFile('@Url.Action("ViewFile", "ImageManagement", new { area = "LocalLevel", fiscalYearId = fiscalYearId, relativePath = node.RelativePath })')">
                📄  @node.Name
            </a>
        }
    </li>
}