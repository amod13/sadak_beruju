<style>
    /* Layout */
    .row {
        margin: 0;
    }

    .col-tree {
        max-height: 90vh;
        overflow-y: auto;
        position: sticky;
        top: 10px;
        border-right: 1px solid #ddd;
        padding-right: 1rem;
    }

    .col-preview {
        padding-left: 1rem;
        max-height: 90vh;
        overflow-y: auto;
    }

    /* Tree styling */
    .tree-root, .tree-root ul {
        list-style: none;
        padding-left: 1em;
    }

        .tree-root li {
            margin: 0.2em 0;
            position: relative;
        }

            .tree-root li i {
                margin-right: 0.4em;
            }

        .tree-root a {
            text-decoration: none;
            color: #333;
        }

            .tree-root a:hover {
                text-decoration: underline;
            }

    .folder-toggle {
        cursor: pointer;
        user-select: none;
    }

    /* Collapsed folders by default */
    .tree-root ul {
        display: none;
    }

    .tree-root li.open > ul {
        display: block;
    }

    .preview-card {
        background: #fff;
        border: 1px solid #e5e7eb;
        border-radius: 14px;
        padding: 16px;
        box-shadow: 0 4px 18px rgba(0,0,0,0.05);
        min-height: 80vh;
    }

    .preview-body {
        min-height: 70vh;
        border: 1px dashed #d1d5db;
        border-radius: 12px;
        background: #f9fafb;
        padding: 15px;
        overflow: auto;
        position: relative;
    }

    .preview-toolbar {
        display: flex;
        flex-wrap: wrap;
        gap: 8px;
        margin-bottom: 15px;
        padding-bottom: 10px;
        border-bottom: 1px solid #e5e7eb;
    }

        .preview-toolbar .btn {
            border-radius: 10px;
            font-size: 13px;
            padding: 6px 12px;
        }

    .preview-stage {
        text-align: center;
        overflow: auto;
        min-height: 55vh;
        position: relative;
    }

        .preview-stage img {
            max-width: 100%;
            transition: transform 0.25s ease;
            transform-origin: center center;
            border-radius: 8px;
            box-shadow: 0 3px 10px rgba(0,0,0,0.08);
        }

        .preview-stage iframe,
        .preview-stage embed {
            width: 100%;
            height: 70vh;
            border: none;
            border-radius: 8px;
            background: #fff;
        }

    .file-meta {
        font-size: 13px;
        color: #6b7280;
        margin-bottom: 8px;
    }

    .unsupported-box {
        text-align: center;
        padding: 40px 20px;
        color: #6b7280;
    }

        .unsupported-box i {
            font-size: 48px;
            margin-bottom: 12px;
            color: #9ca3af;
        }

    .preview-empty {
        text-align: center;
        padding: 60px 20px;
        color: #6b7280;
    }
</style>

<div class="row">
    <!-- Left Tree Panel -->
    <div class="col-md-4 col-tree">
        <h5>Folders & Files</h5>
        @if (Model.RootNodes.Any())
        {
            <ul class="tree-root">
                @foreach (var node in Model.RootNodes)
