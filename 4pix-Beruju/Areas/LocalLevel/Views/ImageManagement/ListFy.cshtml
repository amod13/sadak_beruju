

@model IEnumerable<_4pix_Beruju.Models.Setups.FiscalYearRecord>

@{
    ViewBag.Title = "ListFy";
    Layout = "~/Areas/LocalLevel/Views/Shared/_LocalLevelLayout.cshtml";
}
<div class="breadcrumb-holder">
    <div class="container-fluid">
        <ul class="breadcrumb">
            <li class="breadcrumb-item"><a href="index.html">Home</a></li>
            <li class="breadcrumb-item active">आर्थिक वर्ष अनुसार बेरुजु फाईल</li>
        </ul>
    </div>
</div>

<section>
    <div class="container-fluid">
        <!-- Page Header-->
        <header>
            @*<h1 class="h3 display">@GrantApp.Areas.Admin.FunctionClass.GetGrantTypeNameById(Model.ViewBagGrantTypeId)</h1>*@
        </header>

        <div class="row">
            <div class="col-lg-12">
                <div class="card">
                    <div class="card-header">
                     
                    </div>

                    <div class="card-body">
                        <div class="table-responsive table-sm shadow p-3 mb-5 bg-white rounded">
                            <table class="table table-hover table-sm table-bordered">
                                <tr>
                                    <th>
                                        आर्थिक वर्ष अनुसार बेरुजु फाईल
                                    </th>
                                  <th></th>
                                   
                                </tr>

                                @foreach (var item in Model)
                                {
                                    <tr>
                                        <td>
                                            @Html.DisplayFor(modelItem => item.FiscalYearTitle)
                                        </td>
                                 

                                        <td>
                                            @Html.ActionLink("View", "BrowseFiscalYearFiles", new { fiscalYearId = item.FiscalYearId }) |
                                              
                                        </td>
                                    </tr>
                                }

                            </table>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>
