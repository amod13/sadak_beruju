@model _4pix_Beruju.Models.Setups.LetterSetupViewModel

<div class="row">

    <div class="col-md-4 col-sm-4 form-group">
        <label>बेरूजु प्रकार</label>
        @Html.DropDownListFor(m => m.ObjSamparikshadLetterOfficeSetupViewModel.BerujuTypeId,_4pix_Beruju.Areas.Admin.functions.GetBerujuTypeDD() ,new { @class = "form-control form-control-sm", @required = "required" })
    </div>
    <div class="col-md-4 col-sm-4 form-group">
        <label>कार्यालयको नाम</label>
        @Html.TextBoxFor(m => m.ObjSamparikshadLetterOfficeSetupViewModel.OfficeName, new { @class = "form-control form-control-sm", @required = "required" })
    </div>


    <div class="col-md-4 col-sm-4 form-group">
        <label>कार्यालयको ठेगाना</label>
        @Html.TextBoxFor(m => m.ObjSamparikshadLetterOfficeSetupViewModel.OfficeAddress, new { @class = "form-control form-control-sm", @required = "required" })
    </div>
</div>


