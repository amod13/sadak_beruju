@model _4pix_Beruju.Areas.Admin.Models.OfficeSetup

@{
    ViewBag.Title = "AddBivag";
    Layout = "~/Areas/LocalLevel/Views/Shared/_LocalLevelLayout.cshtml";
}

<div class="breadcrumb-holder">
    <div class="container-fluid">
        <ul class="breadcrumb">
            <li class="breadcrumb-item"><a href="index.html">Home</a></li>
            <li class="breadcrumb-item active">बिभाग</li>
        </ul>
    </div>
</div>
<section class="forms">
    <div class="container-fluid">
        <!-- Page Header-->
        <header>
            <h3 class="h3 display">बिभाग</h3>
        </header>
        <div class="row">
            <div class="col-lg-12">
                <div class="card">
                    <div class="card-header d-flex align-items-center">

                        @if (ViewBag.ErrorMessage != null)
                        {
                            <h4>@ViewBag.ErrorMessage</h4>
                        }

                    </div>
                    <div class="card-body">

                        @using (Html.BeginForm("AddBivag", "OfficeSetupLL", FormMethod.Post,
new { enctype = "multipart/form-data" }))
                        {

                            @Html.ValidationSummary(true)
                        <fieldset>

                            <div class="row">
                                <div class="col-md-4 col-sm-4 form-group">
                                    <label>मन्त्रालय</label>
                                    @Html.DropDownListFor(m => m.MainOfficeId, _4pix_Beruju.Utilities.GetMinistryList(0, 2), new { @class = "form-control form-control-sm", @required = "required" })
                                </div>
                            </div>

                            @*@if (Model.NirdeshanalayaUserOrProvinceUserID == 2 || Model.NirdeshanalayaUserOrProvinceUserID == 8)//province users can choose ministry
                            {
                                <div class="row">
                                    <div class="col-md-4 col-sm-4 form-group">
                                        <label>मन्त्रालय</label>
                                        @Html.DropDownListFor(m => m.ProvinceId, _4pix_Beruju.Utilities.GetMinistryList(Model.ProvinceId, 3), new { @class = "form-control form-control-sm", @required = "required" })
                                    </div>
                                </div>
                            }
                            else

                            {
                                <div class="row">
                                    <div class="col-md-4 col-sm-4 form-group">
                                        <label>मन्त्रालय</label>
                                        @Html.DropDownListFor(m => m.ProvinceId, _4pix_Beruju.Utilities.GetMinistryListForMinistryUserOnly(Model.CurrentLoginUserOfficeViewBagID), new { @class = "form-control form-control-sm", @required = "required" })
                                    </div>
                                </div>
                            }*@




                            @Html.Partial("_CreateEdit")

                            <div class="form-group">
                                @*<button type="submit" class="btn btn-secondary"><i class="fa fa-angle-double-left">&nbsp;</i> Back</button> &nbsp; &nbsp; &nbsp;*@
                                <button type="submit" class="btn btn-primary"><i class="fa fa-floppy-o">&nbsp;</i>सुरक्छित गर्नुहोस</button>
                                <a href="@Url.Action("ListBivag","OfficeSetupLL")" , class="btn btn-sm btn-success">
                                    <i class="fa fa-backward"></i>&nbsp;मूख्य मेनु
                                </a>
                            </div>
                        </fieldset>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>


<script src="~/Scripts/jquery-3.3.1.min.js"></script>
<script src="~/Scripts/jquery.unobtrusive-ajax.js"></script>




<script type="text/javascript">

          function GetDistrictListDD() {

              var value = $("#dll_ProvinceId option:selected").val();
            
     $.ajax({
         url: "@Url.Action("GetDistrictListByProvinceIdDefaultValue", "AjaxRequest", new { @area = "Admin" })",
         data: { id: value },
         dataType: "json",
         type: "POST",
         error: function () {
             alert("An error occurred.");
         },
         success: function (data) {
             var items = "";
             $.each(data, function (i, item) {
                 items += "<option value=\"" + item.Value + "\">" + item.Text + "</option>";
             });

             $("#dll_district").html(items);
         }
     })
 };

    function GetVDCMUNListDD() {
        var value = $("#dll_district option:selected").val();
        $.ajax({
            @*url: "@Url.Action("GetVDCMUNDDByDistrictId", "AjaxRequest", new { @area="admin"})",*@
            url: "@Url.Action("GetVDCMUNDDByDistrictIdWithDefaultValue", "AjaxRequest", new { @area = "Admin" })",
            data: { id: value },
            dataType: "json",
            type: "POST",
            error: function () {
                GetVDCMUNDDByDistrictId
                alert("An error occurred.");
            },
            success: function (data) {
                var items = "";
                $.each(data, function (i, item) {
                    items += "<option value=\"" + item.Value + "\">" + item.Text + "</option>";
                });

                $("#dll_vdcmun").html(items);
            }
        })
    };



</script>








