@model _4pix_Beruju.Models.Setups.LetterSetupViewModel

@{
    ViewBag.Title = "ListLetterOfficeSetup";
    Layout = "~/Areas/LocalLevel/Views/Shared/_LocalLevelLayout.cshtml";
    int i = 1;
}

<div class="breadcrumb-holder">
    <div class="container-fluid">
        <ul class="breadcrumb">
            <li class="breadcrumb-item"><a href="index.html">Home</a></li>
            <li class="breadcrumb-item active">सम्परीक्षण अनुरोध फाराम-कार्यालय सेटअप</li>
        </ul>
    </div>
</div>

<section>
    <div class="container-fluid">
        <!-- Page Header-->
        <header>
            @*<h1 class="h3 display">@GrantApp.Areas.Admin.FunctionClass.GetGrantTypeNameById(Model.ViewBagGrantTypeId)</h1>*@
        </header>

        <div class="row">
            <div class="col-lg-12">
                <div class="card">
                    <div class="card-header">
                        <h4>
                            @*@Html.ActionLink("", "Create", "BerujuType", new { @class = "btn btn-sm btn-success" })*@


                            <a href="@Url.Action("AddLetterSetupOffice","OfficeSetupLL")" , class="btn btn-sm btn-success">
                                <i class="fa fa-plus"></i>&nbsp;नयाँ थप्नुहोस
                            </a>
                        </h4>
                    </div>
                    <div class="card-body">
                        <div class="table-responsive table-sm shadow p-3 mb-5 bg-white rounded">
                            <table class="table table-hover table-sm table-bordered">
                                <thead>
                                    <tr>
                                        <th>क्रम</th>
                                        <th>प्रकार</th>
                                        <th>कार्यालयको नाम </th>
                                        <th>कार्यालयको ठेगाना</th>
                                        <th>सच्चाउनुहोस</th>
                                        <th>हटाउनुहोस</th>
                                    </tr>
                                </thead>
                                <tbody>

                                    @foreach (var item in Model.SamparikshadLetterOfficeSetupViewModelList)
                                    {

                                        <tr>
                                            <td scope="row">@i</td>
                                            <td>@_4pix_Beruju.Areas.Admin.functions.GetBerujuTypeFromId(item.BerujuTypeId)</td>
                                            <td>@item.OfficeName</td>
                                            <td>@item.OfficeAddress</td>
                                            <td>
                                                @Html.ActionLink(" ", "EditLetterSetupOffice", new { @id = item.SamparikshadLetterSetupId }, new { @class = "edits fa fa-edit" })
                                            </td>
                                            <td>
                                                @Html.ActionLink(" ", "DeleteLetterSetupOffice", new { @id = item.SamparikshadLetterSetupId }, new { @class = "edits fa fa-trash" })
                                            </td>


                                        </tr>
                                        ++i;
                                    }


                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>
@*<link href="~/Content/SweetAlert.css" rel="stylesheet" />*@
<link href="~/Content/sweetalert/sweet-alert.css" rel="stylesheet" />
<script src="~/Scripts/jquery-3.3.1.min.js"></script>
<script src="~/Scripts/SweetAlert.min.js"></script>


<script type="text/javascript">
     $(function () {
        var a = '@TempData["Success"]';
        if (a != '') {
            sweetAlert(a, "success", "success");
        }
        else {

        }


    });


</script>

