@model _4pix_Beruju.Areas.LocalLevel.Models.ExpenseTitleViewModelSetup


<div class="row">

    <div class="col-md-4 col-sm-4 form-group">
        <label>आर्थिक वर्ष</label>
        @Html.DropDownListFor(m => m.ObjBudgetSubTitleSetup.FiscalYearId, _4pix_Beruju.Areas.Admin.functions.GetFiscalYearListDD(), new { @class = "form-control form-control-sm", @required = "required" })
    </div>

    <div class="col-md-4 col-sm-4 form-group">
        <label>वजेट उप-शिर्षक नम्बर</label>
        @Html.TextBoxFor(m => m.ObjBudgetSubTitleSetup.SubTitleCode, new { @class = "form-control form-control-sm ", @required = "required" })
        @Html.ValidationMessageFor(m => m.ObjBudgetSubTitleSetup.SubTitleCode)
    </div>


    <div class="col-md-4 col-sm-4 form-group">
        <label>वजेट उप-शिर्षक नाम</label>
        @Html.TextBoxFor(m => m.ObjBudgetSubTitleSetup.SubTitleName, new { @class = "form-control form-control-sm ", @required = "required" })
    </div>


</div>



