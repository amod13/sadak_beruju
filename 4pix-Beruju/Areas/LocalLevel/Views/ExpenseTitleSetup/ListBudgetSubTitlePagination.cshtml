@using PagedList.Mvc
@model  PagedList.IPagedList<_4pix_Beruju.Areas.LocalLevel.Models.BudgetSubTitleSetup>


@{


    ViewBag.Title = "Index";
    Layout = "~/Areas/LocalLevel/Views/Shared/_LocalLevelLayout.cshtml";
    int i = 0;
}

<link href="~/Content/PagedList.css" rel="stylesheet" />
<style>
    .ul.pagination {
        display: inline-block;
        padding: 0;
        margin: 0;
    }

    ul.pagination li {
        display: inline;
    }

        ul.pagination li a {
            color: black;
            float: left;
            padding: 8px 16px;
            text-decoration: none;
            transition: background-color .3s;
        }

            ul.pagination li a.active {
                background-color: #4CAF50;
                color: white;
            }

            ul.pagination li a:hover:not(.active) {
                background-color: #ddd;
            }
</style>
<div class="breadcrumb-holder">
    <div class="container-fluid">
        @*<ul class="breadcrumb">
                <li class="breadcrumb-item"><a href="index.html">Home</a></li>
                <li class="breadcrumb-item active">@_4pix_Beruju.Areas.Admin.functions.GetInternalOrExternalTitle(Model.InternalOrExternal) सैदान्तिक बेरूजु</li>
            </ul>*@
    </div>
</div>

<section>
    <div class="container-fluid">
        <!-- Page Header-->
        @*<header>
                <h6 class="h3 display">@_4pix_Beruju.Areas.Admin.functions.GetInternalOrExternalTitle(Model.InternalOrExternal) सैदान्तिक बेरूजु</h6>
            </header>*@

        <div class="row">
            <div class="col-lg-12">
                <div class="card">
                    <div class="card-header">
                        <h4>



                            <a href="@Url.Action("CreateBudgetSubTitleWithP","ExpenseTitleSetup")" , class="btn btn-sm btn-success">
                                <i class="fa fa-plus"></i>&nbsp;नयाँ थप्नुहोस
                            </a>
                        </h4>

                    </div>

                    @using (Html.BeginForm())
                    {
                        <div class="col-md-4 col-sm-4 form-group">
                            <label>आर्थिक वर्ष</label>
                            @Html.DropDownList("FiscalYearId", _4pix_Beruju.Areas.Admin.functions.GetFiscalYearListDD(), new { @class = "form-control form-control-sm", @required = "required" })
                        </div>
                        <div class="col-md-4">
                            <button type="submit" class="btn btn-primary"><i class="fa fa-floppy-o">&nbsp;</i>खोज्नुहोस</button>

                        </div>



                        <div class="card-body">
                            <div class="table-responsive table-sm shadow p-3 mb-5 bg-white rounded">
                                <table class="table table-hover table-sm table-bordered">
                                    <thead>
                                        <tr>
                                            <th>क्रम</th>
                                            <th>आर्थिक वर्ष</th>
                                            <th>वजेट उप-शिर्षक नम्बर</th>
                                            <th>शिर्षक</th>
                                            <th>सच्याउनुहोस्</th>
                                            <th>हटाउनुहोस्</th>
                                        </tr>
                                    </thead>
                                    <tbody>

                                        @for (int j = 0; j < Model.Count; j++)
                                        {
                                            int FYID = 0;
                                            if (Model[j].FiscalYearId.HasValue)
                                            {
                                                FYID = Convert.ToInt32(Model[j].FiscalYearId);
                                            }


                                        <tr>
                                            <td scope="row">@(i + ((Model.PageNumber - 1) * Model.PageSize) + 1)</td>
                                            <td>@_4pix_Beruju.Areas.Admin.functions.GetFiscalyearTitleFromId(FYID)</td>
                                            <td>@Model[j].SubTitleCode</td>
                                            <td>@Model[j].SubTitleName</td>
                                            <td>
                                                @Html.ActionLink(" ", "EditBudgetSubTitleWithP", new { @id = Model[j].BudgetSubTitleId }, new { @class = "edits fa fa-edit" })
                                            </td>

                                            <td>
                                                <a href="~/LocalLevel/ExpenseTitleSetup/DeleteBudgetSubTitleDetailWithP?id=@Model[j].BudgetSubTitleId" id="deleteBtn" class="edits" onclick="return confirm('के तपाँई को विवरण लाई हटाउँन चाहानुहुन्छ ?');"><i class="edits fa fa-trash"></i></a>

                                            </td>
                                            @*<td>
                                                @Html.ActionLink(" ", "DeleteBudgetSubTitleDetail", new { @id = Model[j].BudgetSubTitleId }, new { @class = "edits fa fa-trash" })
                                            </td>*@

                                        </tr>
                                            i++;

                                        }


                                    </tbody>
                                </table>
                            </div>
                            <div id="container" style="margin-left: 20px">
                                <p></p>
                                <p></p>
                                <div class="pagination" style="margin-left: 400px">
                                    Page @(Model.PageCount < Model.PageNumber ? 0 : Model.PageNumber)
                                    of @Model.PageCount   @Html.PagedListPager(Model, page => Url.Action("ListBudgetSubTitlePagination", new { page, FiscalYearId = ViewBag.FiscalYearId }))
                                </div>
                            </div>
                        </div>

                    }
                </div>
            </div>
        </div>
    </div>
</section>
@*<link href="~/Content/SweetAlert.css" rel="stylesheet" />*@
<link href="~/Content/sweetalert/sweet-alert.css" rel="stylesheet" />
<script src="~/Scripts/jquery-3.3.1.min.js"></script>
<script src="~/Scripts/SweetAlert.min.js"></script>


<script type="text/javascript">
     $(function () {
         var a = '@TempData["Success"]';
         var b = '@TempData["Error"]';
        if (a != '') {
            sweetAlert(a, "success", "success");
        }
        else if (b != '')
        {
            sweetAlert(b, "Error", "error");
        }
        else {

        }


    });


</script>

