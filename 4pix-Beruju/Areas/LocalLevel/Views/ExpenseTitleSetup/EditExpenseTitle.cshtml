@model _4pix_Beruju.Areas.LocalLevel.Models.ExpenseTitleViewModelSetup

@{
    ViewBag.Title = "CreateBudgetSubTitle";
    Layout = "~/Areas/LocalLevel/Views/Shared/_LocalLevelLayout.cshtml";
}

<div class="breadcrumb-holder">
    <div class="container-fluid">
        <ul class="breadcrumb">
            <li class="breadcrumb-item"><a href="index.html">Home</a></li>
            <li class="breadcrumb-item active">खर्च शिर्षक विवरण</li>
        </ul>
    </div>
</div>
<section class="forms">
    <div class="container-fluid">
        <!-- Page Header-->
        <header>
            <h3 class="h3 display">खर्च शिर्षक विवरण</h3>
        </header>
        <div class="row">
            <div class="col-lg-12">
                <div class="card">
                    <div class="card-header d-flex align-items-center">

                        @if (ViewBag.ErrorMessage != null)
                        {
                            <h4>@ViewBag.ErrorMessage</h4>
                        }

                    </div>
                    <div class="card-body">

                        @using (Html.BeginForm("EditExpenseTitle", "ExpenseTitleSetup", FormMethod.Post,
new { enctype = "multipart/form-data" }))
                        {

                            @Html.HiddenFor(m => m.ObjExpenseTitleSetup.ChaluPujigatId)
                            @Html.ValidationSummary(true)
                            <fieldset>
                                @Html.Partial("_CreateEditExpenseTitle")

                                <div class="form-group">
                                    @*<button type="submit" class="btn btn-secondary"><i class="fa fa-angle-double-left">&nbsp;</i> Back</button> &nbsp; &nbsp; &nbsp;*@
                                    <button type="submit" class="btn btn-primary"><i class="fa fa-floppy-o">&nbsp;</i>सुरक्षित गर्नुहोस</button>
                                    <a href="@Url.Action("ListExpenseTitle","ExpenseTitleSetup")" , class="btn btn-sm btn-success">
                                        <i class="fa fa-backward"></i>&nbsp;मूख्य मेनु
                                    </a>
                                </div>
                            </fieldset>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>


@*<script src="~/Scripts/jquery.validate.js"></script>
    <script src="~/Scripts/jquery.validate.unobtrusive.js"></script>*@

<script src="~/Scripts/jquery-3.3.1.min.js"></script>
@*<script src="~/AdminResources/js/inputmask/inputmask.js"></script>*@
<script src="~/AdminResources/js/inputmask/jquery.inputmask.min.js"></script>





<script>
    $j = jQuery.noConflict();
    $j(function () {
        //$j('.select2').select2();
        //$("#MaskDate").mask("(999) 999-9999");
        $j('.MaskDate').inputmask('9999/99/99', { 'placeholder': 'yyyy/mm/dd' })
    });

</script>








