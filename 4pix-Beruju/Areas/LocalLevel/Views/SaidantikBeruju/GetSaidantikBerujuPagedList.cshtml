@model _4pix_Beruju.Models.SaidantikBeruju

@{
    ViewBag.Title = "GetSaidantikBerujuPagedList";
    Layout = "~/Areas/LocalLevel/Views/Shared/_LocalLevelLayout.cshtml";
    int i = 1;
}

<div class="breadcrumb-holder">
    <div class="container-fluid">
        @*<ul class="breadcrumb">
                <li class="breadcrumb-item"><a href="index.html">Home</a></li>
                <li class="breadcrumb-item active">@_4pix_Beruju.Areas.Admin.functions.GetInternalOrExternalTitle(Model.InternalOrExternal) सैदान्तिक बेरूजु</li>
            </ul>*@
    </div>
</div>

<section>
    <div class="container-fluid">
        <!-- Page Header-->
        @*<header>
                <h6 class="h3 display">@_4pix_Beruju.Areas.Admin.functions.GetInternalOrExternalTitle(Model.InternalOrExternal) सैदान्तिक बेरूजु</h6>
            </header>*@

        <div class="row">
            <div class="col-lg-12">
                <div class="card">
                    <div class="card-header">

                    </div>


                    <div class="card-body">
                        <div class="table-responsive table-sm shadow p-3 mb-5 bg-white rounded">
                            <table class="table table-hover table-sm table-bordered">
                                <thead>
                                    <tr>
                                        <th>क्रम</th>
                                        <th>आर्थिक वर्ष</th>
                                        <th>बेरूजु दफा नं</th>
                                        <th>सच्चाउनुहोस</th>
                                        <th>विवरण</th>
                                        @*<th>हटाउनुहोस</th>*@

                                    </tr>
                                </thead>
                                <tbody>

                                    @foreach (var item in Model.SaidantikBerujuList)
                                    {




                                        <tr>
                                            <td scope="row">@i</td>
                                            <td>@_4pix_Beruju.Areas.Admin.functions.GetFiscalyearTitleFromId(item.FiscalYearId)</td>
                                            <td>@item.BerujuDafaNumber</td>
                                            <td>
                                                @Html.ActionLink(" ", "Edit", new { @id = item.SaidantikBerujuId, @id1 = 1 }, new { @class = "edits fa fa-edit" })
                                            </td>

                                            <td>
                                                @Html.ActionLink(" ", "ViewDetails", new { @id = item.SaidantikBerujuId, @id1 = 1 }, new { @class = "edits fa fa-eye" })
                                            </td>
                                            @*<td>
                                                @Html.ActionLink(" ", "Delete", new { @id = item.SaidantikBerujuId, @id1 = 1 }, new { @class = "edits fa fa-trash" })
                                            </td>*@

                                        </tr>

                                    }


                                </tbody>
                            </table>
                        </div>
                        <div id="container" style="margin-left: 20px">
                            <ul class="pagination">
                                @for (int k = 1; k <= Model.PageCount; k++)
                                {
                                    <li class="@(k == Model.CurrentPage ? "page-item active" : "page-item")">
                                        <a class="page-link" href="@Url.Action("GetSaidantikBerujuPagedList", new { page = k })">@k</a>
                                    </li>
                                }
                            </ul>
                        </div>
                    </div>


                </div>
            </div>
        </div>
    </div>
</section>