@model _4pix_Beruju.Models.SaidantikBeruju

@{
    ViewBag.Title = "Create";
    Layout = "~/Areas/LocalLevel/Views/Shared/_LocalLevelLayout.cshtml";
    int i = 1;

}
@*<script src="~/vendor/ckeditor/ckeditor.js"></script>*@

<script src="~/vendor/CkStandar/ckeditor.js"></script>
<link href="~/Content/sweetalert/sweet-alert.css" rel="stylesheet" />
<div class="breadcrumb-holder">
    <div class="container-fluid">
        <ul class="breadcrumb">
            <li class="breadcrumb-item"><a href="index.html">Home</a></li>
            <li class="breadcrumb-item active">@_4pix_Beruju.Areas.Admin.functions.GetInternalOrExternalTitle(Model.InternalOrExternal) सैदान्तिक बेरूजु</li>
        </ul>
    </div>
</div>
<section class="forms">
    <div class="container-fluid">
        <!-- Page Header-->
        <div class="row">
            <div class="col-lg-4"></div>
            <div class="col-lg-4">

                <h6 class="h3 display">@_4pix_Beruju.Areas.Admin.functions.GetInternalOrExternalTitle(Model.InternalOrExternal) सैदान्तिक बेरूजु</h6>

            </div>

        </div>
        <div class="row">
            <div class="col-lg-12">
                <div class="card">
                    <div class="card-header d-flex align-items-center">

                        @if (ViewBag.ErrorMessage != null)
                        {
                            <h4>@ViewBag.ErrorMessage</h4>
                        }

                    </div>
                    <div class="card-body">

                        @using (Html.BeginForm("Create", "SaidantikBeruju", FormMethod.Post,
new { enctype = "multipart/form-data" }))
                        {
                            @Html.AntiForgeryToken();
                            @Html.ValidationSummary(true)
                            @Html.HiddenFor(m => m.InternalOrExternal)
                        <fieldset>
                            <div class="row">
                                <div class="col-md-3 col-sm-3 form-group">
                                    <label>आर्थिक वर्ष</label>
                                    @Html.DropDownListFor(m => m.FiscalYearId, _4pix_Beruju.Areas.Admin.functions.GetFiscalYearListWithNull(), new { @id = "DDFYID", @class = "form-control form-control-sm", @onChange = "GetBudgetSubTitleByFYID()" })

                                </div>
                                @if (ViewBag.Mode == "Create")
                                {
                                    <div class="col-md-4 col-sm-4 form-group">
                                        <label>ब.उ.शि.नं.</label>
                                        @Html.DropDownListFor(m => m.BudgetSubTitleId, _4pix_Beruju.Areas.Admin.functions.GetBudgetSubTitleWithNull(), new { @id = "BSTID", @class = "form-control form-control-sm ", @required = "required" })
                                    </div>
                                }


                                else
                                {
                                    <div class="col-md-4 col-sm-4 form-group">
                                        <label>ब.उ.शि.नं.</label>
                                        @Html.DropDownListFor(m => m.BudgetSubTitleId, _4pix_Beruju.Areas.Admin.functions.GetBudgetSubTitleDDByOfficeIdAndFYID(Model.FiscalYearId), new { @id = "BSTID", @class = "form-control form-control-sm ", @required = "required" })
                                    </div>
                                }

                                <div class="col-md-3 col-sm-3 form-group">
                                    <label>बेरूजु दफा नं.</label>
                                    @Html.TextBoxFor(m => m.BerujuDafaNumber, new { @class = "form-control form-control-sm", @required = "required" })
                                </div>

                                <div class="col-md-12 col-sm-12 form-group">
                                    <label>बेरूजुको संक्षिप्त व्यहोरा</label>
                                    @Html.TextAreaFor(m => m.BerujuShortDesc, new { @class = "form-control form-control-sm", @required = "required" })
                                </div>
                                <script>
                                    CKEDITOR.replace("FullDescription");
                                </script>

                                <div class="col-md-12 col-sm-12 form-group">
                                    <label>बेरूजुको पूर्ण व्यहोरा</label>
                                    @Html.TextAreaFor(m => m.BerujuLongDesc, new { @id = "FullDescription", @class = "form-control form-control-sm", @required = "required", @cols = 40, @rows = 10 })
                                </div>
                                <script>
                                    CKEDITOR.replace("FullDescription");
                                </script>

                            </div>

                            <div class="col-md-4 col-sm-4 form-group">
                                <label>कागजात</label><br />
                                @Html.TextBoxFor(m => m.UploadSaidantikDocFileType, new
                                {
                                    type = "file",
                                    required = "required",
                                    accept = ".png,.jpg,.jpeg,.pdf"
                                })
                                <span class="text-danger" id="fileError"></span>


                            </div>


                            @*<div class="col-md-4 col-sm-4 form-group">
            <label>कागजात</label><br />
            @Html.TextBoxFor(m => m.UploadSaidantikDocFileType, new { type = "file" })
        </div>*@

                            <div class="form-group">
                                @*<button type="submit" class="btn btn-secondary"><i class="fa fa-angle-double-left">&nbsp;</i> Back</button> &nbsp; &nbsp; &nbsp;*@
                                <button type="submit" class="btn btn-primary"><i class="fa fa-floppy-o">&nbsp;</i>सुरक्षित गर्नुहोस</button>
                                <a href="@Url.Action("Index","SaidantikBeruju", new { @id=Model.InternalOrExternal})" , class="btn btn-sm btn-success">
                                    <i class="fa fa-backward"></i>&nbsp;मूख्य मेनु
                                </a>
                            </div>
                        </fieldset>
                        }
                    </div>
                </div>
            </div>
        </div>


        <div class="row">
            <div class="card-body">
                <div class="offset-lg-10">
                    <a href="@Url.Action("Index","SaidantikBeruju", new { @id=Model.InternalOrExternal})" , class="btn btn-sm btn-success pull-right">
                        <i class="fa fa-backward"></i>&nbsp; पूर्ण सूची हेर्नुहोस
                    </a>
                </div>
                <div class="table-responsive table-sm shadow p-3 mb-5 bg-white rounded">
                    <table class="table table-hover table-sm table-bordered">
                        <thead>
                            <tr>
                                <th>क्रम</th>
                                <th>आर्थिक वर्ष</th>
                                <th>बेरूजु दफा नं</th>
                                <th>सच्चाउनुहोस</th>
                                <th>विवरण</th>
                                @*<th>हटाउनुहोस</th>*@

                            </tr>
                        </thead>
                        <tbody>

                            @foreach (var item in Model.SaidantikBerujuTopFiveList)
                            {

                                <tr>
                                    <td scope="row">@i</td>
                                    <td>@_4pix_Beruju.Areas.Admin.functions.GetFiscalyearTitleFromId(item.FiscalYearId)</td>
                                    <td>@item.BerujuDafaNumber</td>
                                    <td>
                                        @Html.ActionLink(" ", "Edit", new { @id = item.SaidantikBerujuId, @id1 = Model.InternalOrExternal }, new { @class = "edits fa fa-edit" })
                                    </td>

                                    <td>
                                        @Html.ActionLink(" ", "ViewDetails", new { @id = item.SaidantikBerujuId, @id1 = Model.InternalOrExternal }, new { @class = "edits fa fa-eye" })
                                    </td>
                                    @*<td>
                                        @Html.ActionLink(" ", "Delete", new { @id = item.SaidantikBerujuId, @id1 = Model.InternalOrExternal }, new { @class = "edits fa fa-trash" })
                                    </td>*@

                                </tr>
                                ++i;
                            }


                        </tbody>
                    </table>
                </div>
            </div>
        </div>



    </div>
</section>



<script src="~/Scripts/jquery-3.3.1.min.js"></script>
<script src="~/AdminResources/js/inputmask/jquery.inputmask.min.js"></script>
<script type="text/javascript" src="https://ajax.googleapis.com/ajax/libs/jquery/1.8.3/jquery.min.js"></script>

<script src="~/Scripts/SweetAlert.min.js"></script>
<script>
function GetBudgetSubTitleByFYID() {

        var FYIDVal = $("#DDFYID option:selected").val();
        if (FYIDVal != null) {


            $.ajax({
                url: "@Url.Action("GetBudgetSubtitleFromOfficeIdFYID", "AjaxRequest", new { @area = "admin" })",
                data: { id: FYIDVal },
                dataType: "json",
                type: "POST",
                error: function () {
                alert("An error occurred.");
                },
                success: function (data) {
                var items = "";
                $.each(data, function (i, item) {
                items += "<option value=\"" + item.Value + "\">" + item.Text + "</option>";
                });

                $("#BSTID").html(items);
                }
                })
                }

                };

</script>
<script type="text/javascript">
    var kk = $.noConflict();
    kk(function () {
         var a = '@TempData["Success"]';
         var b = '@TempData["Error"]';
        if (a != '') {
            sweetAlert(a, "success", "success");
        }
        else if (b != '')
        {
            sweetAlert(b, "Error", "error");
        }
        else {

        }


    });


</script>



