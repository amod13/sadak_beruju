@using PagedList.Mvc
@model  PagedList.IPagedList<_4pix_Beruju.Models.SaidantikBeruju>


@{


    ViewBag.Title = "Index";
    Layout = "~/Areas/LocalLevel/Views/Shared/_LocalLevelLayout.cshtml";
    int i = 1;
}
<style>
    .ul.pagination {
        display: inline-block;
        padding: 0;
        margin: 0;
    }

    ul.pagination li {
        display: inline;
    }

        ul.pagination li a {
            color: black;
            float: left;
            padding: 8px 16px;
            text-decoration: none;
            transition: background-color .3s;
        }

            ul.pagination li a.active {
                background-color: #4CAF50;
                color: white;
            }

            ul.pagination li a:hover:not(.active) {
                background-color: #ddd;
            }
</style>
<div class="breadcrumb-holder">
    <div class="container-fluid">
        @*<ul class="breadcrumb">
                <li class="breadcrumb-item"><a href="index.html">Home</a></li>
                <li class="breadcrumb-item active">@_4pix_Beruju.Areas.Admin.functions.GetInternalOrExternalTitle(Model.InternalOrExternal) सैदान्तिक बेरूजु</li>
            </ul>*@
    </div>
</div>

<section>
    <div class="container-fluid">
        <!-- Page Header-->
        @*<header>
                <h6 class="h3 display">@_4pix_Beruju.Areas.Admin.functions.GetInternalOrExternalTitle(Model.InternalOrExternal) सैदान्तिक बेरूजु</h6>
            </header>*@

        <div class="row">
            <div class="col-lg-12">
                <div class="card">
                    <div class="card-header">

                    </div>

                    @using (Html.BeginForm())
                    {
                        <div class="card-body">
                            <div class="table-responsive table-sm shadow p-3 mb-5 bg-white rounded">
                                <table class="table table-hover table-sm table-bordered">
                                    <thead>
                                        <tr>
                                            <th>क्रम</th>
                                            <th>आर्थिक वर्ष</th>
                                            <th>बेरूजु दफा नं</th>
                                            <th>सच्चाउनुहोस</th>
                                            <th>विवरण</th>
                                            @*<th>हटाउनुहोस</th>*@

                                        </tr>
                                    </thead>
                                    <tbody>

                                        @for (int j = 0; j < Model.Count; j++)
                                        {

                                            <tr>
                                                <td scope="row">@i</td>
                                                <td>@_4pix_Beruju.Areas.Admin.functions.GetFiscalyearTitleFromId(Model[j].FiscalYearId)</td>
                                                <td>@Model[j].BerujuDafaNumber</td>
                                                <td>
                                                    @Html.ActionLink(" ", "Edit", new { @id = Model[j].SaidantikBerujuId, @id1 = 1 }, new { @class = "edits fa fa-edit" })
                                                </td>

                                                <td>
                                                    @Html.ActionLink(" ", "ViewDetails", new { @id = Model[j].SaidantikBerujuId, @id1 = 1 }, new { @class = "edits fa fa-eye" })
                                                </td>
                                                @*<td>
                                                    @Html.ActionLink(" ", "Delete", new { @id = Model[j].SaidantikBerujuId, @id1 = 1 }, new { @class = "edits fa fa-trash" })
                                                </td>*@

                                            </tr>
                                           
                                        }


                                    </tbody>
                                </table>
                            </div>
                            <div id="container" style="margin-left: 20px">
                                <p></p>
                                <p></p>
                                <div class="pagination" style="margin-left: 400px">
                                    Page @(Model.PageCount < Model.PageNumber ? 0 : Model.PageNumber)
                                    of @Model.PageCount   @Html.PagedListPager(Model, page => Url.Action("GetSaidaintikList", new { page }))
                                </div>
                            </div>
                        </div>

                    }
                </div>
            </div>
        </div>
    </div>
</section>
@*<link href="~/Content/SweetAlert.css" rel="stylesheet" />*@
<link href="~/Content/sweetalert/sweet-alert.css" rel="stylesheet" />
<script src="~/Scripts/jquery-3.3.1.min.js"></script>
<script src="~/Scripts/SweetAlert.min.js"></script>


<script type="text/javascript">
     $(function () {
         var a = '@TempData["Success"]';
         var b = '@TempData["Error"]';
        if (a != '') {
            sweetAlert(a, "success", "success");
        }
        else if (b != '')
        {
            sweetAlert(b, "Error", "error");
        }
        else {

        }


    });


</script>

