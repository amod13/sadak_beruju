@model _4pix_Beruju.Models.MergeOfficeMaster

@{
    ViewBag.Title = "MergeAdd";
    Layout = "~/Areas/LocalLevel/Views/Shared/_LocalLevelLayout.cshtml";
}

<script src="~/vendor/CkStandar/ckeditor.js"></script>
<link href="~/Content/sweetalert/sweet-alert.css" rel="stylesheet" />
<div class="breadcrumb-holder">
    <div class="container-fluid">
        <ul class="breadcrumb">
            <li class="breadcrumb-item"><a href="index.html">Home</a></li>
            <li class="breadcrumb-item active">Merge</li>
        </ul>
    </div>
</div>
<section class="forms">
    <div class="container-fluid">
        <!-- Page Header-->
        <div class="row">
            <div class="col-lg-4"></div>
            <div class="col-lg-4">


            </div>

        </div>
        <div class="row">
            <div class="col-lg-12">
                <div class="card">
                    <div class="card-header d-flex align-items-center">

                        @if (ViewBag.ErrorMessage != null)
                        {
                            <div style="color:red;font-size:15px;font-style:italic;">@ViewBag.ErrorMessage</div>
                        }

                    </div>
                    <div class="card-body">

                        @using (Html.BeginForm())
                        {
                            @Html.AntiForgeryToken()

                            <div class="card-body">

                                <hr />
                                @Html.ValidationSummary(true, "", new { @class = "text-danger" })

                                <div class="row">
                                    <div class="col-md-4">
                                        @Html.LabelFor(model => model.MergeOfficeName, htmlAttributes: new { @class = "control-label" })

                                        @Html.EditorFor(model => model.MergeOfficeName, new { htmlAttributes = new { @class = "form-control" } })
                                        @Html.ValidationMessageFor(model => model.MergeOfficeName, "", new { @class = "text-danger" })

                                    </div>

                                    <div class="col-md-4">
                                        @Html.Label("कार्यालयको कोड", htmlAttributes: new { @class = "control-label" })

                                        @Html.EditorFor(model => model.ObjOfficeMainViewModel.OfficeCode, new { htmlAttributes = new { @class = "form-control" } })
                                        @Html.ValidationMessageFor(model => model.ObjOfficeMainViewModel.OfficeCode, "", new { @class = "text-danger" })

                                    </div>

                                    <div class="col-md-4">
                                        @Html.LabelFor(model => model.OfficeEmail, htmlAttributes: new { @class = "control-label" })

                                        @Html.EditorFor(model => model.OfficeEmail, new { htmlAttributes = new { @class = "form-control" } })
                                        @Html.ValidationMessageFor(model => model.OfficeEmail, "", new { @class = "text-danger" })

                                    </div>

                                    <div class="col-md-4">
                                        @Html.Label("ठेगाना", htmlAttributes: new { @class = "control-label" })

                                        @Html.EditorFor(model => model.ObjOfficeMainViewModel.OfficeAddress, new { htmlAttributes = new { @class = "form-control" } })
                                        @Html.ValidationMessageFor(model => model.ObjOfficeMainViewModel.OfficeAddress, "", new { @class = "text-danger" })

                                    </div>

                                    <div class="col-md-4">
                                        @Html.Label("सम्पर्क व्याक्ति", htmlAttributes: new { @class = "control-label" })

                                        @Html.EditorFor(model => model.ObjOfficeMainViewModel.ContactPerson, new { htmlAttributes = new { @class = "form-control" } })
                                        @Html.ValidationMessageFor(model => model.ObjOfficeMainViewModel.ContactPerson, "", new { @class = "text-danger" })

                                    </div>
                                    <div class="col-md-4">
                                        @Html.Label("सम्पर्क व्याक्ति सम्पर्क", htmlAttributes: new { @class = "control-label" })

                                        @Html.EditorFor(model => model.ObjOfficeMainViewModel.ContactPersonPhone, new { htmlAttributes = new { @class = "form-control" } })
                                        @Html.ValidationMessageFor(model => model.ObjOfficeMainViewModel.ContactPersonPhone, "", new { @class = "text-danger" })

                                    </div>


                                    <div class="col-md-3">
                                        @Html.LabelFor(model => model.MergedDate, htmlAttributes: new { @class = "control-label" })

                                        @Html.EditorFor(model => model.MergedDate, new { htmlAttributes = new { @class = "form-control MaskDate" } })
                                        @Html.ValidationMessageFor(model => model.MergedDate, "", new { @class = "text-danger" })

                                    </div>
                                </div>

                                <div class="row">
                                    <div class="col-md-12">
                                        @Html.LabelFor(model => model.RemarksIf, htmlAttributes: new { @class = "control-label col-md-2" })

                                        @Html.EditorFor(model => model.RemarksIf, new { htmlAttributes = new { @class = "form-control" } })
                                        @Html.ValidationMessageFor(model => model.RemarksIf, "", new { @class = "text-danger" })
                                    </div>

                                </div>

                                <div class="row">
                                    <div class="col-md-4 col-sm-4 form-group">
                                        <label>प्रदेश</label>
                                        @Html.DropDownListFor(m => m.ObjOfficeMainViewModel.ProvinceId, _4pix_Beruju.Utilities.GetProvincesDD(), new { @class = "form-control form-control-sm", @onchange = "GetDistrictListDD()", @required = "required", @id = "dll_ProvinceId" })
                                    </div>


                                    <div class="col-md-4 col-sm-4 form-group">
                                        <label>जिल्ला</label>
                                        @Html.DropDownListFor(m => m.ObjOfficeMainViewModel.DistrictId, _4pix_Beruju.Utilities.GetDistrictByStateIdDDForOfficeSetup(Model.ObjOfficeMainViewModel.ProvinceId), new { @class = "form-control form-control-sm", @required = "required", @id = "dll_district", @onchange = "GetVDCMUNListDD()" })
                                    </div>

                                    @if (ViewBag.EditMode == "True")
                                    {
                                        <div class="col-md-4 col-sm-4 form-group">
                                            <label>गापा/नपा</label>
                                            @Html.DropDownListFor(m => m.ObjOfficeMainViewModel.VDCMUNID, _4pix_Beruju.Utilities.GetRuralMunicipalitybyDistrictDD(Model.ObjOfficeMainViewModel.DistrictId), new { @class = "form-control form-control-sm", @required = "required", id = "dll_vdcmun" })
                                        </div>
                                    }
                                    else
                                    {
                                        <div class="col-md-4 col-sm-4 form-group">
                                            <label>गापा/नपा</label>
                                            @Html.DropDownListFor(m => m.ObjOfficeMainViewModel.VDCMUNID, _4pix_Beruju.Utilities.GetRuralMunicipalitybyDistrictDD(0), new { @class = "form-control form-control-sm", @required = "required", id = "dll_vdcmun" })
                                        </div>

                                    }
                                </div>





                                <div>
                                    <div class="well well-small" id="Add-Item" style="width: 990px;margin-top:20px;">

                                        @Html.ActionLink("विवरण थप्नुहोस", "AddMoreOfficesForMerge", null, new { @id = "btns", @class = "addProductItem btn btn-success" })

                                        <table id="tblotm" style="width: 740px; margin-left: 0px !important;margin-top:10px;">
                                            <tr>

                                                <td style="width:320px;font-weight:bold;">कार्यालयको नाम</td>

                                            </tr>


                                        </table>

                                        @try
                                        {
                                            foreach (var item in Model.OfficeDetailsWithAddressVMList)
                                            {

                                                @Html.Partial("_AddMoreOfficeDetails", item)

                                            }
                                        }
                                        catch { }

                                    </div>
                                </div>

                                <div class="form-group" style="margin-top:20px;">
                                    <button type="submit" class="btn btn-primary"><i class="fa fa-floppy-o">&nbsp;</i>सुरक्षित गर्नुहोस</button>
                                    <a href="@Url.Action("MergeOfficesIndex","MergeOffices", new { @id=0})" , class="btn btn-sm btn-success">
                                        <i class="fa fa-backward"></i>&nbsp;मूख्य मेनु
                                    </a>
                                </div>
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>
<script src="~/Scripts/jquery-3.3.1.min.js"></script>
@*<script src="~/AdminResources/js/inputmask/inputmask.js"></script>*@
<script src="~/AdminResources/js/inputmask/jquery.inputmask.min.js"></script>
@*<script src="~/AdminResources/plugins/select2/js/select2.full.min.js"></script>*@
<script src="@Url.Content("~/Scripts/jquery.validate.min.js")" type="text/javascript"></script>
<script src="~/Scripts/jquery.validate.unobtrusive.min.js"></script>

<script type="text/javascript">
    function GetDistrictListDD() {
        var value = $("#dll_ProvinceId option:selected").val();
        $.ajax({
            @*url: "@Url.Action("GetVDCMUNDDByDistrictId", "AjaxRequest", new { @area="admin"})",*@
            url: "@Url.Action("GetDistrictListByProvinceIdDefaultValue", "AjaxRequest", new { @area = "Admin" })",
            data: { id: value },
            dataType: "json",
            type: "POST",
            error: function () {
                //GetVDCMUNDDByDistrictId
                alert("An error occurred.");
            },
            success: function (data) {
                var items = "";
                $.each(data, function (i, item) {
                    items += "<option value=\"" + item.Value + "\">" + item.Text + "</option>";
                });

                $("#dll_district").html(items);
            }
        })
    };


    function GetVDCMUNListDD() {
        var value = $("#dll_district option:selected").val();
        $.ajax({
            @*url: "@Url.Action("GetVDCMUNDDByDistrictId", "AjaxRequest", new { @area="admin"})",*@
            url: "@Url.Action("GetVDCMUNDDByDistrictIdWithDefaultValue", "AjaxRequest", new { @area = "Admin" })",
            data: { id: value },
            dataType: "json",
            type: "POST",
            error: function () {
                GetVDCMUNDDByDistrictId
                alert("An error occurred.");
            },
            success: function (data) {
                var items = "";
                $.each(data, function (i, item) {
                    items += "<option value=\"" + item.Value + "\">" + item.Text + "</option>";
                });

                $("#dll_vdcmun").html(items);
            }
        })
    };
</script>

