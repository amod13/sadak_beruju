@model _4pix_Beruju.Models.MergeOfficeMaster

@{
    ViewBag.Title = "MergeAdd";
    Layout = "~/Areas/LocalLevel/Views/Shared/_LocalLevelLayout.cshtml";
    int sn = 1;
}

<script src="~/vendor/CkStandar/ckeditor.js"></script>
<link href="~/Content/sweetalert/sweet-alert.css" rel="stylesheet" />
<div class="breadcrumb-holder">
    <div class="container-fluid">
        <ul class="breadcrumb">
            <li class="breadcrumb-item"><a href="index.html">Home</a></li>
            <li class="breadcrumb-item active">Merge</li>
        </ul>
    </div>
</div>
<section class="forms">
    <div class="container-fluid">
        <!-- Page Header-->
        <div class="row">
            <div class="col-lg-4"></div>
            <div class="col-lg-4">


            </div>

        </div>
        <div class="row">
            <div class="col-lg-12">
                <div class="card">
                    <div class="card-header d-flex align-items-center">
                        <a href="@Url.Action("MergeAdd","MergeOffices", new { @id=0})" , class="btn btn-sm btn-success">
                                <i class="fa fa-plus"></i>&nbsp;नयाँ थप्नुहोस
                            </a>


                    </div>
                    <div class="card-body">
                        <table class="table table-bordered">
                            <thead>
                                <tr>
                                    <td>क्रस</td>
                                    <td>हालको कार्यालय</td>
                                    <td>मर्ज भएका कार्यालयहरु</td>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in Model.MergeOfficeDetailsList)
                                {
                                    <tr>
                                        <td>@sn</td>
                                        <td>@_4pix_Beruju.Utilities.GetCurrentLoginOfficeName(item.MainOfficeId)</td>
                                        <td>@_4pix_Beruju.Utilities.GetCurrentLoginOfficeName(item.Officeid)</td>
                                    </tr>
                                    sn++;
                                }

                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>


