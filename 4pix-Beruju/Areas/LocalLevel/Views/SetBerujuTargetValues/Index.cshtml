@model IEnumerable<_4pix_Beruju.Models.SetBerujuTargetValue>

@{
    ViewBag.Title = "Index";
    Layout = "~/Areas/LocalLevel/Views/Shared/_LocalLevelLayout.cshtml";
}

<div class="breadcrumb-holder">
    <div class="container-fluid">
        <ul class="breadcrumb">
            <li class="breadcrumb-item"><a href="index.html">Home</a></li>
            <li class="breadcrumb-item active">लक्ष्य तथा प्रगती सेटअप</li>
        </ul>
    </div>
</div>
<section>
    <div class="container-fluid">
        <!-- Page Header-->
        <header>
            @*<h1 class="h3 display">@GrantApp.Areas.Admin.FunctionClass.GetGrantTypeNameById(Model.ViewBagGrantTypeId)</h1>*@
        </header>

        <div class="row">
            <div class="col-lg-12">
                <div class="card">
                    <div class="card-header">
                        <h4>

                            <a href="@Url.Action("Create","SetBerujuTargetValues")" , class="btn btn-sm btn-success">
                                <i class="fa fa-plus"></i>&nbsp;नयाँ थप्नुहोस
                            </a>
                        </h4>
                    </div>

                    <div class="card-body" id="DetailsReportsID">
                        <div class="table-responsive table-sm shadow p-3 mb-5 bg-white rounded">
                            <table class="table table-hover table-sm table-bordered">
                                <thead>
                                    <tr>

                                        <th>
                                            @Html.DisplayNameFor(model => model.FiscalYearId)
                                        </th>
                                        <th>
                                            @Html.DisplayNameFor(model => model.NIyamitTargetVal)
                                        </th>
                                        <th>
                                            @Html.DisplayNameFor(model => model.AshuliTargetVal)
                                        </th>
                                        <th>
                                            @Html.DisplayNameFor(model => model.PeshkiTargetVal)
                                        </th>

                                        <th></th>
                                    </tr>
                                </thead>
                                @foreach (var item in Model)
                                {
                                    <tr>

                                        <td>
                                            @_4pix_Beruju.Areas.Admin.functions.GetFiscalyearTitleFromId(item.FiscalYearId)
                                        </td>
                                        <td>
                                            @Html.DisplayFor(modelItem => item.NIyamitTargetVal)
                                        </td>
                                        <td>
                                            @Html.DisplayFor(modelItem => item.AshuliTargetVal)
                                        </td>
                                        <td>
                                            @Html.DisplayFor(modelItem => item.PeshkiTargetVal)
                                        </td>

                                        <td>
                                            @Html.ActionLink(" ", "Edit", new { @id = item.BerujuTargetId }, new { @class = "edits fa fa-edit" })
                                            @Html.ActionLink(" ", "Delete", new { id = item.BerujuTargetId }, new { @class = "edits fa fa-trash" })
                                            @*@Html.ActionLink("Details", "Details", new { id = item.BerujuTargetId }) |
                                                @Html.ActionLink("Delete", "Delete", new { id = item.BerujuTargetId })*@
                                        </td>
                                    </tr>
                                }

                            </table>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>