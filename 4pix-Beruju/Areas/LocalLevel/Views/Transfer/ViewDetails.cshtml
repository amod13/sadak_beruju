@model _4pix_Beruju.Models.BerujuCheckerReportFilter

@{
    ViewBag.Title = "ViewDetails";
    Layout = "~/Areas/LocalLevel/Views/Shared/_LocalLevelLayout.cshtml";
}

<style>
    .btn-toolbar {
        display: inline !important;
    }
</style>
<style>
    .fake_fieldset {
        border: 2px groove ButtonFace;
        border-top-width: 0;
        margin-left: 2px;
        margin-right: 2px;
        padding: .35em .625em .75em;
        margin-top: 1em;
        position: relative;
    }

    .fake_legend {
        margin-top: -1em;
    }

        .fake_legend.test1::before {
            position: absolute;
            top: 0;
            left: -1px;
            border-top: 2px groove ButtonFace;
            content: " ";
            width: 0.5em;
        }

        .fake_legend.test1::after {
            position: absolute;
            top: 0;
            right: -1px;
            border-top: 2px groove ButtonFace;
            content: " ";
            width: 40%;
        }
</style>



<section class="forms">
    <div class="container-fluid">
        <!-- Page Header-->
        <header>
            <h1 class="h3 display">Data Transfer गन खोजिएको बेरुजुको बिवरणः एक पटक विवरण रुजु गरि Transfer गर्नुहोला ।</h1>
        </header>

        <div class="row">
            <div class="col-lg-6">

                <div class="clearfix"></div>
                <hr />


                <div class="card">
                    <div class="card-header d-flex align-items-center">

                        @*<a href="@Url.Action("Index","ExternalBerujuLL", new { @id=Model.ExternalBeruju.KoshTypeId})" , class="btn btn-sm btn-success">
                            <i class="fa fa-backward"></i>&nbsp;मूख्य मेनु
                        </a>
                        <input type="button" id="btnExportPDF" value="Export-PDF" class="btn btn-info btn-sm" style="margin-left:20px;" />*@
                    </div>
                    <div>
                        <div class="row">

                        </div>
                    </div>



                    <div class="card-body" id="DetailsReportsID">
                        <div class="fake_fieldset test1">
                            <div class="fake_legend test1">विवरण:</div>
                            <div class="row">
                                <div class="col-lg-2 col-md-3 form-group"><b>आर्थिक वर्ष :</b></div>
                                <div class="col-lg-2 col-md-9 form-group">@_4pix_Beruju.Areas.Admin.functions.GetFiscalyearTitleFromId(Model.ExternalBeruju.FiscalYearId)</div>


                                <div class="col-lg-2 col-md-3 form-group"><b>वजेट उपशिर्षक :</b></div>
                                <div class="col-lg-2 col-md-9 form-group">@_4pix_Beruju.Areas.Admin.functions.GetBudgetSubTitleById(Model.ExternalBeruju.BudgetSubTitle)</div>

                                <div class="col-lg-2 col-md-3 form-group"><b> खर्च शिर्षक :</b></div>
                                <div class="col-lg-2 col-md-9 form-group">@_4pix_Beruju.Areas.Admin.functions.GetChaluOrPujigatKharchaTitleBId(Model.ExternalBeruju.KoshTypeTitleListId)</div>
                            </div>



                            <div class="row">
                                <div class="col-lg-2 col-md-3 form-group"><b>गोश्वारा भौचर नम्बर :</b></div>
                                <div class="col-lg-2 col-md-9 form-group">@Model.ExternalBeruju.JVNUMBER</div>


                                <div class="col-lg-2 col-md-3 form-group"><b>भौचर मिति :</b></div>
                                <div class="col-lg-2 col-md-9 form-group">@Model.ExternalBeruju.VoucharDateStr</div>

                                <div class="col-lg-2 col-md-3 form-group"><b>बेरुजु रकम :</b></div>
                                <div class="col-lg-2 col-md-9 form-group">@Model.ExternalBeruju.VoucharAmunt</div>
                            </div>
                            <div class="row">
                                <div class="col-lg-3 col-md-3 form-group"><b>बेरूजुको संप्क्षित विवरण :</b></div>
                                <div class="col-lg-9 col-md-9 form-group">@Html.Raw(Model.ExternalBeruju.BerujuShorDesc)</div>


                            </div>

                            <div class="row">
                                <div class="col-lg-3 col-md-3 form-group"><b>बेरुजुको विस्तृत व्यहोरा :</b></div>
                                <div class="col-lg-9 col-md-9 form-group">@Html.Raw(Model.ExternalBeruju.BerujuDetails)</div>


                            </div>


                            <div class="row">
                                <div class="col-lg-2 col-md-3 form-group"><b>बेरूजुको प्रकार :</b></div>
                                <div class="col-lg-2 col-md-9 form-group">@_4pix_Beruju.Areas.Admin.functions.GetBerujuTypeFromId(Model.ExternalBeruju.BerujuTypeId)</div>


                                <div class="col-lg-2 col-md-4 form-group"><b>बेरूजुको उपप्रकार:</b></div>
                                <div class="col-lg-3 col-md-8 form-group">@_4pix_Beruju.Utilities.GetBerujuSubtitleNameFromId(Model.ExternalBeruju.BerujuSubTitleId)</div>


                            </div>
                            <div class="row">


                                <div class="col-lg-3 col-md-3 form-group"><b>कोष प्रकार :</b></div>
                                <div class="col-lg-3 col-md-9 form-group">@_4pix_Beruju.Areas.Admin.functions.GetKoshTypeFromId(Model.ExternalBeruju.KoshTypeId)</div>

                                <div class="col-lg-3 col-md-3 form-group"><b>सम्बन्धित :</b></div>
                                <div class="col-lg-3 col-md-9 form-group">@_4pix_Beruju.Areas.Admin.functions.ToWhomTypeById(Model.ExternalBeruju.ToWhomID)</div>
                            </div>

                            <div class="row">
                                <div class="col-lg-3 col-md-3 form-group"><b>सम्बन्धितको विवरण :</b></div>






                            </div>
                            <div class="row">
                                <div class="col-lg-12">

                                    <table class="table table-bordered table-responsive-sm">

                                        <thead>
                                            <tr>
                                                <th>नाम</th>
                                                <th>प्यान नं</th>
                                                <th>मोबाईल नं</th>
                                                <th>रकम</th>
                                                @*<th>कागजात</th>*@
                                            </tr>
                                        </thead>
                                        @foreach (var item in Model.ExternalBeruju.ToWhomDetailListVMList)
                                        {
                                            <tr>
                                                <td>@item.EmployeeName</td>
                                                <td>@item.PanNumber</td>
                                                <td>@item.MobielNumber</td>
                                                <td>@item.AmountDetail</td>
                                                @*<td>@item.UploadedFileUrl</td>*@
                                            </tr>

                                        }
                                    </table>
                                </div>
                            </div>



                        </div>
                    </div>



                </div>




            </div>

            <div class="col-md-6">
                <h5>Supporting Document</h5>

                @if (!string.IsNullOrEmpty(Model.ExternalBeruju.UploadedFileUrl))
                {
                    var filePath = Url.Content("~/RequiredDocs/" + Model.ExternalBeruju.UploadedFileUrl);
                    var extension = System.IO.Path.GetExtension(Model.ExternalBeruju.UploadedFileUrl).ToLower();

                    if (extension == ".pdf")
                    {
                        <!-- ✅ Show PDF inline (with viewer) -->
                        <iframe src="@filePath" width="100%" height="500px" style="border:1px solid #ccc; border-radius:8px;"></iframe>
                    }
                    else if (extension == ".png" || extension == ".jpg" || extension == ".jpeg")
                    {
                        <!-- ✅ Show Image inline -->
                        <img src="@filePath" alt="Uploaded File" class="img-fluid rounded shadow-sm" style="max-height:500px; object-fit:contain;" />
                    }
                    else
                    {
                        <!-- ✅ Fallback: Just show download link -->
                        <a href="@filePath" target="_blank">View / Download File</a>
                    }
                }
                else
                {
                    <p class="text-muted">No file uploaded.</p>
                }
            </div>

        </div>

        <div>
            <p>माथी उल्लेख भएको बेरूजु अन्य सम्बन्धित कार्यालयमा डाटा सार्नका निम्ती कार्यालय छान्नुहोस र trasnfer बटन थिच्नुहोाल।</p>
            @using (Html.BeginForm("BerujuTransfer", "Transfer", FormMethod.Post))
            

                {

                    @Html.HiddenFor(m => m.ExternalBeruju.ExternalBerujuId)
        <fieldset>
            <div class="row">



                <div class="col-md-3 col-sm-6 form-group">
                    <label>कार्यालय प्रकार</label>
                    @Html.DropDownListFor(m => m.OfficeTypeSearchId, Utilities.GetOfficeTypeDDWithDefaultForSuperAdmin(), new { @class = "form-control form-control sm", @id = "dll_OfficeType" })
                    @Html.ValidationMessageFor(m => m.OfficeTypeSearchId)
                </div>

                <div class="col-md-3 col-sm-6 form-group" id="Div_Ministry">
                    <label>मन्त्रालय</label>
                    @Html.DropDownListFor(m => m.MininstrySearchId, Utilities.GetMinistryListWithDefaultForProvinceAdmin(0, 2), new { @class = "form-control form-control sm", @id = "dll_ministry" })

                </div>
                <div class="col-md-3 col-sm-6 form-group" id="Div_Bivag">
                    <label>विभाग</label>
                    @Html.DropDownListFor(m => m.BivagSearchId, Utilities.GetNirdeshayalaDefault(), new { @class = "form-control form-control sm", @id = "dll_bivag" })

                </div>

                <div class="col-md-3 col-sm-6 form-group" id="Div_Nirdesha">
                    <label>निर्देशनालय</label>
                    @Html.DropDownListFor(m => m.NirdeshnalayaSearchId, Utilities.GetNirdeshayalaDefault(), new { @class = "form-control form-control sm", @id = "dll_nirdesh" })

                </div>


                <div class="col-md-3 col-sm-6 form-group" id="Div_Office">
                    <label>कार्यालय/अन्य</label>
                    @Html.DropDownListFor(model => model.KaryalayaSearchId, Utilities.GetNirdeshayalaDefault(), new { @class = "form-control form-control-sm", id = "dll_office" })

                </div>





            </div>

            <div class="col-md-3 col-sm-6 form-group">


                <label class="mr-3">
                    @Html.RadioButtonFor(m => m.Status, 0, new { id = "Status_ErrorCorrection" })
                    त्रुटि सच्याउने
                </label>

                <label class="mr-3">
                    @Html.RadioButtonFor(m => m.Status, 1, new { id = "Status_Merge" })
                    मर्ज
                </label>
            </div>

            <button type="submit" class="btn btn-primary"><i class="fa fa-floppy-o">&nbsp;</i>Transfer</button>
        </fieldset>
                }
            </div>
    </div>
</section>

<script src="~/Scripts/jquery-3.3.1.min.js"></script>





@*<script src="~/Scripts/jquery-1.10.2.js"></script>*@
<script src="~/Scripts/jquery.unobtrusive-ajax.js"></script>

<script type="text/javascript" src="https://ajax.googleapis.com/ajax/libs/jquery/1.8.3/jquery.min.js"></script>
<script src="~/Scripts/SweetAlert.min.js"></script>

<script src="~/Scripts/dropdown_helper.js"></script>

<script>
    const url_bivag = '@Url.Action("GetBivagFromMinistryDD", "AjaxRequest", new { area = "admin" })';
    const url_nirdesh = '@Url.Action("GetNirdeshanalayaList", "AjaxRequest", new { area = "admin" })';
    const url_office = '@Url.Action("GetOfficesList", "AjaxRequest", new { area = "admin" })';
</script>
