    $j = jQuery.noConflict();
    $j(function () {
        //$j('.select2').select2();
        //$("#MaskDate").mask("(999) 999-9999");
        $j('.MaskDate').inputmask('9999/99/99', { 'placeholder': 'yyyy/mm/dd' })
    });

</script>


<script type="text/javascript" src="https://ajax.googleapis.com/ajax/libs/jquery/1.8.3/jquery.min.js"></script>
<script src="@Url.Content("~/Scripts/OrderManagerScript.js")" type="text/javascript"></script>

<script type="text/javascript">

    var kk = $.noConflict();
    kk(document).ready(function () {
        AddClickEvents();

    });
</script>
<script>


    function GetBudgetSubTitleByFYID() {

        var FYIDVal = $("#DDFYID option:selected").val();
        if (FYIDVal != null) {


            $.ajax({
                url: "@Url.Action("GetBudgetSubtitleFromOfficeIdFYID", "AjaxRequest", new { @area="admin"})",
                data: { id: FYIDVal },
                dataType: "json",
                type: "POST",
                error: function () {
                    alert("An error occurred.");
                },
                success: function (data) {
                    var items = "";
                    $.each(data, function (i, item) {
                        items += "<option value=\"" + item.Value + "\">" + item.Text + "</option>";
                    });

                    $("#BSTID").html(items);
                }
            })
        }

    };

    function GetTypeListDD() {

        //var koshIdVal = $("#KoshTypeIdDD option:selected").val();
        var koshIdVal = '@Model.KoshTypeId';
        var ChaluOrIdVal = $("#ChaluOrPujiDD option:selected").val();
        $.ajax({
            url: "@Url.Action("GetTypeListDD", "AjaxRequest", new { @area="admin"})",
            data: { id: koshIdVal, id1:ChaluOrIdVal},
            dataType: "json",
            type: "POST",
            error: function () {
                alert("An error occurred.");
            },
            success: function (data) {
                var items = "";
                $.each(data, function (i, item) {
                    items += "<option value=\"" + item.Value + "\">" + item.Text + "</option>";
                });

                $("#KoshTypeListTitleDD").html(items);
            }
        })

    };
    function GetBerujuSubTitleDD() {
        var value = $("#BerujuTypeIdDD option:selected").val();
        $.ajax({
            url: "@Url.Action("GetBerujuSubTitleDD", "AjaxRequest", new { @area="admin"})",
            data: { id: value },
            dataType: "json",
            type: "POST",
            error: function () {
                alert("An error occurred.");
            },
            success: function (data) {
                var items = "";
                $.each(data, function (i, item) {
                    items += "<option value=\"" + item.Value + "\">" + item.Text + "</option>";
                });

                $("#Berujusubtitleiddiv").html(items);
            }
        })
    };
</script>

<script type="text/javascript">

    kk("#Add-Item").on('click', '.row-button', function () {
        kk(this).closest("div.row").remove();
        var sum = 0;
        kk('.ItemTotal').each(function () {
            sum += Number(kk(this).val());
        });

        kk("#TTSamparikshadAmt").val(sum);

    });
</script>

<script type="text/javascript">
    function calAmt() {
        var sum = 0;
        $('.ItemTotal').each(function () {
            sum += Number($(this).val());
        });

        $("#TTSamparikshadAmt").val(sum);
    };
</script>

<script src="~/Scripts/SweetAlert.min.js"></script>
<script type="text/javascript">

    kk(function () {
         var a = '@TempData["Success"]';
         var b = '@TempData["Error"]';
        if (a != '') {
            sweetAlert(a, "success", "success");
        }
        else if (b != '')
        {
            sweetAlert(b, "Error", "error");
        }
        else {

        }


    });


</script>





