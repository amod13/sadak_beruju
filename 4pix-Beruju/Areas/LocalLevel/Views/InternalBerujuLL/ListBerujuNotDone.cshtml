@model _4pix_Beruju.Models.BerujuNotDoneModel

@{
    ViewBag.Title = "ListBerujuNotDone";
    Layout = "~/Areas/LocalLevel/Views/Shared/_LocalLevelLayout.cshtml"; int i = 1;
}
<div class="breadcrumb-holder">
    <div class="container-fluid">
        <ul class="breadcrumb">
            <li class="breadcrumb-item"><a href="#">Home</a></li>
            <li class="breadcrumb-item active">बेरूजु नभएको (आन्तरिक)</li>
        </ul>
    </div>
</div>

<section>
    <div class="container-fluid">
        <!-- Page Header-->
        <header>
            @*<h1 class="h3 display">@GrantApp.Areas.Admin.FunctionClass.GetGrantTypeNameById(Model.ViewBagGrantTypeId)</h1>*@
        </header>

        <div class="row">
            <div class="col-lg-12">
                <div class="card">
                    <div class="card-header">
                        <h4>
                            

                            <a href="@Url.Action("CreateBerujuNotDone","InternalBerujuLL",new { @id=Model.InternalOrExternal})" , class="btn btn-sm btn-success">
                                <i class="fa fa-plus"></i>&nbsp;नयाँ थप्नुहोस
                            </a>
                        </h4>
                    </div>
                    <div class="card-body">
                        <div class="table-responsive table-sm shadow p-3 mb-5 bg-white rounded">
                            <table class="table table-hover table-sm table-bordered">
                                <thead>
                                    <tr>
                                        <th>क्रम</th>
                                        <th>आर्थिक वर्ष</th>                                        
                                        <th>सच्चाउनुहोस</th>
                                        @*<th>हटाउनुहोस</th>*@
                                        <th>विवरण</th>
                                        
                                    </tr>
                                </thead>
                                <tbody>

                                    @foreach (var item in Model.BerujuNotDoneModelList)
                                    {

                                    <tr>
                                        <td scope="row">@i</td>
                                        <td>@_4pix_Beruju.Areas.Admin.functions.GetFiscalyearTitleFromId(item.FiscalYearId)</td>

                                        <td>
                                            @Html.ActionLink(" ", "EditBerujuNotDone", new { @id = item.BerujuNotDoneId,@id1=Model.InternalOrExternal }, new { @class = "edits fa fa-edit" })
                                        </td>
                                        @*<td>
                                            @Html.ActionLink(" ", "DeleteBerujuNotDoneFromList", new { @id = item.BerujuNotDoneId,@id1=Model.InternalOrExternal }, new { @class = "edits fa fa-edit" })
                                        </td>*@
                                        <td>
                                            @Html.ActionLink(" ", "ViewDetailsBerujuNotDone", new { @id = item.BerujuNotDoneId,@id1=Model.InternalOrExternal}, new { @class = "edits fa fa-eye" })
                                        </td>



                                    </tr>
                                        ++i;
                                    }


                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>
@*<link href="~/Content/SweetAlert.css" rel="stylesheet" />*@
<link href="~/Content/sweetalert/sweet-alert.css" rel="stylesheet" />
<script src="~/Scripts/jquery-3.3.1.min.js"></script>
<script src="~/Scripts/SweetAlert.min.js"></script>


<script type="text/javascript">
     $(function () {
         var a = '@TempData["Success"]';
         var b = '@TempData["Error"]';
        if (a != '') {
            sweetAlert(a, "success", "success");
        }
        else if (b != '')
        {
            sweetAlert(b, "Error", "error");
        }
        else {

        }


    });


</script>
