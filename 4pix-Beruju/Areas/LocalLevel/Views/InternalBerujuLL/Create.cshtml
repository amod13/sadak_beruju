@model _4pix_Beruju.Models.InternalBeruju

@{
    ViewBag.Title = "Create";
    Layout = "~/Areas/LocalLevel/Views/Shared/_LocalLevelLayout.cshtml";
    int i = 1;
}
<script src="~/vendor/CkStandar/ckeditor.js"></script>
<link href="~/Content/sweetalert/sweet-alert.css" rel="stylesheet" />


<div class="breadcrumb-holder">
    <div class="container-fluid">
        <ul class="breadcrumb">
            <li class="breadcrumb-item"><a href="index.html">Home</a></li>
            <li class="breadcrumb-item active">आन्तरिक लेखापरीक्षण बेरूजु</li>
        </ul>
    </div>
</div>
<section class="forms">
    <div class="container-fluid">
        <!-- Page Header-->

        <div class="row">
            <div class="col-lg-4"></div>
            <div class="col-lg-4">

                <h6 class="h3 display">आन्तरिक लेखापरीक्षण बेरूजु (@_4pix_Beruju.Areas.Admin.functions.GetKoshTypeFromId(Model.KoshTypeId))</h6>

            </div>

        </div>
        <div class="row">

            <div class="col-lg-12">

                <div class="card">
                    <div class="card-header d-flex align-items-center">

                        @if (ViewBag.ErrorMessage != null)
                        {
                            <div style="color:red;font-size:15px;font-style:italic;">@ViewBag.ErrorMessage</div>
                        }

                    </div>
                    <div class="card-body">

                        @using (Html.BeginForm("Create", "InternalBerujuLL", FormMethod.Post,
new { enctype = "multipart/form-data" }))
                        {


                            @Html.ValidationSummary(true)
                            @Html.HiddenFor(m => m.KoshTypeId)
                            <fieldset>
                                @Html.Partial("_CreateEdit")


                                <div class="well well-small" id="Add-Item" style="width: 990px;">

                                    @Html.ActionLink("विवरण थप्नुहोस", "ToWhomeDetailsList", null, new { @id = "btns", @class = "addProductItem btn btn-success" })

                                    <table id="tblotm" style="width: 740px; margin-left: 0px !important;margin-top:10px;">
                                        <tr>

                                            <td style="width:320px;font-weight:bold;">सम्बन्धितको नाम</td>
                                            <td style="width:160px;font-weight:bold;">प्यान नं</td>
                                            <td style="width:180px;font-weight:bold;">मोबाईल नं</td>
                                            <td style="width:150px;font-weight:bold;">रकम</td>

                                        </tr>


                                    </table>

                                    @try
                                    {
                                        foreach (var item in Model.ToWhomDetailListVMList)
                                        {

                                            @Html.Partial("ToWhomeDetailsList", item)

                                        }
                                    }
                                    catch { }

                                </div>




                                <br />

                                <div class="row">
                                    <div class="col-md-4 col-sm-4 form-group">
                                        <label>बेरूजु रकम</label>
                                        @Html.TextBoxFor(m => m.VoucharAmunt, new { @id = "TTSamparikshadAmt", @class = "form-control form-control-sm", @required = "required", @readonly = "readonly" })
                                    </div>
                                </div>

                                <hr />
                                <div class="form-group">
                                    @*<button type="submit" class="btn btn-secondary"><i class="fa fa-angle-double-left">&nbsp;</i> Back</button> &nbsp; &nbsp; &nbsp;*@
                                    <button type="submit" class="btn btn-primary btn-sm"><i class="fa fa-floppy-o">&nbsp;</i>सुरक्षित गर्नुहोस</button>
                                    <a href="@Url.Action("Index","InternalBerujuLL",new { @id=Model.KoshTypeId})" , class="btn btn-sm btn-success">
                                        <i class="fa fa-backward"></i>&nbsp;मूख्य मेनु
                                    </a>
                                </div>
                            </fieldset>
                        }
                    </div>
                </div>
            </div>
        </div>
        <div class="row">
            <div class="card-body">
                <div class="offset-lg-10">
                    <a href="@Url.Action("Index","InternalBerujuLL", new { @id=Model.KoshTypeId})" , class="btn btn-sm btn-success pull-right">
                        <i class="fa fa-backward"></i>&nbsp; पूर्ण सूची हेर्नुहोस
                    </a>
                </div>
                <div class="table-responsive table-sm shadow p-3 mb-5 bg-white rounded">
                    <table class="table table-hover table-sm table-bordered">
                        <thead>
                            <tr>
                                <th>क्रम</th>
                                <th>आर्थिक वर्ष</th>
                                <th>बेरुजु दफा न</th>
                                <th>वजेट उपशिर्षक</th>
                                <th>खर्च शिर्षक</th>
                                <th>बेरूजु रकम</th>
                                <th>सच्चाउनुहोस</th>
                                <th>विवरण</th>
                                @*<th>हटाउनुहोस</th>*@
                                <th>अन्तिम बेरुजु</th>
                            </tr>
                        </thead>
                        <tbody>

                            @foreach (var item in Model.InternalBerujuTopFiveList)
                            {

                                <tr>
                                    <td scope="row">@i</td>
                                    <td>@_4pix_Beruju.Areas.Admin.functions.GetFiscalyearTitleFromId(item.FiscalYearId)</td>
                                    <td>@item.BerujuNumber</td>
                                    <td>@_4pix_Beruju.Areas.Admin.functions.GetBudgetSubTitleById(item.BudgetSubTitle)</td>
                                    <td>@_4pix_Beruju.Areas.Admin.functions.GetChaluOrPujigatKharchaTitleBId(item.KoshTypeTitleListId)</td>
                                    <td>@item.VoucharAmunt</td>

                                    <td>
                                        @Html.ActionLink(" ", "Edit", new { @id = item.InternalBerujuId }, new { @class = "edits fa fa-edit" })
                                    </td>

                                    <td>
                                        @Html.ActionLink(" ", "ViewDetails", new { @id = item.InternalBerujuId }, new { @class = "edits fa fa-eye" })
                                    </td>
                                    @*<td>
                                        @Html.ActionLink(" ", "DeleteFromCreate", new { @id = item.InternalBerujuId, @id1 = item.KoshTypeId }, new { @class = "edits fa fa-trash" })
                                    </td>*@
                                    <td>
                                        <a href="~/LocalLevel/InternalBerujuLL/ChangeToFinalBeruju?id=@item.InternalBerujuId&id1=@item.KoshTypeId" id="deleteBtn" class="edits" onclick="return confirm('Are you sure you want to change?');"><i class="edits fa fa-list-ol"></i></a>
                                        @*@Html.ActionLink(" ", "ChangeToFinalBeruju", new { @id = item.InternalBerujuId }, new { @class = "edits fa fa-list-ol" })*@
                                    </td>


                                </tr>
                                ++i;
                            }


                        </tbody>
                    </table>
                </div>
            </div>
        </div>

    </div>
</section>




<script src="~/Scripts/jquery-3.3.1.min.js"></script>
@*<script src="~/AdminResources/js/inputmask/inputmask.js"></script>*@
<script src="~/AdminResources/js/inputmask/jquery.inputmask.min.js"></script>
