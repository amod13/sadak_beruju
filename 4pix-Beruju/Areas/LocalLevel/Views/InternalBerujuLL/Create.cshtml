<script type="text/javascript">

    kk("#Add-Item").on('click', '.row-button', function () {
        kk(this).closest("div.row").remove();
        var sum = 0;
        kk('.ItemTotal').each(function () {
            sum += Number(kk(this).val());
        });

        kk("#TTSamparikshadAmt").val(sum);

    })
</script>
<script type="text/javascript">
    function calAmt() {
        var sum = 0;
        kk('.ItemTotal').each(function () {
            sum += Number($(this).val());
        });

        kk("#TTSamparikshadAmt").val(sum);
    };




</script>


<script src="~/Scripts/SweetAlert.min.js"></script>


<script type="text/javascript">

    kk(function () {
         var a = '@TempData["Success"]';
         var b = '@TempData["Error"]';
        if (a != '') {
            sweetAlert(a, "success", "success");
        }
        else if (b != '')
        {
            sweetAlert(b, "Error", "error");
        }
        else {

        }


    });


</script>



