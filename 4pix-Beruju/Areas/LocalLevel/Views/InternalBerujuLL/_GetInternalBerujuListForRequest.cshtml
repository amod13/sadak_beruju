@model _4pix_Beruju.Models.InternalBeruju

@{
    int i = 1;
}

<div class="table-responsive table-sm shadow p-3 mb-5 bg-white rounded">
    <table class="table table-hover table-sm table-bordered">
        <thead>
            <tr>
                <th>क्रम</th>
                <th>आर्थिक वर्ष</th>
                <th>वजेट उपशिर्षक</th>
                <th>बेरूजु दफा नं</th>
                <th>गो.भैा.न.</th>
                <th>खर्च शिर्षक</th>
                <th>बेरूजु रकम</th>
                <th>पूर्ण विवरण</th>
                <th>सम्परीक्षण अनुरोध</th>
                <th>पत्र</th>
            </tr>
        </thead>
        <tbody>

            @foreach (var item in Model.InternalBerujuList)
            {

            <tr>
                <td scope="row">@i</td>
                <td>@_4pix_Beruju.Areas.Admin.functions.GetFiscalyearTitleFromId(item.FiscalYearId)</td>

                <td>@_4pix_Beruju.Areas.Admin.functions.GetBudgetSubTitleById(item.BudgetSubTitle)</td>
                <td>@item.BerujuNumber</td>
                <td>@item.JVNUMBER</td>
                <td>@_4pix_Beruju.Areas.Admin.functions.GetChaluOrPujigatKharchaTitleBId(item.KoshTypeTitleListId)</td>
                <td>@item.VoucharAmunt</td>

                <td>
                    <a href="~/LocalLevel/InternalBerujuLL/ViewDetails?id=@item.InternalBerujuId" id="deleteBtn" class="edits" target="_blank"><i class="edits fa fa-eye"></i></a>
                </td>

                <td>
                    <a href="~/LocalLevel/InternalBerujuLL/MakeInternalSamparikshadRequestForm?id=@item.InternalBerujuId" id="deleteBtn" class="edits" onclick="return confirm('के तपाँई को विवरण लाई सम्परिक्षणको लागी अनुरोध गर्न चाहानुहुन्छ ?');"><i class="edits fa fa-list-ol"></i></a>
                    @*@Html.ActionLink(" ", "ChangeToFinalBeruju", new { @id = item.InternalBerujuId }, new { @class = "edits fa fa-list-ol" })*@
                </td>

                <td>
                    <a href="~/LocalLevel/InternalBerujuLL/ViewInternalSamparikshadReqForm?id=@item.InternalBerujuId" id="deleteBtn" class="edits" target="_blank"><i class="edits fa fa-eye"></i></a>
                </td>





            </tr>
                ++i;
            }


        </tbody>
    </table>
</div>

