        $(function () {
            $("#btnSubmit").click(function () {
                $("input[name='ExportData']").val($("#double-scroll").html());
            });
        });
    </script>*@


<script type="text/javascript">$("body").on("click", "#btnExportPDF", function () {
        $("#DetailsReportsID").css("width", "1500px");
        $("#DetailsReportsID").css("text-align", "left");
        $("#Headtitle").css("text-align", "left");
        $("#rptTitle").css("text-align", "left");
        $("th").css("text-align", "left");

        window.scrollTo(0, 0);

        html2canvas($('#DetailsReportsID')[0], {
            onrendered: function (canvas) {
                var data = canvas.toDataURL();
                var docDefinition = {
                    content: [{
                        image: data,
                        width: 500,
                        scale: 1
                    }]
                };
                pdfMake.createPdf(docDefinition).download("Report-details.pdf");
                $("#DetailsReportsID").css("width", "auto");

            }
        });
    });</script>