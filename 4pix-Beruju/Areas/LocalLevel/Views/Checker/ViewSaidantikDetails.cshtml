@model _4pix_Beruju.Models.SaidantikBeruju

@{
    ViewBag.Title = "ViewDetails";
    Layout = "~/Areas/LocalLevel/Views/Shared/_LocalLevelLayout.cshtml";
}
<link rel="stylesheet" href="~/vendor/bootstrap/css/bootstrap.min.css" media='screen,print'>
<style>
    @@media print {
        .row {
            width: 100% !important;
        }

        .form-group, .col-xl-2, .col-xl-12 {
            width: 100% !important;
        }

        .col-lg-3, .col-lg-9 {
            width: 100% !important;
        }

        #DetailsReportsID {
            width: 100% !important;
        }

        .fake_fieldset test1 {
            width: 100% !important;
        }
    }
</style>

<style>
    .btn-toolbar {
        display: inline !important;
    }
</style>
<style>
    .fake_fieldset {
        border: 2px groove ButtonFace;
        border-top-width: 0;
        margin-left: 2px;
        margin-right: 2px;
        padding: .35em .625em .75em;
        margin-top: 1em;
        position: relative;
    }

    .fake_legend {
        margin-top: -1em;
    }

        .fake_legend.test1::before {
            position: absolute;
            top: 0;
            left: -1px;
            border-top: 2px groove ButtonFace;
            content: " ";
            width: 0.5em;
        }

        .fake_legend.test1::after {
            position: absolute;
            top: 0;
            right: -1px;
            border-top: 2px groove ButtonFace;
            content: " ";
            width: 40%;
        }
</style>



<section class="forms">
    <div class="container-fluid">
        <!-- Page Header-->
        <header>
            <h1 class="h3 display">विवरण</h1>
        </header>

        <div class="row">
            <div class="col-lg-12">

                <div class="clearfix"></div>
                <hr />


                <div class="card">
                    <div class="card-header d-flex align-items-center">
                        @*<input type="button" id="btnExport" value="Export-Excel" class="btn btn-info btn-sm" style="margin-right:10px";/>*@

                        <input type="button" id="btnExportPDF" value="Export-PDF" class="btn btn-info btn-sm" style="margin-right:10px" ; />
                        <input type="button" id="print" onclick="PrintElem('DetailsReportsID');" value="Print" class="btn btn-info btn-sm" style="margin-right:10px" ; />

                        @*<a href="@Url.Action("Index","SaidantikBeruju", new { @id=Model.InternalOrExternal})" , class="btn btn-sm btn-success">
                        <i class="fa fa-backward"></i>&nbsp;मूख्य मेनु
                    </a>*@

                    </div>
                    <div>
                        <div class="row">

                        </div>
                    </div>



                    <div class="card-body myDivToPrint" id="DetailsReportsID" style="width:100%;border:1px solid red;">
                        <div class="row">
                            <div id="Headtitle" class="col-lg-12" style="text-align:center;">
                                <p>@_4pix_Beruju.Utilities.GetCurrentLoginOfficeHeadingTitle(Model.OfficeId)</p>


                                <p>
                                    @_4pix_Beruju.Utilities.GetCurrentLoginOfficeMinistryName(Model.OfficeId)

                                </p>
                                @_4pix_Beruju.Utilities.GetCurrentLoginOfficeMainOfficenName(Model.OfficeId)
                                <p>@_4pix_Beruju.Utilities.GetCurrentLoginOfficeName(Model.OfficeId)</p>



                            </div>

                            @*<div class="col-xl-2 col-xl-2 form-group"><b>कार्यालयको नाम :</b></div>
                        <div class="col-xl-10 col-xl-10 form-group"><b>@_4pix_Beruju.Utilities.GetCurrentLoginOfficeName(Model.OfficeId)</b></div>*@

                        </div>
                        <div class="fake_fieldset test1">
                            <div class="fake_legend test1">विवरण:</div>


                            <div class="row">
                                <div class="col-lg-3 col-md-3 form-group"><b>आर्थिक वर्ष :</b></div>
                                <div class="col-lg-3 col-md-9 form-group">@_4pix_Beruju.Areas.Admin.functions.GetFiscalyearTitleFromId(Model.FiscalYearId)</div>

                                <div class="col-lg-3 col-md-3 form-group"><b>बेरुजु दफा नं :</b></div>
                                <div class="col-lg-3 col-md-9 form-group">@Model.BerujuDafaNumber</div>
                            </div>
                            <div class="row">
                                <div class="col-lg-3 col-md-3 form-group"><b>बेरूजुको संक्षिप्त विवरण :</b></div>
                                <div class="col-lg-9 col-md-9 form-group">@Html.Raw(Model.BerujuShortDesc)</div>
                                <div class="col-lg-3 col-md-3 form-group"><b>बेरूजुको पूर्ण विवरण :</b></div>
                                <div class="col-lg-9 col-md-9 form-group">@Html.Raw(Model.BerujuLongDesc)</div>
                            </div>

                        </div>
                    </div>
                </div>
            </div>

            <div class="col-md-12">
                <h5>Supporting Document</h5>

                @if (!string.IsNullOrEmpty(Model.SaidantikDoc))
                {
                    var filePath = Url.Content("~/RequiredDocs/" + Model.SaidantikDoc);
                    var extension = System.IO.Path.GetExtension(Model.SaidantikDoc).ToLower();

                    if (extension == ".pdf")
                    {
                        <!-- ✅ Show PDF inline (with viewer) -->
                        <iframe src="@filePath" width="100%" height="500px" style="border:1px solid #ccc; border-radius:8px;"></iframe>
                    }
                    else if (extension == ".png" || extension == ".jpg" || extension == ".jpeg")
                    {
                        <!-- ✅ Show Image inline -->
                        <img src="@filePath" alt="Uploaded File" class="img-fluid rounded shadow-sm" style="max-height:500px; object-fit:contain;" />
                    }
                    else
                    {
                        <!-- ✅ Fallback: Just show download link -->
                        <a href="@filePath" target="_blank">View / Download File</a>
                    }
                }
                else
                {
                    <p class="text-muted">No file uploaded.</p>
                }
            </div>




        </div>
    </div>
</section>

<script src="~/Scripts/jquery-3.3.1.min.js"></script>
<script src="~/Scripts/jquery.unobtrusive-ajax.js"></script>


<script type="text/javascript" src="https://ajax.googleapis.com/ajax/libs/jquery/1.8.3/jquery.min.js"></script>
<script src="~/AdminResources/js/table2excel.js"></script>
<script type="text/javascript">var tte = $.noConflict();
    tte(function () {
        tte("#btnExport").click(function () {
            tte("#DetailsReportsID").table2excel({
                filename: "BerujuLagatKhata.xls"
            });
        });
    });

    function PrintElem(elem) {
        var mywindow = window.open('', 'PRINT', 'height=400,width=1200');

        mywindow.document.write('<html><head><title>' + ' ' + '</title>');
        mywindow.document.write('</head><body >');
        mywindow.document.write('<h1>' + ' ' + '</h1>');
        mywindow.document.write(document.getElementById(elem).innerHTML);
        mywindow.document.write('</body></html>');
        mywindow.document.close(); // necessary for IE >= 10
        mywindow.focus(); // necessary for IE >= 10*/

        mywindow.print();
        mywindow.close();

        return true;
    }</script>
<script type="text/javascript" src="https://ajax.googleapis.com/ajax/libs/jquery/1.8.3/jquery.min.js"></script>
<script type="text/javascript" src="https://cdnjs.cloudflare.com/ajax/libs/pdfmake/0.1.22/pdfmake.min.js"></script>
<script type="text/javascript" src="https://cdnjs.cloudflare.com/ajax/libs/html2canvas/0.4.1/html2canvas.min.js"></script>
<script src="~/Scripts/pdfmake-unicode.js"></script>
