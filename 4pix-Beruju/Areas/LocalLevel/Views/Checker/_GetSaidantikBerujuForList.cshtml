@model _4pix_Beruju.Models.SaidantikBeruju
@{
    int i = 1;
    int status = 0;
    string email = Utilities.GetCurrentUserEmail();
    if (email == "checker5@gmail.com" || email == "checker6@gmail.com" || email == "checker7@gmail.com")
    {
        status = 1;
    }

}


<div class="table-responsive table-sm shadow p-3 mb-5 bg-white rounded">
    <table class="table table-hover table-sm table-bordered">
        <thead>
            <tr>
                <th>क्रम</th>
                <th>आर्थिक वर्ष</th>
                <th>बेरूजु दफा नं</th>
                <th>सच्चाउनुहोस</th>
                <th>विवरण</th>
                @if (status == 1)
                {
                    <th>हटाउनुहोस</th>
                }


            </tr>
        </thead>
        <tbody>

            @foreach (var item in Model.SaidantikBerujuList)
            {

                <tr>
                    <td scope="row">@i</td>
                    <td>@_4pix_Beruju.Areas.Admin.functions.GetFiscalyearTitleFromId(item.FiscalYearId)</td>
                    <td>@item.BerujuDafaNumber</td>
                    <td>
                        @Html.ActionLink(
                            " ",
                            "EditSaidantik",
                            new { id = item.SaidantikBerujuId, id1 = item.InternalOrExternal, id3 = Model.OfficeId },
                            new { @class = "edits fa fa-edit", target = "_blank" }
                        )
                    </td>
                    <td>
                        @Html.ActionLink(" ", "EditSaidantik", new { @id = item.SaidantikBerujuId, @id1 = item.InternalOrExternal, @id3 = Model.OfficeId }, new { @class = "edits fa fa-edit" })
                    </td>

                    <td>
                        @Html.ActionLink(" ", "ViewSaidantikDetails", new { @id = item.SaidantikBerujuId, @id1 = item.InternalOrExternal, @id3 = Model.OfficeId }, new { @class = "edits fa fa-eye" })
                    </td>
                    @if (status == 1)
                    {
                        <td>
                            <a href="javascript:void(0);"
                               class="edits fa fa-trash text-danger"
                               onclick="confirmDelete('@item.SaidantikBerujuId','@item.OfficeId')">
                            </a>
                        </td>
                    }

                </tr>
                ++i;
            }


        </tbody>
    </table>
</div>




<script src="~/DataTables/datatables.min.js"></script>
<script>
    var dt = jQuery.noConflict();
    dt(document).ready(function () {
        dt('#example').DataTable({ "pageLength": 15 });
    });
</script>