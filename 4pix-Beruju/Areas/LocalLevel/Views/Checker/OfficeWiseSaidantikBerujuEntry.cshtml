@model _4pix_Beruju.Models.BerujuCheckerReportFilter
@{
    ViewBag.Title = "ListExternalBeruju";
    Layout = "~/Areas/LocalLevel/Views/Shared/_LocalLevelLayout.cshtml";
    int i = 1;
}
<link href="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/css/select2.min.css" rel="stylesheet" />
<link href="~/Content/sweetalert/sweet-alert.css" rel="stylesheet" />
<link href="~/DataTables/datatables.min.css" rel="stylesheet" />
<div class="breadcrumb-holder">
    <div class="container-fluid">
        <ul class="breadcrumb">
            <li class="breadcrumb-item"><a href="index.html">Home</a></li>
            <li class="breadcrumb-item active">अन्तिम लेखापरीक्षण बेरूजु (सैद्दान्तिक)</li>
        </ul>
    </div>
</div>
<section>
    <div class="container-fluid">
        <!-- Page Header-->
        <h4>
            अन्तिम लेखापरीक्षण बेरूजु (सैद्दान्तिक)</h4>
            <div class="row">
                <div class="col-lg-12">
                    <div class="card">
                        <div class="card-header">
                            <div class="col-sm-12">
                                <input type="button" id="btnExport" value="Export-Excel" class="btn btn-info btn-sm" />
                                @*<input type="button" id="btnExportPDF" value="Export-PDF" class="btn btn-info btn-sm" />*@
                                <input type="button" id="print" onclick="PrintElem('DetailsReportsID');" value="Print" class="btn btn-info btn-sm" />
                            </div>

                        </div>
                        <div class="card-body">
                            @using (Ajax.BeginForm("OfficeWiseSaidantikBerujuReport", "Checker", new AjaxOptions
                            {
                                HttpMethod = "POST",
                                InsertionMode = InsertionMode.Replace,
                                UpdateTargetId = "DetailsReportsID",
                                LoadingElementId = "loader"
                            },
                              new { id = "frmExternalBeruju" }
                              ))
                            {
                                @Html.HiddenFor(m => m.BerujuStatus)
                                <fieldset>
                                    <div class="row">



                                        <div class="col-md-3 col-sm-6 form-group">
                                            <label>कार्यालय प्रकार</label>
                                            @Html.DropDownListFor(m => m.OfficeTypeSearchId, Utilities.GetOfficeTypeDDWithDefaultForSuperAdmin(), new { @class = "form-control form-control sm", @id = "dll_OfficeType" })
                                            @Html.ValidationMessageFor(m => m.OfficeTypeSearchId)
                                        </div>

                                        <div class="col-md-3 col-sm-6 form-group" id="Div_Ministry">
                                            <label>मन्त्रालय</label>
                                            @Html.DropDownListFor(m => m.MininstrySearchId, Utilities.GetMinistryListWithDefaultForProvinceAdmin(0, 2), new { @class = "form-control form-control sm", @id = "dll_ministry" })

                                        </div>
                                        <div class="col-md-3 col-sm-6 form-group" id="Div_Bivag">
                                            <label>विभाग</label>
                                            @Html.DropDownListFor(m => m.BivagSearchId, Utilities.GetNirdeshayalaDefault(), new { @class = "form-control form-control sm", @id = "dll_bivag" })

                                        </div>

                                        <div class="col-md-3 col-sm-6 form-group" id="Div_Nirdesha">
                                            <label>निर्देशनालय</label>
                                            @Html.DropDownListFor(m => m.NirdeshnalayaSearchId, Utilities.GetNirdeshayalaDefault(), new { @class = "form-control form-control sm", @id = "dll_nirdesh" })

                                        </div>


                                        <div class="col-md-3 col-sm-6 form-group" id="Div_Office">
                                            <label>कार्यालय/अन्य</label>
                                            @Html.DropDownListFor(model => model.KaryalayaSearchId, Utilities.GetNirdeshayalaDefault(), new { @class = "form-control form-control-sm", id = "dll_office" })

                                        </div>




                                    </div>

                                    <div class="row">







                                    </div>
                                    <button type="submit" class="btn btn-primary"><i class="fa fa-floppy-o">&nbsp;</i>खोज्नुहोस</button>
                                </fieldset>
                            }
                            <div id="loader" class=" aletr" style="display:none">
                                Loading...
                                <img src="~/AdminResources/img/ajax-loader.gif" />

                            </div>

                            <div id="DetailsReportsID">

                                <div class="table-responsive table-sm shadow p-3 mb-5 bg-white rounded">
                                    <table id="example" class="table table-striped table-bordered" style="width:100%">
                                        <thead>
                                            <tr>
                                                <th>क्रम</th>
                                                <th>कार्यालयको नाम</th>
                                                <th>  Entry </th>
                                                <th>  Verified</th>
                                                <th>  Unverified
                                                <th>
                                            </tr>
                                        </thead>
                                        <tbody>

                                            @foreach (var item in Model.BerujuList)
                                            {

                                                <tr>
                                                    <td scope="row">@i</td>
                                                    <td>@item.OfficeName</td>
                                                    <td>@item.TotalBeruju</td>

                                                    <td>
                                                        @Html.ActionLink(
                                                                                          item.TotalVerified.ToString(),
                                                                                          "ListSaidantikApprovedBeruju",
                                                                                          "Checker",
                                                                                          new { id = item.OfficeId },
                                                                                          null
                                                                                          )
                                                    </td>
                                                    <td>
                                                        @Html.ActionLink(
                                                                                      item.TotalUnverified.ToString(),
                                                                                      "ListSaidantikBeruju",
                                                                                      "Checker",
                                                                                      new { id = item.OfficeId },
                                                                                      null
                                                                                      )
                                                    </td>
                                                </tr>
                                                ++i;
                                            }


                                        </tbody>
                                    </table>
                                </div>




                            </div>


                        </div>

                    </div>
                </div>
            </div>
</div>

</section>

<script src="~/Scripts/jquery-3.3.1.min.js"></script>
<script src="~/AdminResources/js/inputmask/jquery.inputmask.min.js"></script>
<script type="text/javascript" src="https://ajax.googleapis.com/ajax/libs/jquery/1.8.3/jquery.min.js"></script>

<script src="~/Scripts/SweetAlert.min.js"></script>




<script src="~/Scripts/jquery.unobtrusive-ajax.js"></script>


<script src="~/Scripts/dropdown_helper.js"></script>
<script src="~/Scripts/SweetAlert.min.js"></script>

<script>
    const url_bivag = '@Url.Action("GetBivagFromMinistryDD", "AjaxRequest", new { area = "admin" })';
    const url_nirdesh = '@Url.Action("GetNirdeshanalayaList", "AjaxRequest", new { area = "admin" })';
    const url_office = '@Url.Action("GetOfficesList", "AjaxRequest", new { area = "admin" })';
</script>


<script src="~/AdminResources/js/table2excel.js"></script>
<script type="text/javascript">
    var tte = $.noConflict();
    tte(function () {
        tte("#btnExport").click(function () {
            tte("#DetailsReportsID").table2excel({
                filename: "ListExternalBeruju.xls"
            });
        });
    });

    function PrintElem(elem) {
        var mywindow = window.open('', 'PRINT', 'height=400,width=600');

        mywindow.document.write('<html><head><title>' + ' ' + '</title>');
        mywindow.document.write('</head><body >');
        mywindow.document.write('<h1>' + ' ' + '</h1>');
        mywindow.document.write(document.getElementById(elem).innerHTML);
        mywindow.document.write('</body></html>');
        mywindow.document.close(); // necessary for IE >= 10
        mywindow.focus(); // necessary for IE >= 10*/

        mywindow.print();
        mywindow.close();

        return true;
    }</script>

<script type="text/javascript">
    var kk = jQuery.noConflict();
    kk(function () {
         var a = '@TempData["Success"]';
         var b = '@TempData["Error"]';
        if (a != '') {
            sweetAlert(a, "success", "success");
        }
        else if (b != '')
        {
            sweetAlert(b, "Error", "error");
        }
        else {

        }


    });


</script>

<script src="~/DataTables/datatables.min.js"></script>
<script>
    var dt = jQuery.noConflict();
    dt(document).ready(function () {
        dt('#example').DataTable({ "pageLength": 15 });
    });</script>

<script src="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/js/select2.min.js"></script>







<script>

    jQuery(document).ready(function () {
        $('#ddl_officeId').select2({
            placeholder: "छान्नुहोस्...",
            allowClear: true,
            width: '100%'
        });
    });
</script>
