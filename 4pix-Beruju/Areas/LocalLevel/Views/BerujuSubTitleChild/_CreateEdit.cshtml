@model _4pix_Beruju.Models.BerujuSubTypeChild


<div class="row">



    <div class="col-md-4 col-sm-4 form-group">
        <label>बेरूजुको प्रकार</label>
        @Html.DropDownListFor(m => m.BerujuTypeId, _4pix_Beruju.Areas.Admin.functions.GetBerujuTypeDefaultDD(), new { @id = "BerujuTypeIdDD", @class = "form-control form-control-sm", @required = "required", @onChange = "GetBerujuSubTitleDD()" })
    </div>


    <div class="col-md-4 col-sm-4 form-group">
        <label>बेरूजुको प्रकार</label>
        @Html.DropDownListFor(m => m.BerujuSubTitleId, _4pix_Beruju.Utilities.GetBerujuSubtitleDD(Model.BerujuTypeId), new { @Id = "Berujusubtitleiddiv", @class = "form-control form-control-sm", @required = "required" })
    </div>




    <div class="col-md-6 col-sm-6 form-group">
        <label>उप शिर्षक</label>
        @Html.TextBoxFor(m => m.SubTitleChild, new { @class = "form-control form-control sm", @required = "required" })
    </div>



    <div class="clearfix"></div>
</div>
