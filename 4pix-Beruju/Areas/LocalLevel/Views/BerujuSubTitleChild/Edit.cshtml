@model _4pix_Beruju.Models.BerujuSubTypeChild
@{
    ViewBag.Title = "Create";
    Layout = "~/Areas/LocalLevel/Views/Shared/_LocalLevelLayout.cshtml";
}

<div class="breadcrumb-holder">
    <div class="container-fluid">
        <ul class="breadcrumb">
            <li class="breadcrumb-item"><a href="index.html">Home</a></li>
            <li class="breadcrumb-item active">बेरूजु प्रकार</li>
        </ul>
    </div>
</div>
<section class="forms">
    <div class="container-fluid">
        <!-- Page Header-->

        <div class="row">
            <div class="col-lg-12">
                <div class="card">
                    <div class="card-header d-flex align-items-center">

                    </div>
                    <div class="card-body">

                        @using (Html.BeginForm("Edit", "BerujuSubTitleChild", FormMethod.Post, new { enctype = "multipart/form-data" }))
                        {
                            @Html.HiddenFor(m => m.BerujuSubTitleChildId)
                            @Html.ValidationSummary(true)
                            <fieldset>
                                @Html.Partial("_CreateEdit")

                                <div class="form-group">

                                    <button type="submit" class="btn btn-primary"><i class="fa fa-floppy-o">&nbsp;</i> Save changes</button>
                                </div>
                            </fieldset>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>


<script>

        function GetBerujuSubTitleDD() {

        var value = $("#BerujuTypeIdDD option:selected").val();
        if (value != null) {
            $.ajax({
            url: "@Url.Action("GetBerujuSubTitleDD", "AjaxRequest", new { @area="admin"})",
            data: { id: value },
            dataType: "json",
            type: "POST",
            error: function () {
                alert("An error occurred.");
            },
            success: function (data) {
                var items = "";
                $.each(data, function (i, item) {
                    items += "<option value=\"" + item.Value + "\">" + item.Text + "</option>";
                });

                $("#Berujusubtitleiddiv").html(items);
            }
        })

        }

    };


</script>


