@model _4pix_Beruju.Models.ReportVIewModel
@{
    int i = 1;
}

<style>
    @@media print {
        #header, #footer, #nav {
            display: none !important;
        }
        /*@@page {margin:0 -6cm}
        html {margin:0 6cm}*/
        .myDivToPrintsdfsdfs {
            z-index: 100 !important;
            visibility: visible !important;
            position: relative !important;
            display: block !important;
            background-color: lightgray !important;
            height: 297mm !important;
            width: 211mm !important;
            position: relative !important;
            padding: 0px;
            top: 0 !important;
            left: 0 !important;
            margin: 0 !important;
            orphans: 0 !important;
            widows: 0 !important;
            overflow: visible !important;
            page-break-after: always;
        }

        #double-scroll {
            width: 1200px !important;
            overflow: hidden !important;
        }

        .doubleScroll-scroll-wrapper {
            overflow: hidden !important;
        }
    }
</style>
<style>


    #double-scroll {
        width: 980px;
    }

    #sample2 {
        width: 100%;
    }

    p {
        margin: 0;
        padding: 0;
        font-size: 14px !important;
        color: black !important;
        /*line-height: 1.4em;*/
    }
</style>
<style>
    .logoImg {
    }

        .logoImg img {
            height: 80px;
            width: 80px;
            text-align: right !important;
        }
</style>

<div class="table-responsive m_table" id="DetailsReportsID">

    <div class="row">
        <div class="col-md-4 logoImg">
            <img src="~/AdminResources/img/nepalsarkarlogoprint.png" />
        </div>

        <div id="Headtitle" class="col-md-4" style="text-align:center;">
            <p>@_4pix_Beruju.Utilities.GetCurrentLoginOfficeHeadingTitle(Model.OfficeId)</p>

            @if (Model.OfficeTypeForReportHeader == 5)
            {
                <p>
                    @_4pix_Beruju.Utilities.GetCurrentLoginOfficeMinistryName(Model.OfficeIdForReportHeader)

                </p>


            }

            @if (Model.OfficeTypeForReportHeader == 4 || Model.OfficeTypeForReportHeader == 5)
            {
                <p>
                    @_4pix_Beruju.Utilities.GetCurrentLoginOfficeMainOfficenName(Model.OfficeIdForReportHeader)

                </p>


            }

            <p style="font-weight:bold;">@_4pix_Beruju.Utilities.GetCurrentLoginOfficeName(Model.OfficeIdForReportHeader)</p>
            <p style="font-weight:bold;">@_4pix_Beruju.Utilities.GetCurrentLoginOfficeAddress(Model.OfficeIdForReportHeader)</p>

            <p>बेरूजु सम्परीक्षण गोश्वारा अभिलेख खाता</p>

        </div>
        <div class="col-md-4 text-right makeFloatright">
            <p>म.ले.प.फारम नं: ८०५</p>
            <p>साबिकको फारम नं: २०७</p>
        </div>
    </div>
    <div class="row">
        <div class="col-md-4">
            <p>
                कार्यालय सङ्केत न :@_4pix_Beruju.Utilities.GetCurrentLoginOfficeCode(Model.OfficeIdForReportHeader)


            </p>

        </div>
        <div class="col-md-4">
            @*कार्यालय*@
        </div>
    </div>
    <table class="table table-bordered my-table" id="exporttopdf">
        <thead>
            <tr>
                <th>क्रम</th>
                <th style="width: 130px;">कार्यलयको नाम</th>
                <th> बजेट उपशीर्षक / कारोबार</th>
                <th>
                    कार्यालयगत खाता पाना नं.
                </th>


                <th colspan="3">
                    सम्परीक्षणलाई अनुरोध गरेको
                </th>
                <th colspan="3">
                    सम्परीक्षण भएको
                </th>

                <th>
                    कैफियत
                </th>

            </tr>
            <tr>

                <th></th>
                <th></th>
                <th></th>
                <th></th>
                <th>
                    बेरूजु दफा नम्बर
                </th>
                <th>
                    पत्रको मिति
                </th>
                <th>
                    रकम
                </th>
                <th>
                    पत्र सङ्ख्या
                </th>
                <th>
                    मिति
                </th>
                <th>
                    रकम
                </th>
                <th>

                </th>


            </tr>

        </thead>
        <tbody>
            @foreach (var item in Model.SamparikshadGausharaKhataVMList)
            {
                //item.StypeOne = _4pix_Beruju.ReportUtilities.GetSamparikshadAmountBerujuTypeWise(1, 1, item.FiscalYearId);
                //item.StypeTwo = _4pix_Beruju.ReportUtilities.GetSamparikshadAmountBerujuTypeWise(1, 2, item.FiscalYearId);
                //item.StypeThree = _4pix_Beruju.ReportUtilities.GetSamparikshadAmountBerujuTypeWise(1, 3, item.FiscalYearId);
                //item.TypeOne = item.TypeOne.HasValue ? item.TypeOne : 0;
                //item.TypeTwo = item.TypeTwo.HasValue ? item.TypeTwo : 0;
                //item.TypeThree = item.TypeThree.HasValue ? item.TypeThree : 0;

                //item.RtypeOne = item.TypeOne - item.StypeOne;
                //item.RtypeTwo = item.TypeTwo - item.StypeTwo;
                //item.RtypeThree = item.TypeThree - item.StypeThree;
                <tr>
                    <td>@i</td>
                    <td>@_4pix_Beruju.Utilities.GetCurrentLoginOfficeName(Model.OfficeIdForReportHeader)</td>
                    <td>
                        @item.SubTitleName
                    </td>
                    <td>
                       
                    </td>
                    <td>@item.BerujuNumber</td>
                    <td>@item.RequestedDateNep</td>
                    <td>@item.ReqTotalAmount</td>

                    <td>
                        @item.LetterNumber
                    </td>
                    <td>
                        @_4pix_Beruju.Utilities.GetNepaliDateFromEng(item.RevisedDate)
                    </td>
                    <td>
                        @item.ReviesedVoucherAmount
                    </td>

                    <td></td>



                </tr>
                i++;
            }



        </tbody>
    </table>
</div>