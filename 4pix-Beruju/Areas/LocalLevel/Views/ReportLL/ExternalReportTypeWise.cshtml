@model _4pix_Beruju.Models.ReportVIewModel

@{
    ViewBag.Title = "BerujuLagatKhata";
    Layout = "~/Areas/LocalLevel/Views/Shared/_LocalLevelLayout.cshtml";
    int i = 1;
}

<style>
    @@media print {
        #exporttopdf {
            border: 1px solid !important;
            border-collapse: collapse !important;
            border-radius: 2px !important;
            margin-bottom: 10px;
            overflow: hidden;
        }

        .table table-bordered {
            border: 1px solid !important;
            border-collapse: collapse !important;
            border-radius: 2px !important;
            margin-bottom: 10px;
            overflow: hidden;
        }

        .my-table {
            width: 100%;
            height: 90vh;
            border: solid;
            table-layout: fixed;
        }
            .my-table .BerujuDetailsTd{
                width:70% !important;
            }
    }
</style>
<div class="breadcrumb-holder">
    <div class="container-fluid">
        <ul class="breadcrumb">
            <li class="breadcrumb-item"><a href="#">Home</a></li>
            <li class="breadcrumb-item active">प्रतिवेदनहरू</li>
        </ul>
    </div>
</div>

<section>
    <div class="container-fluid">
        <!-- Page Header-->
        <header>
            <h1 class="h3 display">अन्तिम बेरूजु-प्रकार अनुसार</h1>
        </header>

        <div class="row">
            <div class="col-lg-12">
                <div class="card">
                    <div class="card-header">
                        <div class="col-sm-12">
                            <input type="button" id="btnExport" value="Export-Excel" class="btn btn-info btn-sm" />
                            @*@using (Html.BeginForm("ExportHTML", "ReportLL", FormMethod.Post))
                                {
                                    <input type="hidden" name="ExportData" />
                                    <input type="submit" id="btnSubmit" value="Export" />
                                }*@
                            <input type="button" id="btnExportPDF" value="Export-PDF" class="btn btn-info btn-sm" />
                            <input type="button" id="print" onclick="PrintElem('DetailsReportsID');" value="Print" class="btn btn-info btn-sm" />
                        </div>

                    </div>
                    <div class="card-body">

                        @using (Ajax.BeginForm("ExternalReportTypeWise", "ReportLL", new AjaxOptions
                        {
                            HttpMethod = "POST",
                            InsertionMode = InsertionMode.Replace,
                            UpdateTargetId = "DetailsReportsID",
                            LoadingElementId = "loader"
                        }))
                        {
                            <fieldset>

                                @if (Model.CurrentLoginUserTypeviewModel == 2 || Model.CurrentLoginUserTypeviewModel == 8 || Model.CurrentLoginUserTypeviewModel == 9)
                                {
                                    <div class="row">


                                        <div class="col-md-3 col-sm-6 form-group">
                                            <label>कार्यालय प्रकार</label>
                                            @Html.DropDownListFor(m => m.OfficeTypeSearchId, Utilities.GetOfficeTypeDDWithDefault(), new { @class = "form-control form-control sm", @id = "dll_OfficeType", onchange = "ClearAllContent()" })

                                        </div>



                                        <div class="col-md-3 col-sm-6 form-group">
                                            <label>मन्त्रालय</label>
                                            @Html.DropDownListFor(m => m.MininstrySearchId, Utilities.GetMinistryList(Model.ProvinceIdSearch, 3), new { @class = "form-control form-control sm", @id = "dll_ministry", @onchange = "GetNirdeshanalayaList()" })

                                        </div>
                                        <div class="col-md-3 col-sm-6 form-group">
                                            <label>निर्देशनालय</label>
                                            @Html.DropDownListFor(m => m.NirdeshnalayaSearchId, Utilities.GetNirdeshayalaDefault(), new { @class = "form-control form-control sm", @id = "dll_nirdesh", @onchange = "GetOfficesList()" })

                                        </div>

                                        <div class="col-md-3 col-sm-6 form-group">
                                            <label>कार्यालय</label>
                                            @Html.DropDownListFor(model => model.OfficeId, Utilities.GetNirdeshayalaDefault(), new { @class = "form-control form-control-sm", id = "dll_office" })

                                        </div>

                                        <div class="col-md-3 col-sm-6 form-group">
                                            <label>आयोग/अन्य</label>
                                            @Html.DropDownListFor(model => model.AayogAndOthers, Utilities.GetAagyoAndOtherOfficeList(6), new { @class = "form-control form-control-sm", id = "dll_aayog" })

                                        </div>

                                        <div class="col-md-3 col-sm-6 form-group">
                                            <label>स्थानीय तह</label>
                                            @Html.DropDownListFor(model => model.LocalLevelOfficeId, Utilities.GetLocalLevelForListReport(6), new { @class = "form-control form-control-sm", id = "dll_locallevel" })

                                        </div>


                                    </div>
                                }


                                @if (Model.CurrentLoginUserTypeviewModel == 3)//Ministry level users
                                {
                                    <div class="row">

                                        <div class="col-md-3 col-sm-6 form-group">
                                            <label>कार्यालय प्रकार</label>
                                            @Html.DropDownListFor(m => m.OfficeTypeSearchId, Utilities.GetOfficeTypeDDWithoutDefaultForMinistryUser(), new { @class = "form-control form-control sm", @id = "dll_OfficeType" })

                                        </div>



                                        <div class="col-md-3 col-sm-6 form-group">
                                            <label>मन्त्रालय</label>
                                            @Html.DropDownListFor(m => m.MininstrySearchId, Utilities.GetMinistryListForMinistryUserForReport(Model.ProvinceIdSearch, 3, Model.OfficeId), new { @class = "form-control form-control sm", @id = "dll_ministry", @onchange = "GetNirdeshanalayaList()" })

                                        </div>


                                        <div class="col-md-3 col-sm-6 form-group">
                                            <label>निर्देशनालय</label>
                                            @Html.DropDownListFor(m => m.NirdeshnalayaSearchId, Utilities.GetNirdesListByMinisIdForReport(Model.ProvinceIdSearch, 4, Model.OfficeId), new { @class = "form-control form-control sm", @id = "dll_nirdesh", @onchange = "GetOfficesList()" })

                                        </div>

                                        <div class="col-md-3 col-sm-6 form-group">
                                            <label>कार्यालय</label>
                                            @Html.DropDownListFor(model => model.OfficeId, Utilities.GetNirdeshayalaDefault(), new { @class = "form-control form-control-sm", id = "dll_office" })

                                        </div>


                                    </div>
                                }



                                @if (Model.CurrentLoginUserTypeviewModel == 4)//Nirdeshanalaya
                                {
                                    <div class="row">

                                        <div class="col-md-3 col-sm-6 form-group">
                                            <label>निर्देशनालय/कार्यालय</label>
                                            @Html.DropDownListFor(model => model.OfficeId, Utilities.GetOfficesByNirdeshanalayaID(Model.OfficeId, Model.OfficeId, 4), new { @class = "form-control form-control-sm", id = "dll_office" })

                                        </div>
                                    </div>


                                }

                                @if (Model.CurrentLoginUserofficeTypeID == 101)//static code for district users
                                {
                                    <div class="row">
                                        <div class="col-md-3 col-sm-6 form-group">
                                            <label>कार्यालयहरू</label>
                                            @Html.DropDownListFor(model => model.OfficeId, Utilities.GetOfficeLevelHierarchyForDistrict(Model.OfficeId, Model.OfficeId, 4, Model.CurrentLoginUserDistrictId), new { @class = "form-control form-control-sm", id = "dll_office" })

                                        </div>
                                    </div>


                                }

                                <div class="row">

                                    <div class="col-md-4 col-sm-4 form-group">
                                        <label>आर्थिक वर्ष</label>
                                        @Html.DropDownListFor(model => model.FiscalYearId, _4pix_Beruju.Areas.Admin.functions.GetFiscalYearListWithDefaultDD(), new { @class = "form-control form-control-sm", id = "dll_FYID", onchange = "GetBaushiNumberByFiscalYearWise()" })

                                    </div>

                                    @*<div class="col-md-4 col-sm-4 form-group">
                                            <label>ब.उ.शि.नं.</label>
                                            @Html.DropDownListFor(model => model.BaushiNumberId, _4pix_Beruju.Areas.Admin.functions.GetBudgetSubTitleWithDefaultValue(), new { @class = "form-control form-control-sm", id = "dll_BaushiNumber" })

                                        </div>*@

                                    <div class="col-md-4 col-sm-4 form-group">
                                        <label>बेरुजु प्रकार</label>
                                        @Html.DropDownListFor(model => model.BerujuTypeId, _4pix_Beruju.Areas.Admin.functions.GetBerujuTypeDD(), new { @class = "form-control form-control-sm", id = "dll_BerujuType" })

                                    </div>




                                </div>
                                <button type="submit" class="btn btn-primary"><i class="fa fa-floppy-o">&nbsp;</i>खोज्नुहोस</button>
                            </fieldset>
                        }

                        <div id="loader" class=" aletr" style="display:none">
                            Loading...
                            <img src="~/AdminResources/img/ajax-loader.gif" />
                        </div>
                        <div id="DetailsReportsID"></div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>
<script src="~/Scripts/jquery-3.3.1.min.js"></script>
<script src="~/Scripts/jquery.unobtrusive-ajax.js"></script>

<script type="text/javascript">

    function ClearAllContent() {

        //$("#dll_FYID").html("<option value='0'>--Select--</option>");
        $("#dll_BaushiNumber").html("<option value='0'>--छान्नुहोस--</option>");
    }

    function GetNirdeshanalayaList() {
        var value = $("#dll_ministry option:selected").val();
        $.ajax({
            url: "@Url.Action("GetNirdeshanalayaList", "AjaxRequest", new { @area="admin"})",
            data: { id: value },
            dataType: "json",
            type: "POST",
            error: function () {
                alert("An error occurred.");
            },
            success: function (data) {
                var items = "";
                $.each(data, function (i, item) {
                    items += "<option value=\"" + item.Value + "\">" + item.Text + "</option>";
                });

                $("#dll_nirdesh").html(items);
                $("#dll_office").html("<option value='0'>--Select--</option>");
            }
        })
    };

    function GetOfficesList() {
        var value = $("#dll_nirdesh option:selected").val();
        $.ajax({
            @*url: "@Url.Action("GetVDCMUNDDByDistrictId", "AjaxRequest", new { @area="admin"})",*@
            url: "@Url.Action("GetOfficesList", "AjaxRequest", new { @area="admin"})",
            data: { id: value },
            dataType: "json",
            type: "POST",
            error: function () {
                GetVDCMUNDDByDistrictId
                alert("An error occurred.");
            },
            success: function (data) {
                var items = "";
                $.each(data, function (i, item) {
                    items += "<option value=\"" + item.Value + "\">" + item.Text + "</option>";
                });

                $("#dll_office").html(items);
            }
        })
    };


    function GetBaushiNumberByFiscalYearWise() {

        var OfficeTypeVal = $("#dll_OfficeType option:selected").val();
        var FiscalYearId = $("#dll_FYID option:selected").val();
        var SearchOfficeId = @Model.OfficeId;
        if (OfficeTypeVal == 0) {
            SearchOfficeId = 0;
        }

        if (OfficeTypeVal == 2) {
            SearchOfficeId = $("#dll_ministry option:selected").val();
        }
        if (OfficeTypeVal == 3) {
            SearchOfficeId = $("#dll_nirdesh option:selected").val();
            if (typeof SearchOfficeId == "undefined") {
                SearchOfficeId = $("#dll_office option:selected").val();
            }
        }
        if (OfficeTypeVal == 4) {
            SearchOfficeId = $("#dll_office option:selected").val();
        }
        if (OfficeTypeVal == 5) {
            SearchOfficeId = $("#dll_aayog option:selected").val();
        }
        if (OfficeTypeVal == 6) {
            SearchOfficeId = $("#dll_locallevel option:selected").val();
        }

        $.ajax({
            url: "@Url.Action("GetBasununberForReport", "AjaxRequest", new { @area="admin"})",
            data: { FyID: FiscalYearId, OfficeID: SearchOfficeId },
            dataType: "json",
            type: "POST",
            error: function () {

                alert("An error occurred.");
            },
            success: function (data) {
                var items = "";
                $.each(data, function (i, item) {
                    items += "<option value=\"" + item.Value + "\">" + item.Text + "</option>";
                });

                $("#dll_BaushiNumber").html(items);
            }
        })

    };





</script>

<script type="text/javascript" src="https://ajax.googleapis.com/ajax/libs/jquery/1.8.3/jquery.min.js"></script>
<script src="~/AdminResources/js/table2excel.js"></script>
<script type="text/javascript">
    var tte = $.noConflict();
    tte(function () {
        tte("#btnExport").click(function () {
            tte("#DetailsReportsID").table2excel({
                filename: "BerujuLagatKhata.xls"
            });
        });
    });


    function PrintElem(elem) {
        var divToPrint = document.getElementById('DetailsReportsID');
        htmlToPrint = '' +
            '<style type="text/css">' +
           

            'table th, table td {' +
            'border:1px solid #000;!important' +
            'padding;0.5em !important;' +

            '}' +

            '#header, #footer, #nav {' +
            'display: none!important;' +
            '}' +            

            '</style>';


        htmlToPrint += divToPrint.outerHTML;
        newWin = window.open("");
        newWin.document.write(htmlToPrint);
        newWin.print();
        newWin.close();

    };
</script>




<script type="text/javascript" src="https://ajax.googleapis.com/ajax/libs/jquery/1.8.3/jquery.min.js"></script>
<script type="text/javascript" src="https://cdnjs.cloudflare.com/ajax/libs/pdfmake/0.1.22/pdfmake.min.js"></script>
<script type="text/javascript" src="https://cdnjs.cloudflare.com/ajax/libs/html2canvas/0.4.1/html2canvas.min.js"></script>

<script type="text/javascript">
    $("body").on("click", "#btnExportPDF", function () {
        $("#DetailsReportsID").css("width", "1500px");
        $("#DetailsReportsID").css("text-align", "left");
        $("#Headtitle").css("text-align", "left");
        $("#rptTitle").css("text-align", "left");
        $("th").css("text-align", "left");

        window.scrollTo(0, 0);

        html2canvas($('#DetailsReportsID')[0], {
            onrendered: function (canvas) {
                var data = canvas.toDataURL();
                var docDefinition = {
                    content: [{
                        image: data,
                        width: 500,
                        scale: 1
                    }]
                };
                pdfMake.createPdf(docDefinition).download("Report-details.pdf");
                $("#DetailsReportsID").css("width", "auto");

            }
        });
    });
</script>


