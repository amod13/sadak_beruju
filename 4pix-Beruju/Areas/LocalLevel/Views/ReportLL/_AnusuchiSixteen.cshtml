                decimal? totalNiyamitAmount = item.NiyamitWithAlyaAmount - item.NiyamitSamparikshadThisYearAmount;
                decimal? totalAushiamout = item.AshuliWithAlyaAmount - item.AshuliSamparikshadThisYearAmount;
                decimal? totalAmountafterdeduct = totalPeskiAmount + totalNiyamitAmount + totalAushiamout;
