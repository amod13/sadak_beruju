<section>
    <div class="container-fluid">
        <!-- Page Header-->
        <header>
            <h1 class="h3 display">लेखापरीक्षण प्रतिवेदनमा ओैल्याएको बेरुजुको लगत</h1>
        </header>

        <div class="row">
            <div class="col-lg-12">
                <div class="card">
                    <div class="card-header">
                        <div class="col-sm-12">
                            <input type="button" id="btnExport" value="Export-Excel" class="btn btn-info btn-sm" />
                            <input type="button" id="btnExportPDF" value="Export-PDF" class="btn btn-info btn-sm" />
                            <input type="button" id="print" onclick="PrintElem('DetailsReportsID');" value="Print" class="btn btn-info btn-sm" />
                        </div>

                    </div>
                    <div class="card-body">

                        @using (Ajax.BeginForm("Anusuchi13", "ReportLL", new AjaxOptions
                        {
                            HttpMethod = "POST",
                            InsertionMode = InsertionMode.Replace,
                            UpdateTargetId = "DetailsReportsID",
                            LoadingElementId = "loader"
                        }))
                        {
                            <fieldset>

                                @if (Model.CurrentLoginUserTypeviewModel == 2 || Model.CurrentLoginUserTypeviewModel == 8 || Model.CurrentLoginUserTypeviewModel == 9 || Model.CurrentLoginUserTypeviewModel == 105)
                                {
                                    <div class="row">


                                        <div class="col-md-3 col-sm-6 form-group">
                                            <label>कार्यालय प्रकार</label>
                                            @Html.DropDownListFor(m => m.OfficeTypeSearchId, Utilities.GetOfficeTypeDDWithDefaultForSuperAdmin(), new { @class = "form-control form-control sm", @id = "dll_OfficeType" })
                                            @Html.ValidationMessageFor(m => m.OfficeTypeSearchId)
                                        </div>

                                        <div class="col-md-3 col-sm-6 form-group" id="Div_Ministry">
                                            <label>मन्त्रालय</label>
                                            @Html.DropDownListFor(m => m.MininstrySearchId, Utilities.GetMinistryListWithDefaultForProvinceAdmin(0, 2), new { @class = "form-control form-control sm", @id = "dll_ministry" })

                                        </div>
                                        <div class="col-md-3 col-sm-6 form-group" id="Div_Bivag">
                                            <label>विभाग</label>
                                            @Html.DropDownListFor(m => m.BivagSearchId, Utilities.GetNirdeshayalaDefault(), new { @class = "form-control form-control sm", @id = "dll_bivag" })

                                        </div>

                                        <div class="col-md-3 col-sm-6 form-group" id="Div_Nirdesha">
                                            <label>निर्देशनालय</label>
                                            @Html.DropDownListFor(m => m.NirdeshnalayaSearchId, Utilities.GetNirdeshayalaDefault(), new { @class = "form-control form-control sm", @id = "dll_nirdesh" })

                                        </div>


                                        <div class="col-md-3 col-sm-6 form-group" id="Div_Office">
                                            <label>कार्यालय/अन्य</label>
                                            @Html.DropDownListFor(model => model.KaryalayaSearchId, Utilities.GetNirdeshayalaDefault(), new { @class = "form-control form-control-sm", id = "dll_office" })

                                        </div>


                                    </div>
                                }
                                @if (Model.CurrentLoginUserTypeviewModel == 4)//Nirdeshanalaya
                                {
                                    <div class="row">
                                        <div class="col-md-3 col-sm-6 form-group">
                                            <label>कार्यालय</label>
                                            @Html.DropDownListFor(model => model.OfficeId, Utilities.GetOfficesByNirdeshanalayaID(Model.OfficeId, Model.OfficeId, 4), new { @class = "form-control form-control-sm", id = "dll_office" })

                                        </div>
                                    </div>


                                }


                                <div class="row">
                                    <div class="col-md-3 col-sm-4 form-group">
                                        <label>आर्थिक वर्ष</label>
                                        @Html.DropDownListFor(model => model.FiscalYearId, _4pix_Beruju.Areas.Admin.functions.GetFiscalYearListWithDefaultDD(), new { @class = "form-control form-control-sm", id = "dll_Kosh" })

                                    </div>
                                    <div class="col-md-3 col-sm-4 form-group">
                                        <label>कोष</label>
                                        @Html.DropDownListFor(model => model.KoshID, _4pix_Beruju.Areas.Admin.functions.GetKoshTypeWithoutDefault(), new { @class = "form-control form-control-sm", id = "dll_Kosh" })

                                    </div>

                                </div>


                                <button type="submit" class="btn btn-primary"><i class="fa fa-floppy-o">&nbsp;</i>खोज्नुहोस</button>
                            </fieldset>
                        }

                        <div id="loader" class=" aletr" style="display:none">
                            Loading...
                            <img src="~/AdminResources/img/ajax-loader.gif" />

                        </div>

                        <div id="DetailsReportsID">


                        </div>


                    </div>


                </div>
            </div>
        </div>
    </div>
</section>
<script src="~/Scripts/jquery-3.3.1.min.js"></script>
<script src="~/Scripts/jquery.unobtrusive-ajax.js"></script>

<script src="~/Scripts/dropdown_helper.js"></script>

<script>
    const url_bivag = '@Url.Action("GetBivagFromMinistryDD", "AjaxRequest", new { area = "admin" })';
    const url_nirdesh = '@Url.Action("GetNirdeshanalayaList", "AjaxRequest", new { area = "admin" })';
    const url_office = '@Url.Action("GetOfficesList", "AjaxRequest", new { area = "admin" })';
</script>

<script type="text/javascript" src="https://ajax.googleapis.com/ajax/libs/jquery/1.8.3/jquery.min.js"></script>
<script src="~/AdminResources/js/table2excel.js"></script>
<script type="text/javascript">


    function PrintElem(elem) {
        var divToPrint = document.getElementById('DetailsReportsID');
        htmlToPrint = '' +
            '<style type="text/css">' +
            '.my-table{' +
            'width:100% !important;' +
            'table-layout:fixed;' +
            //'overflow-wrap:break-word;' +
            'border-spacing: 0px !important;' +
            '}' +

            'table th, table td {' +
            'border:0.5px solid #000 !important;' +
            'border-collapse: collapse !important;' +
            'padding: 2px !important;' +
            'border-spacing: 0px !important;' +
            'font-size:10px !important;' +
            'font-weight: normal !important;' +

            '}' +

            '#header, #footer, #nav {' +
            'display: none!important;' +
            '}' +

            '.makeFloatright {' +
            'float:right !important;' +
            '}' +


            '.logoImg {' +
            'width:80px !important;' +
            'float:left !important;' +
            '}' +



            '</style>';
        htmlToPrint += divToPrint.outerHTML;
        newWin = window.open("");
        newWin.document.write(htmlToPrint);
        newWin.print();
        newWin.close();

    };
</script>

<script type="text/javascript" src="https://ajax.googleapis.com/ajax/libs/jquery/1.8.3/jquery.min.js"></script>
<script type="text/javascript" src="https://cdnjs.cloudflare.com/ajax/libs/pdfmake/0.1.22/pdfmake.min.js"></script>
<script type="text/javascript" src="https://cdnjs.cloudflare.com/ajax/libs/html2canvas/0.4.1/html2canvas.min.js"></script>
<script src="~/Scripts/pdfmake-unicode.js"></script>



<script type="text/javascript">
    $("body").on("click", "#btnExportPDF", function () {
        $("#DetailsReportsID").css("width", "1500px");
        $("#DetailsReportsID").css("text-align", "left");
        $("#Headtitle").css("text-align", "left");
        $("#rptTitle").css("text-align", "left");
        $("th").css("text-align", "left");

        window.scrollTo(0, 0);

        html2canvas($('#DetailsReportsID')[0], {
            onrendered: function (canvas) {
                var data = canvas.toDataURL();
                var docDefinition = {
                    content: [{
                        image: data,
                        width: 500,
                        scale: 1
                    }]
                };
                pdfMake.createPdf(docDefinition).download("Report-details.pdf");
                $("#DetailsReportsID").css("width", "auto");

            }
        });
    });
</script>


