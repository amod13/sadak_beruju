    decimal? PYAfterSamparikshad = 0m;
    decimal? TotalBerujuPY = 0m;
    decimal? TotalSamparikshadPY = 0m;
    decimal? RemainingPY = 0m;
    decimal? ThisYearAdd = 0m;
    decimal? TillDateRemainingBeruju = 0m;
    decimal? TillDateRemainingBerujuSum = 0m;
    int sn = 1; ;

}


