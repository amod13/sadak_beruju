<script type="text/javascript">

    function ClearAllContent() {

        //$("#dll_FYID").html("<option value='0'>--Select--</option>");
        $("#dll_BaushiNumber").html("<option value='0'>--छान्नुहोस--</option>");
    }



    function GetBaushiNumberByFiscalYearWise() {

        var OfficeTypeVal = $("#dll_OfficeType option:selected").val();
        var FiscalYearId = $("#dll_FYID option:selected").val();
        var SearchOfficeId = @Model.OfficeId;
        if (OfficeTypeVal == 0) {
            SearchOfficeId = 0;
        }

        if (OfficeTypeVal == 2) {
            SearchOfficeId = $("#dll_ministry option:selected").val();
        }
        if (OfficeTypeVal == 3) {
            SearchOfficeId = $("#dll_nirdesh option:selected").val();
            if (typeof SearchOfficeId == "undefined") {
                SearchOfficeId = $("#dll_office option:selected").val();
            }
        }
        if (OfficeTypeVal == 4) {
            SearchOfficeId = $("#dll_office option:selected").val();
        }
        if (OfficeTypeVal == 5) {
            SearchOfficeId = $("#dll_aayog option:selected").val();
        }
        if (OfficeTypeVal == 6) {
            SearchOfficeId = $("#dll_locallevel option:selected").val();
        }

        $.ajax({
            url: "@Url.Action("GetBasununberForReport", "AjaxRequest", new { @area="admin"})",
            data: { FyID: FiscalYearId, OfficeID: SearchOfficeId },
            dataType: "json",
            type: "POST",
            error: function () {

               // alert("An error occurred.");
            },
            success: function (data) {
                var items = "";
                $.each(data, function (i, item) {
                    items += "<option value=\"" + item.Value + "\">" + item.Text + "</option>";
                });

                $("#dll_BaushiNumber").html(items);
            }
        })

    };





</script>

<script type="text/javascript" src="https://ajax.googleapis.com/ajax/libs/jquery/1.8.3/jquery.min.js"></script>
<script src="~/AdminResources/js/table2excel.js"></script>
<script type="text/javascript">

    function PrintElem(elem) {
        var mywindow = window.open('', 'PRINT', 'height=400,width=600');

        mywindow.document.write('<html><head><title>' + ' ' + '</title>');
        mywindow.document.write('</head><body >');
        mywindow.document.write('<h1>' + ' ' + '</h1>');
        mywindow.document.write(document.getElementById(elem).innerHTML);
        mywindow.document.write('</body></html>');
        mywindow.document.close(); // necessary for IE >= 10
        mywindow.focus(); // necessary for IE >= 10*/

        mywindow.print();
        mywindow.close();

        return true;
    }
</script>





<script type="text/javascript">
    $("body").on("click", "#btnExportPDF", function () {
        $("#DetailsReportsID").css("width", "1500px");
        $("#DetailsReportsID").css("text-align", "left");
        $("#Headtitle").css("text-align", "left");
        $("#rptTitle").css("text-align", "left");
        $("th").css("text-align", "left");

        window.scrollTo(0, 0);

        html2canvas($('#DetailsReportsID')[0], {
            onrendered: function (canvas) {
                var data = canvas.toDataURL();
                var docDefinition = {
                    content: [{
                        image: data,
                        width: 500,
                        scale: 1
                    }]
                };
                pdfMake.createPdf(docDefinition).download("Report-details.pdf");
                $("#DetailsReportsID").css("width", "auto");

            }
        });
    });
</script>

<script>

    function GetBerujuSubTitleDD() {
        var value = $("#BerujuTypeIdDD option:selected").val();

        if (value != null) {
            $.ajax({
            url: "@Url.Action("GetBerujuSubTitleDD", "AjaxRequest", new { @area="admin"})",
            data: { id: value },
            dataType: "json",
            type: "POST",
            error: function () {
                alert("An error occurred.");
            },
            success: function (data) {
                var items = "";
                items += "<option value=0>" + "Select" + "</option>";

                $.each(data, function (i, item) {
                    items += "<option value=\"" + item.Value + "\">" + item.Text + "</option>";
                });

                $("#Berujusubtitleiddiv").html(items);
            }
        })
        }
    };


    function GetBerujuSubTitleChildDD() {
        var value = $("#Berujusubtitleiddiv option:selected").val();

     if (value != null) {
         $.ajax({
         url: "@Url.Action("GetBerujuSubTitleChildDD", "AjaxRequest", new { @area="admin"})",
         data: { id: value },
         dataType: "json",
         type: "POST",
         error: function () {
             alert("An error occurred.");
         },
         success: function (data) {
             var items = "";
             items += "<option value=0>" + "Select" + "</option>";
             $.each(data, function (i, item) {
                 items += "<option value=\"" + item.Value + "\">" + item.Text + "</option>";
             });

             $("#BerujuSubtitleChildiddiv").html(items);
         }
     })
     }
 };



</script>

<script>
    function LoadPage(page) {
        $("#PageNumber").val(page);

        $.ajax({
            url: $("#reportFilterForm").attr("action"),
            type: "POST",
            data: $("#reportFilterForm").serialize(),
            beforeSend: function () {
                $("#loader").show();
            },
            success: function (response) {
                $("#DetailsReportsID").html(response);
            },
            complete: function () {
                $("#loader").hide();
            },
            error: function () {
                alert("Error loading page.");
            }
        });
    }

    function ResetToFirstPage() {
        $("#PageNumber").val(1);
    }
</script>


<script>

    function setExportFilters() {

        $('#export_OfficeTypeSearchId').val($('#dll_OfficeType').val());
        $('#export_MininstrySearchId').val($('#dll_ministry').val());
        $('#export_BivagSearchId').val($('#dll_bivag').val());
        $('#export_NirdeshnalayaSearchId').val($('#dll_nirdesh').val());
        $('#export_KaryalayaSearchId').val($('#dll_office').val());

        $('#export_FiscalYearId').val($('#dll_FYID').val());
        $('#export_BerujuTypeId').val($('#BerujuTypeIdDD').val());
        $('#export_BerujuSubTitleId').val($('#Berujusubtitleiddiv').val());
        $('#export_BerujuSubTitleChildId').val($('#BerujuSubtitleChildiddiv').val());

        $('#export_PanNo').val($('#BerujuPan').val());
    }

</script>





