@model _4pix_Beruju.Models.ReportVIewModel

@{
    int i = ((Model.PageNumber - 1) * Model.PageSize) + 1;
}

<style>

    .html2canvas-container {
        width: 3000px !important;
        height: 3000px !important;
    }

    #double-scroll {
        width: 980px;
    }

    #sample2 {
        width: 100%;
    }

    p {
        margin: 0;
        padding: 0;
        font-size: 14px !important;
        color: black !important;
        /*line-height: 1.4em;*/
    }
</style>
<style>
    .logoImg {
    }

        .logoImg img {
            height: 80px;
            width: 80px;
            margin-left: 50px;
        }
</style>

@if (Model.ExternalBerujuRptByTypeViewModelList.Count > 0)
{



    <div class="table-responsive m_table" id="DetailsReportsID" style="margin-top:20px !important;">
        <div class="row myDivToPrint">
            <div class="col-md-4">
                <div class="logoImg">
                    <img src="~/AdminResources/img/nepalsarkarlogoprint.png" />
                    @*<img src="~/AdminResources/img/nepalsarkarlogo.png" style="height: 80px; width: 80px; margin-left: 50px;" />*@
                </div>
            </div>
            <div id="Headtitle" class="col-md-4" style="text-align:center;">
                @*<p>@_4pix_Beruju.Utilities.GetCurrentLoginOfficeHeadingTitle(Model.OfficeId)</p>*@

                @if (Model.OfficeTypeForReportHeader == 5)
                {
                    <p>
                        @_4pix_Beruju.Utilities.GetCurrentLoginOfficeMinistryName(Model.OfficeIdForReportHeader)

                    </p>


                }

                @if (Model.OfficeTypeForReportHeader == 4 || Model.OfficeTypeForReportHeader == 5)
                {
                    <p>
                        @_4pix_Beruju.Utilities.GetCurrentLoginOfficeMainOfficenName(Model.OfficeIdForReportHeader)

                    </p>


                }

                <p style="font-weight:bold;">@_4pix_Beruju.Utilities.GetCurrentLoginOfficeName(Model.OfficeIdForReportHeader)</p>
                <p style="font-weight:bold;">@_4pix_Beruju.Utilities.GetCurrentLoginOfficeAddress(Model.OfficeIdForReportHeader)</p>



            </div>
            @*<div class="col-md-4 text-right">
                        <p>म.ले.प.फारम नं: </p>
                </div>*@
        </div>
        <div class="row" style="margin-top:20px !important;margin-bottom:20px !important;">
            <div class="col-md-4"></div>
            <div id="rptTitle" class="col-md-4" style="text-align:center;margin-top:10px;margin-bottom:20px;">
                <p>
                    बेरुजु वृस्तित प्रतिवेदन@_4pix_Beruju.Areas.Admin.functions.GetBerujuTypeFromId(Model.BerujuTypeId)
                </p>

            </div>
            <div class="col-md-4"></div>
        </div>



        <div class="table-responsive">
            <table class="table table-bordered my-table table-responsive" id="exporttopdf" style="font-size:12px;">
                <thead>
                    <tr>
                        <th>क्रम</th>
                        <th>कार्यालय कोड</th>
                        <th>कार्यालयको नाम</th>
                        <th>आ.व.</th>
                        <th>बेरुजु दफा नं.</th>
                        <th>बेरुजु प्रकार</th>
                        <th>बेरुजु उप-प्रकार</th>
                        <th>बेरुजु उप-उपप्रकार</th>

                        <th>बेरुजु रकम</th>
                        <th>पान नं</th>
                        <th>फर्म/व्यक्तिको नाम</th>
                        <th>मर्ज भई आएको</th>
                        <th> हटाउने कार्य</th>

                    </tr>


                </thead>
                <tbody>

                    @foreach (var item in Model.ExternalBerujuRptByTypeViewModelList.OrderBy(x => x.FiscalYearTitle))
                    {


                        <tr>
                            <td style="width:10% !important;">@i</td>
                            <td style="width:10% !important;">@item.OfficeCode</td>
                            <td style="width:10% !important;">@item.OfficeName</td>
                            <td style="width:10% !important;">@item.FiscalYearTitle</td>

                            <td style="width:10% !important;">
                                <a href="@Url.Action("ViewExternalBerujuDetail","ReportLL", new { @id=item.ExternalBerujuId,@id1=item.OfficeId})" , class="btn btn-sm btn-success">
                                    @item.BerujuNumber &nbsp;<i class="fa fa-forward"></i>
                                </a>
                            </td>
                            <td style="width:10% !important;"> @item.TypeName</td>

                            <td style="width:10% !important;">@item.SubTitle</td>
                            <td style="width:10% !important;">@item.SubTitleChild</td>
                            <td style="width:10% !important;">@item.BerujuAmount</td>
                            <td style="width:10% !important;"> @item.PanNo</td>
                            <td style="width:10% !important;"> @item.FirmName</td>
                            <td style="width:10% !important;">@item.MergedFromOfficeCode</td>

                            <td>
                                @*@Html.ActionLink(
            "Delete",
            "DeleteBerujuAndSampa",
            "ExternalBerujuLL",
            new { id = item.ExternalBerujuId },
            new { @class = "btn btn-danger btn-sm" }
        )*@

                                <button type="button"
                                        class="btn btn-danger btn-sm btnDelete"
                                        data-id="@item.ExternalBerujuId">
                                    Delete
                                </button>
                            </td>
                        </tr>
                        i++;
                    }


                </tbody>
            </table>
        </div>


    </div>

    <div class="d-flex justify-content-between align-items-center mt-2">
        <div>
            Total Records: @Model.TotalRecords
        </div>

        <div>
            @if (Model.TotalPages > 1)
            {
                <div class="mt-3 text-center">

                    @if (Model.PageNumber > 1)
                    {
                        <button type="button" class="btn btn-sm btn-secondary" onclick="LoadPage(@(Model.PageNumber - 1))">
                            Previous
                        </button>
                    }

                    <span class="mx-2">
                        Page @Model.PageNumber of @Model.TotalPages
                    </span>

                    @if (Model.PageNumber < Model.TotalPages)
                    {
                        <button type="button" class="btn btn-sm btn-secondary" onclick="LoadPage(@(Model.PageNumber + 1))">
                            Next
                        </button>
                    }
                </div>
            }
        </div>
    </div>


}
else
{
    <div style="font-size:12px;font-weight:bold;margin-top:20px;text-align:center;">विवरण उपलब्ध हुन सकेन ।</div>



}



<script>
    $(document).ready(function () {

        $(".btnDelete").click(function () {

            if (!confirm("Are you sure you want to delete?")) {
                return;
            }

            var button = $(this);
            var id = button.data("id");

            $.ajax({
                url: '@Url.Action("DeleteBerujuAndSampa", "ExternalBerujuLL")',
                type: 'POST',
                data: { id: id },
                success: function (response) {

                    // remove row without page refresh
                    button.closest("tr").remove();

                    alert("Deleted Successfully");
                },
                error: function () {
                    alert("Delete Failed");
                }
            });

        });

    });
</script>
