@model _4pix_Beruju.Models.ReportVIewModel

@{
    ViewBag.Title = "BerujuLagatKhata";
    Layout = "~/Areas/LocalLevel/Views/Shared/_LocalLevelLayout.cshtml";
    int i = 1;
}

<div class="breadcrumb-holder">
    <div class="container-fluid">
        <ul class="breadcrumb">
            <li class="breadcrumb-item"><a href="#">Home</a></li>
            <li class="breadcrumb-item active">प्रतिवेदनहरू</li>
        </ul>
    </div>
</div>

<section>
    <div class="container-fluid">
        <!-- Page Header-->
        <header>
            <h1 class="h3 display">अन्तिम बेरूजु-प्रकार अनुसार</h1>
        </header>

        <div class="row">
            <div class="col-lg-12">
                <div class="card">
                    <div class="card-header">
                        <div class="col-sm-12">
                            <input type="button" id="btnExport" value="Export-Excel" class="btn btn-info btn-sm" />
                            @*@using (Html.BeginForm("ExportHTML", "ReportLL", FormMethod.Post))
                                {
                                    <input type="hidden" name="ExportData" />
                                    <input type="submit" id="btnSubmit" value="Export" />
                                }*@
                            <input type="button" id="btnExportPDF" value="Export-PDF" class="btn btn-info btn-sm" />
                            <input type="button" id="print" onclick="PrintElem('DetailsReportsID');" value="Print" class="btn btn-info btn-sm" />
                        </div>

                    </div>
                    <div class="card-body">

                        @using (Ajax.BeginForm("ExternalReportTypeWise", "ReportLL", new AjaxOptions
                        {
                            HttpMethod = "POST",
                            InsertionMode = InsertionMode.Replace,
                            UpdateTargetId = "DetailsReportsID",
                            LoadingElementId = "loader"
                        }))
                        {
                            <fieldset>

                                @if (Model.CurrentLoginUserTypeviewModel == 2 || Model.CurrentLoginUserTypeviewModel == 8 || Model.CurrentLoginUserTypeviewModel == 9 || Model.CurrentLoginUserTypeviewModel == 12)
                                {
                                    <div class="row">
                                        <div class="col-md-3 col-sm-6 form-group">
                                            <label>कार्यालय प्रकार</label>
                                            @Html.DropDownListFor(m => m.OfficeTypeSearchId, Utilities.GetOfficeTypeDDWithDefaultForSuperAdmin(), new { @class = "form-control form-control sm", @id = "dll_OfficeType" })
                                            @Html.ValidationMessageFor(m => m.OfficeTypeSearchId)
                                        </div>

                                        <div class="col-md-3 col-sm-6 form-group" id="Div_Ministry">
                                            <label>मन्त्रालय</label>
                                            @Html.DropDownListFor(m => m.MininstrySearchId, Utilities.GetMinistryListWithDefaultForProvinceAdmin(0, 2), new { @class = "form-control form-control sm", @id = "dll_ministry" })

                                        </div>
                                        <div class="col-md-3 col-sm-6 form-group" id="Div_Bivag">
                                            <label>विभाग</label>
                                            @Html.DropDownListFor(m => m.BivagSearchId, Utilities.GetNirdeshayalaDefault(), new { @class = "form-control form-control sm", @id = "dll_bivag" })

                                        </div>

                                        <div class="col-md-3 col-sm-6 form-group" id="Div_Nirdesha">
                                            <label>निर्देशनालय</label>
                                            @Html.DropDownListFor(m => m.NirdeshnalayaSearchId, Utilities.GetNirdeshayalaDefault(), new { @class = "form-control form-control sm", @id = "dll_nirdesh" })

                                        </div>


                                        <div class="col-md-3 col-sm-6 form-group" id="Div_Office">
                                            <label>कार्यालय/अन्य</label>
                                            @Html.DropDownListFor(model => model.KaryalayaSearchId, Utilities.GetNirdeshayalaDefault(), new { @class = "form-control form-control-sm", id = "dll_office" })

                                        </div>



                                    </div>
                                }




                            <div class="row">

                                <div class="col-md-3 col-sm-4 form-group">
                                    <label>आर्थिक वर्ष</label>
                                    @Html.DropDownListFor(model => model.FiscalYearId, _4pix_Beruju.Areas.Admin.functions.GetFiscalYearListWithDefaultDD(), new { @class = "form-control form-control-sm", id = "dll_FYID", onchange = "GetBaushiNumberByFiscalYearWise()" })

                                </div>



                                <div class="col-md-3 col-sm-4 form-group">
                                    <label>बेरुजु प्रकार</label>
                                    @Html.DropDownListFor(m => m.BerujuTypeId, _4pix_Beruju.Areas.Admin.functions.GetBerujuTypeDefaultDD(), new { @id = "BerujuTypeIdDD", @class = "form-control form-control-sm", @required = "required", @onChange = "GetBerujuSubTitleDD()" })

                                    @*@Html.DropDownListFor(model => model.BerujuTypeId, _4pix_Beruju.Areas.Admin.functions.GetBerujuTypeDD(), new { @class = "form-control form-control-sm", id = "dll_BerujuType", @onChange = "GetBerujuSubTitleDD()" })*@

                                </div>

                                <div class="col-md-4 col-sm-4 form-group">
                                    <label>बेरूजुको उपप्रकार</label>
                                    @*@Html.DropDownListFor(m => m.BerujuSubTitleId, _4pix_Beruju.Utilities.GetBerujuSubtitleDefaultDD(), new { @Id = "Berujusubtitleiddiv", Berujuubtitleiddiv BerujuSubtitleChildiddiv @class = "form-control form-control-sm", @required = "required" })*@

                                    @Html.DropDownListFor(m => m.BerujuSubTitleId, _4pix_Beruju.Utilities.GetBerujuSubtitleDD(Model.BerujuTypeId), new { @Id = "Berujusubtitleiddiv", @class = "form-control form-control-sm", @required = "required", @onChange = "GetBerujuSubTitleChildDD()" })

                                </div>

                                <div class="col-md-4 col-sm-4 form-group">
                                    <label>बेरूजुको उप उप प्रकार</label>
                                    @Html.DropDownListFor(m => m.BerujuSubTitleChildId, _4pix_Beruju.Utilities.GetBerujuSubtitleChildDD(Model.BerujuSubTitleId), new { @Id = "BerujuSubtitleChildiddiv", @class = "form-control form-control-sm"})
                                </div>


                            </div>
                                <button type="submit" class="btn btn-primary"><i class="fa fa-floppy-o">&nbsp;</i>खोज्नुहोस</button>
                            </fieldset>
                        }

                        <div id="loader" class=" aletr" style="display:none">
                            Loading...
                            <img src="~/AdminResources/img/ajax-loader.gif" />
                        </div>
                        <div id="DetailsReportsID"></div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>
<script src="~/Scripts/jquery-3.3.1.min.js"></script>

<script src="~/Scripts/dropdown_helper.js"></script>

<script>
    const url_bivag = '@Url.Action("GetBivagFromMinistryDD", "AjaxRequest", new { area = "admin" })';
    const url_nirdesh = '@Url.Action("GetNirdeshanalayaList", "AjaxRequest", new { area = "admin" })';
    const url_office = '@Url.Action("GetOfficesList", "AjaxRequest", new { area = "admin" })';
</script>



<script src="~/Scripts/jquery.unobtrusive-ajax.js"></script>

<script type="text/javascript">

    function ClearAllContent() {

        //$("#dll_FYID").html("<option value='0'>--Select--</option>");
        $("#dll_BaushiNumber").html("<option value='0'>--छान्नुहोस--</option>");
    }



    function GetBaushiNumberByFiscalYearWise() {

        var OfficeTypeVal = $("#dll_OfficeType option:selected").val();
        var FiscalYearId = $("#dll_FYID option:selected").val();
        var SearchOfficeId = @Model.OfficeId;
        if (OfficeTypeVal == 0) {
            SearchOfficeId = 0;
        }

        if (OfficeTypeVal == 2) {
            SearchOfficeId = $("#dll_ministry option:selected").val();
        }
        if (OfficeTypeVal == 3) {
            SearchOfficeId = $("#dll_nirdesh option:selected").val();
            if (typeof SearchOfficeId == "undefined") {
                SearchOfficeId = $("#dll_office option:selected").val();
            }
        }
        if (OfficeTypeVal == 4) {
            SearchOfficeId = $("#dll_office option:selected").val();
        }
        if (OfficeTypeVal == 5) {
            SearchOfficeId = $("#dll_aayog option:selected").val();
        }
        if (OfficeTypeVal == 6) {
            SearchOfficeId = $("#dll_locallevel option:selected").val();
        }

        $.ajax({
            url: "@Url.Action("GetBasununberForReport", "AjaxRequest", new { @area="admin"})",
            data: { FyID: FiscalYearId, OfficeID: SearchOfficeId },
            dataType: "json",
            type: "POST",
            error: function () {

               // alert("An error occurred.");
            },
            success: function (data) {
                var items = "";
                $.each(data, function (i, item) {
                    items += "<option value=\"" + item.Value + "\">" + item.Text + "</option>";
                });

                $("#dll_BaushiNumber").html(items);
            }
        })

    };





</script>

<script type="text/javascript" src="https://ajax.googleapis.com/ajax/libs/jquery/1.8.3/jquery.min.js"></script>
<script src="~/AdminResources/js/table2excel.js"></script>
<script type="text/javascript">

    function PrintElem(elem) {
        var mywindow = window.open('', 'PRINT', 'height=400,width=600');

        mywindow.document.write('<html><head><title>' + ' ' + '</title>');
        mywindow.document.write('</head><body >');
        mywindow.document.write('<h1>' + ' ' + '</h1>');
        mywindow.document.write(document.getElementById(elem).innerHTML);
        mywindow.document.write('</body></html>');
        mywindow.document.close(); // necessary for IE >= 10
        mywindow.focus(); // necessary for IE >= 10*/

        mywindow.print();
        mywindow.close();

        return true;
    }
</script>





<script type="text/javascript" src="https://ajax.googleapis.com/ajax/libs/jquery/1.8.3/jquery.min.js"></script>
