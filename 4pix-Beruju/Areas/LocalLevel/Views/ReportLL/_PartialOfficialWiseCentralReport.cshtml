@model _4pix_Beruju.Models.ReportVIewModel

@{
    int i = 1;

    decimal totalTypeOne = 0;
    decimal totalTypeTwo = 0;
    decimal totalTypeThree = 0;

    decimal totalStypeOne = 0;
    decimal totalStypeTwo = 0;
    decimal totalStypeThree = 0;

    decimal totalRtypeOne = 0;
    decimal totalRtypeTwo = 0;
    decimal totalRtypeThree = 0;
}

<style>
    p {
        margin: 0;
        padding: 0;
        font-size: 14px !important;
        color: black !important;
    }

    .logoImg img {
        height: 80px;
        width: 80px;
    }

    @@media print {
        #header, #footer, #nav {
            display: none !important;
        }
    }
</style>

<div class="table-responsive m_table" style="margin-top:20px;">

    <!-- ================= HEADER ================= -->
    <div class="row">
        <div class="col-md-4 logoImg">
            <img src="~/AdminResources/img/nepalsarkarlogoprint.png" />
        </div>

        <div class="col-md-4 text-center">

            <p>@_4pix_Beruju.Utilities.GetCurrentLoginOfficeHeadingTitle(Model.OfficeId)</p>

            @if (Model.OfficeTypeForReportHeader == 5)
            {
                <p>@_4pix_Beruju.Utilities.GetCurrentLoginOfficeMinistryName(Model.OfficeIdForReportHeader)</p>
            }

            @if (Model.OfficeTypeForReportHeader == 4 || Model.OfficeTypeForReportHeader == 5)
            {
                <p>@_4pix_Beruju.Utilities.GetCurrentLoginOfficeMainOfficenName(Model.OfficeIdForReportHeader)</p>
            }

            <p><b>@_4pix_Beruju.Utilities.GetCurrentLoginOfficeName(Model.OfficeIdForReportHeader)</b></p>
            <p><b>@_4pix_Beruju.Utilities.GetCurrentLoginOfficeAddress(Model.OfficeIdForReportHeader)</b></p>

        </div>
    </div>

    <div class="row mt-2">
        <div class="col-md-4">
            <p>कार्यालय सङ्केत नं: @_4pix_Beruju.Utilities.GetCurrentLoginOfficeCode(Model.OfficeIdForReportHeader)</p>
        </div>
    </div>

    <!-- ================= TABLE ================= -->
    <table class="table table-bordered my-table" id="exporttopdf">

        <thead>
            <tr>
                <th>क्रम</th>
                <th>कार्यलय</th>
                <th>आ.व.</th>

                <th colspan="3" style="text-align:center;">लगत</th>
                <th colspan="3" style="text-align:center;">फछ्यौट</th>
                <th colspan="3" style="text-align:center;">बाँकी</th>
            </tr>

            <tr>
                <th></th>
                <th></th>
                <th></th>

                <th>नियमित गर्नुपर्ने</th>
                <th>असुल उपर गर्नुपर्ने</th>
                <th>पेस्की</th>

                <th>नियमित गर्नुपर्ने</th>
                <th>असुल उपर गर्नुपर्ने</th>
                <th>पेस्की</th>

                <th>नियमित गर्नुपर्ने</th>
                <th>असुल उपर गर्नुपर्ने</th>
                <th>पेस्की</th>
            </tr>
        </thead>

        <tbody>

            @foreach (var item in Model.KendriyaKaralayagtLaagatViewModelList)
            {
                item.StypeOne = _4pix_Beruju.ReportUtilities.GetSamparikshadAmountBerujuTypeWise(Model.OfficeIdForReportHeader, 1, item.FiscalYearId);
                item.StypeTwo = _4pix_Beruju.ReportUtilities.GetSamparikshadAmountBerujuTypeWise(Model.OfficeIdForReportHeader, 2, item.FiscalYearId);
                item.StypeThree = _4pix_Beruju.ReportUtilities.GetSamparikshadAmountBerujuTypeWise(Model.OfficeIdForReportHeader, 3, item.FiscalYearId);

                item.TypeOne = item.TypeOne ?? 0;
                item.TypeTwo = item.TypeTwo ?? 0;
                item.TypeThree = item.TypeThree ?? 0;

                item.RtypeOne = item.TypeOne - item.StypeOne;
                item.RtypeTwo = item.TypeTwo - item.StypeTwo;
                item.RtypeThree = item.TypeThree - item.StypeThree;
                
                
                
                totalTypeOne += item.TypeOne ?? 0;
                totalTypeTwo += item.TypeTwo ?? 0;
                totalTypeThree += item.TypeThree ?? 0;

                totalStypeOne += item.StypeOne ?? 0;
                totalStypeTwo += item.StypeTwo ?? 0;
                totalStypeThree += item.StypeThree ?? 0;

                totalRtypeOne += item.RtypeOne ?? 0;
                totalRtypeTwo += item.RtypeTwo ?? 0;
                totalRtypeThree += item.RtypeThree ?? 0;

                <tr>
                    <td>@i</td>
                    <td>@_4pix_Beruju.Utilities.GetCurrentLoginOfficeName(Model.OfficeIdForReportHeader)</td>
                    <td>@item.FiscalYearTitle</td>

                    <td>@item.TypeOne</td>
                    <td>@item.TypeTwo</td>
                    <td>@item.TypeThree</td>

                    <td>@item.StypeOne</td>
                    <td>@item.StypeTwo</td>
                    <td>@item.StypeThree</td>

                    <td>@item.RtypeOne</td>
                    <td>@item.RtypeTwo</td>
                    <td>@item.RtypeThree</td>
                </tr>

                i++;
            }

            <!-- ================= TOTAL ROW ================= -->
            <tr style="font-weight:bold;background:#f2f2f2;">
                <td colspan="3" style="text-align:right;">जम्मा</td>

                <td>@totalTypeOne</td>
                <td>@totalTypeTwo</td>
                <td>@totalTypeThree</td>

                <td>@totalStypeOne</td>
                <td>@totalStypeTwo</td>
                <td>@totalStypeThree</td>

                <td>@totalRtypeOne</td>
                <td>@totalRtypeTwo</td>
                <td>@totalRtypeThree</td>
            </tr>

        </tbody>

    </table>
</div>