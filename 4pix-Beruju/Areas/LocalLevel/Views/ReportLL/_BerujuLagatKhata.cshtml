@model _4pix_Beruju.Models.ReportVIewModel

@{
    int i = 1;
    decimal? TotalSumBeruju = 0;
    decimal? KayamBerujuTotal = 0;
}


<style>

    .html2canvas-container {
        width: 3000px !important;
        height: 3000px !important;
    }

    #double-scroll {
        width: 980px;
    }

    #sample2 {
        width: 100%;
    }

    p {
        margin: 0;
        padding: 0;
        font-size: 14px !important;
        color:black !important;
        /*line-height: 1.4em;*/
    }
</style>
<style>
    .logoImg {
    }

        .logoImg img {
            height: 80px;
            width: 80px;
            margin-left: 50px;
        }
</style>

@if (Model.BerujuLagatKhataVMList.Count > 0)
{



    <div class="table-responsive m_table" id="DetailsReportsID" style="margin-top:30px !important;">
        <div class="row myDivToPrint">
            <div class="col-md-4">
                <div class="logoImg">
                    <img src="~/AdminResources/img/nepalsarkarlogoprint.png" />
                    @*<img src="~/AdminResources/img/nepalsarkarlogo.png" style="height: 80px; width: 80px; margin-left: 50px;" />*@
                </div>
            </div>
            <div id="Headtitle" class="col-md-4" style="text-align:center;">
                <p>@_4pix_Beruju.Utilities.GetCurrentLoginOfficeHeadingTitle(Model.OfficeId)</p>

                @if (Model.OfficeTypeForReportHeader == 5)
                {
                    <p>
                        @_4pix_Beruju.Utilities.GetCurrentLoginOfficeMinistryName(Model.OfficeIdForReportHeader)

                    </p>


                }

                @if (Model.OfficeTypeForReportHeader == 4 || Model.OfficeTypeForReportHeader == 5)
                {
                    <p>
                        @_4pix_Beruju.Utilities.GetCurrentLoginOfficeMainOfficenName(Model.OfficeIdForReportHeader)

                    </p>


                }

                <p style="font-weight:bold;">@_4pix_Beruju.Utilities.GetCurrentLoginOfficeName(Model.OfficeIdForReportHeader)</p>
                <p style="font-weight:bold;">@_4pix_Beruju.Utilities.GetCurrentLoginOfficeAddress(Model.OfficeIdForReportHeader)</p>



            </div>
            <div class="col-md-4" style="text-align:right;">
                <p>म.ले.प.फारम नं: ८०१</p>
            </div>
        </div>
        <div class="row">
            <div class="col-md-4"></div>
            <div id="rptTitle" class="col-md-4" style="text-align:center; margin-top:10px;margin-bottom:10px;">
                <p>
                    अन्तिम लेखापरीक्षणबाट कायम बेरुजुको लगत खाता
                </p>
                @*<p>@_4pix_Beruju.Utilities.GetNepaliDateFromEng(DateTime.Today)</p>*@
            </div>
            <div class="col-md-4"></div>
        </div>

        <div class="row">
            <div class="col-md-12" style="font-size:13px;">
                
                    बजेट उपशीर्षक / कारोबार नं <span>&nbsp;@_4pix_Beruju.Areas.Admin.functions.GetBudgetSubTitleById(Model.BaushiNumberId)</span>
                

            </div>
            <div class="col-md-3" style="font-size:13px;">

                @_4pix_Beruju.Areas.Admin.functions.GetKoshTypeFromId(Model.KoshID)

            </div>
        </div>

        <div>
            <table class="table table-bordered my-table" id="exporttopdf" style="font-size:12px;">
                <thead>
                    <tr>
                        <th>क्रम</th>
                        <th>आ.व.</th>
                        <th>बेरूजु दफा नं.</th>
                        <th>भाैचर नं.</th>
                        <th>बेरुजुको सङ्क्षिप्त व्यहोरा</th>
                        <th>बेरूजुको उपबर्गीकरण</th>
                        <th colspan="4" style="text-align:center;">कायम भएको बेरुजु रकम</th>
                        <th colspan="5" style="text-align:center;">सम्परीक्षण भएको</th>
                        <th colspan="4" style="text-align:center;">बाँकी बेरुजु</th>

                    </tr>
                    <tr>
                        <th></th>
                        <th></th>
                        <th></th>
                        <th></th>
                        <th></th>
                        <th></th>
                        <th>नियमित गर्नुपर्ने</th>
                        <th>असुल उपर गर्नुपर्ने</th>
                        <th>पेस्की</th>
                        <th>जम्मा</th>
                        <th>सं.प. मिति</th>
                        <th>नियमित गर्नुपर्ने</th>
                        <th>असुल उपर गर्नुपर्ने</th>
                        <th>पेस्की</th>
                        <th>जम्मा</th>
                        <th>नियमित गर्नुपर्ने</th>
                        <th>असुल उपर गर्नुपर्ने</th>
                        <th>पेस्की</th>
                        <th>जम्मा</th>

                    </tr>

                </thead>
                <tbody>

                    @foreach (var item in Model.BerujuLagatKhataVMList)
                    {

                        <tr>
                            <td>@i</td>
                            <td>@item.FiscalYearTitle</td>
                            <td>@item.BerujuNumber</td>
                            <td>@item.VoucherNumber</td>
                            <td>@item.BerujuDetails</td>
                            <td>@item.BerujuSubTitle</td>
                            @if (item.TypeOne.HasValue)
                            {
                                <td>@item.TypeOne</td>
                                TotalSumBeruju += item.TypeOne;
                                KayamBerujuTotal = item.TypeOne;

                            }
                            else
                            {
                                <td>0</td>

                            }
                            @if (item.TypeTwo.HasValue)
                            {
                                <td>@item.TypeTwo</td>
                                TotalSumBeruju += item.TypeTwo;
                                KayamBerujuTotal = item.TypeTwo;

                            }
                            else
                            {
                                <td>0</td>

                            }
                            @if (item.TypeThree.HasValue)
                            {
                                <td>@item.TypeThree</td>
                                TotalSumBeruju += item.TypeThree;
                                KayamBerujuTotal = item.TypeThree;

                            }
                            else
                            {
                                <td>0</td>

                            }
                            
                            <td>@KayamBerujuTotal</td>

                            @{
                                string NepaliRevisedDate = "";
                                if (item.RevisedDate.HasValue)
                                {
                                    NepaliRevisedDate = _4pix_Beruju.Utilities.GetNepaliDateFromEng(item.RevisedDate);
                                }
                            }

                            <td>@NepaliRevisedDate</td>

                            <td>@_4pix_Beruju.Areas.Admin.functions.GetSamparikshadAmountTypeWise(item.ExternalBerujuId, 1, item.SamparishadId)</td>
                            <td>@_4pix_Beruju.Areas.Admin.functions.GetSamparikshadAmountTypeWise(item.ExternalBerujuId, 2, item.SamparishadId)</td>
                            <td>@_4pix_Beruju.Areas.Admin.functions.GetSamparikshadAmountTypeWise(item.ExternalBerujuId, 3, item.SamparishadId)</td>
                            <td>@_4pix_Beruju.Areas.Admin.functions.GetSamparikshadSumAmount(item.ExternalBerujuId, item.SamparishadId)</td>

                            <td>@_4pix_Beruju.Areas.Admin.functions.GetBakiBerujuAmount(item.ExternalBerujuId, item.SamparishadId, 1)</td>
                            <td>@_4pix_Beruju.Areas.Admin.functions.GetBakiBerujuAmount(item.ExternalBerujuId, item.SamparishadId, 2)</td>
                            <td>@_4pix_Beruju.Areas.Admin.functions.GetBakiBerujuAmount(item.ExternalBerujuId, item.SamparishadId, 3)</td>
                            <td>@_4pix_Beruju.Areas.Admin.functions.GetBakiBerujuAmount(item.ExternalBerujuId, item.SamparishadId, 0)</td>


                        </tr>
                        i++;
                    }


                </tbody>
            </table>
        </div>

        

    </div>
}
else
{
    <div style="font-size:12px;font-weight:bold;margin-top:20px;text-align:center;">विवरण उपलब्ध हुन सकेन ।</div>
}

