@model _4pix_Beruju.Models.ReportVIewModel

@{
    int i = ((Model.PageNumber - 1) * Model.PageSize) + 1;
    string currentOffice = null;
}

<style>
    .html2canvas-container {
        width: 3000px !important;
        height: 3000px !important;
    }

    #double-scroll {
        width: 980px;
    }

    #sample2 {
        width: 100%;
    }

    p {
        margin: 0;
        padding: 0;
        font-size: 14px !important;
        color: black !important;
    }

    .logoImg img {
        height: 80px;
        width: 80px;
        margin-left: 50px;
    }
</style>

@if (Model.ExternalBerujuRptByTypeViewModelList != null && Model.ExternalBerujuRptByTypeViewModelList.Count > 0)
{
    <div class="table-responsive m_table" id="DetailsReportsID" style="margin-top:20px !important;">

        <!-- ================= HEADER ================= -->
        <div class="row myDivToPrint">
            <div class="col-md-4">
                <div class="logoImg">
                    <img src="~/AdminResources/img/nepalsarkarlogoprint.png" />
                </div>
            </div>

            <div class="col-md-4" style="text-align:center;">
                @if (Model.OfficeTypeForReportHeader == 5)
                {
                    <p>@_4pix_Beruju.Utilities.GetCurrentLoginOfficeMinistryName(Model.OfficeIdForReportHeader)</p>
                }

                @if (Model.OfficeTypeForReportHeader == 4 || Model.OfficeTypeForReportHeader == 5)
                {
                    <p>@_4pix_Beruju.Utilities.GetCurrentLoginOfficeMainOfficenName(Model.OfficeIdForReportHeader)</p>
                }

                <p style="font-weight:bold;">
                    @_4pix_Beruju.Utilities.GetCurrentLoginOfficeName(Model.OfficeIdForReportHeader)
                </p>

                <p style="font-weight:bold;">
                    @_4pix_Beruju.Utilities.GetCurrentLoginOfficeAddress(Model.OfficeIdForReportHeader)
                </p>
            </div>
        </div>

        <!-- ================= TITLE ================= -->
        <div class="row" style="margin:20px 0;">
            <div class="col-md-12 text-center">
                <p>
                    अन्तिम बेरुजु संक्षिप्त प्रतिवेदन -
                    @_4pix_Beruju.Areas.Admin.functions.GetBerujuTypeFromId(Model.BerujuTypeId)
                </p>
            </div>
        </div>

        <!-- ================= TABLE ================= -->
        <div class="table-responsive">
            <table class="table table-bordered my-table" id="exporttopdf" style="font-size:12px;">

                <thead>
                    <tr>
                        <th>क्रम</th>
                        <th>कार्यालय कोड</th>
                        <th>कार्यालयको नाम</th>
                        <th>आ.व.</th>
                        <th>बेरुजु दफा नं.</th>
                        <th>बेरुजु प्रकार</th>
                        <th>बेरुजु उप-प्रकार</th>
                        <th>बेरुजु उप-उपप्रकार</th>
                        <th>बेरुजु रकम</th>
                        <th>पान नं</th>
                        <th>फर्म/व्यक्तिको नाम</th>
                        <th>मर्ज भई आएको</th>
                    </tr>
                </thead>

                <tbody>

                    @foreach (var item in Model.ExternalBerujuRptByTypeViewModelList
                        .OrderBy(x => x.OfficeCode)
                        .ThenBy(x => x.FiscalYearTitle))
                    {
                        // ================= OFFICE TOTAL ROW =================
                        if (currentOffice != item.OfficeCode && item.OfficeTotal != null)
                        {
                            currentOffice = item.OfficeCode;

                            <tr style="background:#f2f2f2;font-weight:bold;">
                                <td colspan="8" style="text-align:right;">
                                    कार्यालय कुल (@item.OfficeName)
                                </td>
                                <td>
                                    @item.OfficeTotal
                                </td>
                                <td colspan="3"></td>
                            </tr>
                        }

                        // ================= DETAIL ROW =================
                        <tr>
                            <td>@i</td>
                            <td>@item.OfficeCode</td>
                            <td>@item.OfficeName</td>
                            <td>@item.FiscalYearTitle</td>

                            <td>
                                <a href="@Url.Action("ViewExternalBerujuDetail","ReportLL",
                                        new { id = item.ExternalBerujuId, id1 = item.OfficeId })"
                                   class="btn btn-sm btn-success">
                                    @item.BerujuNumber <i class="fa fa-forward"></i>
                                </a>
                            </td>

                            <td>@item.TypeName</td>
                            <td>@item.SubTitle</td>
                            <td>@item.SubTitleChild</td>
                            <td>@item.BerujuAmount</td>
                            <td>@item.PanNo</td>
                            <td>@item.FirmName</td>
                            <td>@item.MergedFromOfficeCode</td>
                        </tr>

                        i++;
                    }

                </tbody>

            </table>
        </div>

        <!-- ================= PAGINATION ================= -->
        <div class="d-flex justify-content-between align-items-center mt-2">

            <div>
                Total Records: @Model.TotalRecords
            </div>

            <div>

                @if (Model.TotalPages > 1)
                {
                    if (Model.PageNumber > 1)
                    {
                        <button type="button" class="btn btn-sm btn-secondary"
                                onclick="LoadPage(@(Model.PageNumber - 1))">
                            Previous
                        </button>
                    }

                    <span class="mx-2">
                        Page @Model.PageNumber of @Model.TotalPages
                    </span>

                    if (Model.PageNumber < Model.TotalPages)
                    {
                        <button type="button" class="btn btn-sm btn-secondary"
                                onclick="LoadPage(@(Model.PageNumber + 1))">
                            Next
                        </button>
                    }
                }

            </div>

        </div>

    </div>
}
else
{
    <div style="text-align:center;font-weight:bold;margin-top:20px;">
        विवरण उपलब्ध हुन सकेन ।
    </div>
}