@model _4pix_Beruju.Models.ExternalBeruju

@{
    ViewBag.Title = "SamparikshadForm";
    Layout = "~/Areas/LocalLevel/Views/Shared/_LocalLevelLayout.cshtml";
    int i = 1;
    decimal? remainingAmount = 0m;
}

<div class="breadcrumb-holder">
    <div class="container-fluid">
        <ul class="breadcrumb">
            <li class="breadcrumb-item"><a href="index.html">Home</a></li>
            <li class="breadcrumb-item active">सम्परीक्षण कार्य लगत कट्टा</li>
        </ul>
    </div>
</div>

<section>
    <div class="container-fluid">
        <!-- Page Header-->
        <header>
            <h1 class="h3 display">सम्परीक्षण कार्य लगत कट्टा</h1>
        </header>

        <div class="row">
            <div class="col-lg-12">
                <div class="card">
                    <div class="card-header">

                        <h4><input type="button" id="btnExport" value="Export" /></h4>

                    </div>
                    <div class="card-body">

                        @using (Ajax.BeginForm("ListActionFromRequeestBeruju", "ExternalBerujuLL", new AjaxOptions
                        {
                            HttpMethod = "POST",
                            InsertionMode = InsertionMode.Replace,
                            UpdateTargetId = "DetailsReportsID",
                            LoadingElementId = "loader"
                        }))
                        {
                            <fieldset>
                                <div class="row">

                                    @*<div class="col-md-3 col-sm-6 form-group">
            <label>आन्तरिक/अन्तिम</label>
            @Html.DropDownListFor(m => m.InternalOrExternalTypeId, _4pix_Beruju.Areas.Admin.functions.ExternalOrInternalDDText(), new { @class = "form-control form-control sm", @id = "InternalOrExteralId" })

        </div>*@

                                    <div class="col-md-3 col-sm-6 form-group">
                                        <label>आर्थिक वर्ष (*)</label>
                                        @Html.DropDownListFor(m => m.FiscalYearId, _4pix_Beruju.Areas.Admin.functions.GetFiscalYearListWithDefaultDD(), new { @class = "form-control form-control sm", @id = "DDFYID" })

                                    </div>

                                    <div class="col-md-3 col-sm-6 form-group">
                                        <label>कोष (*)</label>
                                        @Html.DropDownListFor(m => m.KoshTypeId, _4pix_Beruju.Areas.Admin.functions.GetKoshTypeWithoutDefault(), new { @class = "form-control form-control sm", @id = "dll_fyId" })
                                    </div>

                                    @*<div class="col-md-3 col-sm-6 form-group">
            <label>बेरुजु प्रकार (*)</label>
            @Html.DropDownListFor(m => m.KoshTypeId, _4pix_Beruju.Areas.Admin.functions.GetKoshTypeWithSaidantikDD(), new { @class = "form-control form-control sm", @id = "dll_fyId" })
        </div>*@

                                    <div class="col-md-3 col-sm-6 form-group">
                                        <label>बेरुजु दफा न</label>
                                        @Html.TextBoxFor(m => m.BerujuNumber, new { @class = "form-control form-control sm", @id = "dll_berujunumber" })
                                    </div>

                                    <div class="col-md-3 col-sm-6 form-group">
                                   
                                        <button type="submit" class="btn btn-primary mt-4"><i class="fa fa-floppy-o">&nbsp;</i>खोज्नुहोस</button>

                                    </div>



                                </div>
                            </fieldset>
                        }
                        <div id="loader" class=" aletr" style="display:none">
                            Loading...
                            <img src="~/AdminResources/img/ajax-loader.gif" />

                        </div>

                        <div id="DetailsReportsID">

                            <div class="table-responsive table-sm shadow p-3 mb-5 bg-white rounded">
                                <table class="table table-hover table-sm table-bordered">
                                    <thead>
                                        <tr>
                                            <th>क्रम</th>
                                            <th>आर्थिक वर्ष</th>
                                            <th>वजेट उपशिर्षक</th>
                                            <th>बेरूजु दफा नं</th>
                                            <th>गो.भैा.न.</th>
                                            <th>खर्च शिर्षक</th>
                                            <th>बेरूजु रकम</th>
                                          
                                            <th>फर्छयौट रकम</th>
                                            <th>सम्परीक्षण रकम</th>
                                            <th>बाँकी रकम</th>
                                            <th>पूर्ण विवरण</th>
                                            <th> फर्छ्यौट अनुरोध सच्च्याउनुहोस</th>
                                            <th>सम्परीक्षण</th>
                                        </tr>
                                    </thead>
                                    <tbody>

                                        @foreach (var item in Model.ListBerujuForSamparikshadActionVMList)
                                        {

                                            decimal? RequestAmount = Utilities.GetTotalRequestedAmountForRequest(item.ExternalBerujuId, item.FiscalYearId);

                                            decimal? samAmount = Utilities.GetTotalRevisedAmountForRequest(item.ExternalBerujuId);
                                            remainingAmount = item.VoucharAmunt - samAmount;

                                            <tr>
                                                <td scope="row">@i</td>
                                                <td>@item.FiscalYearTitleEng</td>

                                                <td>@item.BudgetHead</td>
                                                <td>@item.BerujuNumber</td>
                                                <td>@item.JVNUMBER</td>
                                                <td>@item.ChaluOrPujigat</td>
                                                <td>@item.VoucharAmunt</td>
                                                <td>@RequestAmount</td>
                                                <td>@samAmount</td>
                                                <td>@remainingAmount</td>
                                                <td>
                                                    <a href="~/LocalLevel/ExternalBerujuLL/ViewDetails?id=@item.ExternalBerujuId" id="deleteBtn" class="edits" target="_blank"><i class="edits fa fa-eye"></i></a>
                                                </td>

                                                <td>
                                                    @Html.ActionLink(" ", "EditSamparikshadRequestForm", new { @id = item.ExternalBerujuId, @id1 = item.SamparikshadReqMasterId }, new { @class = "edits fa fa-edit", target = "_blank", rel = "noopener noreferrer" })
                                                </td>

                                                <td>
                                                    <a href="~/LocalLevel/ExternalBerujuLL/MakeSamparikshadFromRequest?id=@item.ExternalBerujuId&id1=@item.SamparikshadReqMasterId" id="deleteBtn" class="edits" onclick="return confirm('के तपाँई को विवरण लाई सम्परिक्षण गर्न चाहानुहुन्छ ?');"><i class="edits fa fa-list-ol"></i></a>

                                                </td>

                                            </tr>
                                            ++i;
                                        }


                                    </tbody>
                                </table>
                            </div>


                        </div>


                    </div>
                </div>
            </div>
        </div>







    </div>
</section>

<script src="~/Scripts/jquery-3.3.1.min.js"></script>

@*<script src="~/Scripts/jquery-1.10.2.js"></script>*@
<script src="~/Scripts/jquery.unobtrusive-ajax.js"></script>
<script>
    function GetBudgetSubTitleByFYID() {

        var FYIDVal = $("#DDFYID option:selected").val();
        if (FYIDVal != null) {


            $.ajax({
                url: "@Url.Action("GetBudgetSubtitleFromOfficeIdFYID", "AjaxRequest", new { @area="admin"})",
                data: { id: FYIDVal },
                dataType: "json",
                type: "POST",
                error: function () {
                    alert("An error occurred.");
                },
                success: function (data) {
                    var items = "";
                    $.each(data, function (i, item) {
                        items += "<option value=\"" + item.Value + "\">" + item.Text + "</option>";
                    });

                    $("#BSTID").html(items);
                }
            })
        }

    };
</script>

<script src="~/Scripts/SweetAlert.min.js"></script>
<script type="text/javascript">
    var kk = $.noConflict();
    kk(function () {
         var a = '@TempData["Success"]';
         var b = '@TempData["Error"]';
        if (a != '') {
            sweetAlert(a, "success", "success");
        }
        else if (b != '')
        {
            sweetAlert(b, "Error", "error");
        }
        else {

        }


    });


</script>




