@model _4pix_Beruju.Models.ExternalBeruju

@{
    ViewBag.Title = "GetSamparikshadList";
    Layout = "~/Areas/LocalLevel/Views/Shared/_LocalLevelLayout.cshtml";
    int i = 1;
}
<div class="breadcrumb-holder">
    <div class="container-fluid">
        <ul class="breadcrumb">
            <li class="breadcrumb-item"><a href="index.html">Home</a></li>
            <li class="breadcrumb-item active">सम्परीक्षण फारामहरू</li>
        </ul>
    </div>
</div>

<section>
    <div class="container-fluid">
        <!-- Page Header-->
        <header>
            सम्परीक्षण फारामहरू
        </header>

        <div class="row">
            <div class="col-lg-12">
                <div class="card">
                    <div class="card-header">
                        <div class="col-sm-12">
                            <input type="button" id="btnExport" value="Export-Excel" class="btn btn-info btn-sm" />
                            <input type="button" id="btnExportPDF" value="Export-PDF" class="btn btn-info btn-sm" />
                            <input type="button" id="print" onclick="PrintElem('DetailsReportsID');" value="Print" class="btn btn-info btn-sm" />
                        </div>

                    </div>
                    <div class="card-body">


                        @using (Ajax.BeginForm("GetSamparikshadForList", "ExternalBerujuLL", new AjaxOptions
                        {
                            HttpMethod = "POST",
                            InsertionMode = InsertionMode.Replace,
                            UpdateTargetId = "DetailsReportsID",
                            LoadingElementId = "loader"
                        }))
                        {
                            <fieldset>
                                <div class="row">

                                    <div class="col-md-3 col-sm-6 form-group">
                                        <label>आर्थिक वर्ष (*)</label>
                                        @Html.DropDownListFor(m => m.FiscalYearId, _4pix_Beruju.Areas.Admin.functions.GetFiscalYearListWithDefaultDDAll(), new { @class = "form-control form-control sm", @id = "dll_fyId" })

                                    </div>

                                    <div class="col-md-3 col-sm-6 form-group">
                                        <label>बेरुजु प्रकार (*)</label>
                                        @Html.DropDownListFor(m => m.KoshTypeId, _4pix_Beruju.Areas.Admin.functions.GetKoshTypeWithoutDefault(), new { @class = "form-control form-control sm", @id = "dll_fyId" })
                                    </div>

                                    <div class="col-md-3 col-sm-6 form-group">
                                        <label>बेरुजु दफा न</label>
                                        @Html.TextBoxFor(m => m.BerujuNumber, new { @class = "form-control form-control sm", @id = "dll_berujunumber" })
                                    </div>

                                </div>

                                <button type="submit" class="btn btn-primary"><i class="fa fa-floppy-o">&nbsp;</i>खोज्नुहोस</button>
                            </fieldset>
                        }
                        <div id="loader" class=" aletr" style="display:none">
                            Loading...
                            <img src="~/AdminResources/img/ajax-loader.gif" />

                        </div>

                        <div id="DetailsReportsID">



                            <div class="table-responsive table-sm shadow p-3 mb-5 bg-white rounded">
                                <table class="table table-hover table-sm table-bordered">
                                    <thead>
                                        <tr>
                                            <th>क्रम</th>
                                            <th>आर्थिक वर्ष</th>
                                            <th>बेरुजु दफा न</th>
                                            <th>बेरूजु रकम</th>
                                            <th>सम्परीक्षण रकम</th>
                                            <th>पूर्ण विवरण</th>
                                            <th>सच्चाउनुहोस</th>
                                            @*<th>हटाउनुहोस</th>*@

                                        </tr>
                                    </thead>
                                    <tbody>

                                        @foreach (var item in Model.SamparikhadListViewModelList.OrderByDescending(x => x.SamparishadId).Take(5))
                                        {

                                        <tr>
                                            <td scope="row">@i</td>
                                            <td>@_4pix_Beruju.Areas.Admin.functions.GetFiscalyearTitleFromId(item.FiscalYearId)</td>


                                            <td style="width:10% !important;">
                                                <a href="@Url.Action("ViewDetailsNB","ExternalBerujuLL", new { @id=item.ExternalBerujuId})" , class="btn btn-sm btn-success" target="_blank">
                                                    @item.BerujuNumber &nbsp;<i class="fa fa-forward"></i>
                                                </a>
                                            </td>
                                            <td>@item.BerujuAmount</td>
                                            <td>@item.ReviesedVoucherAmount</td>
                                            @*<td>@item.JVNUMBER</td>*@


                                            <td>
                                                @Html.ActionLink(" ", "ViewDetailSamparikshadForm", new { @id = item.SamparishadId, @id1 = item.ExternalBerujuId }, new { @class = "edits fa fa-eye" })
                                            </td>
                                            <td>
                                                @Html.ActionLink(" ", "EditSamparikshadForm", new { @id = item.SamparishadId, @id1 = item.ExternalBerujuId }, new { @class = "edits fa fa-edit" })
                                            </td>
                                            @*<td>
                                                @Html.ActionLink(" ", "DeleteSamparikshad", new { @id = item.SamparishadId }, new { @class = "edits fa fa-trash" })
                                            </td>*@





                                        </tr>
                                            ++i;
                                        }


                                    </tbody>
                                </table>
                            </div>

                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>
@*<link href="~/Content/SweetAlert.css" rel="stylesheet" />*@
<link href="~/Content/sweetalert/sweet-alert.css" rel="stylesheet" />
<script src="~/Scripts/jquery-3.3.1.min.js"></script>
<script src="~/Scripts/SweetAlert.min.js"></script>


<script type="text/javascript">
     $(function () {
        var a = '@TempData["Success"]';
        if (a != '') {
            sweetAlert(a, "success", "success");
        }
        else {

        }


    });


</script>

<script src="~/Scripts/jquery-3.3.1.min.js"></script>

@*<script src="~/Scripts/jquery-1.10.2.js"></script>*@
<script src="~/Scripts/jquery.unobtrusive-ajax.js"></script>

<script type="text/javascript" src="https://ajax.googleapis.com/ajax/libs/jquery/1.8.3/jquery.min.js"></script>
<script src="~/AdminResources/js/table2excel.js"></script>
<script type="text/javascript">
    var tte = $.noConflict();
    tte(function () {
        tte("#btnExport").click(function () {
            tte("#DetailsReportsID").table2excel({
                filename: "ListSamparikshad.xls"
            });
        });
    });

    function PrintElem(elem) {
        var mywindow = window.open('', 'PRINT', 'height=400,width=600');

        mywindow.document.write('<html><head><title>' + ' ' + '</title>');
        mywindow.document.write('</head><body >');
        mywindow.document.write('<h1>' + ' ' + '</h1>');
        mywindow.document.write(document.getElementById(elem).innerHTML);
        mywindow.document.write('</body></html>');
        mywindow.document.close(); // necessary for IE >= 10
        mywindow.focus(); // necessary for IE >= 10*/

        mywindow.print();
        mywindow.close();

        return true;
    }
</script>

<script type="text/javascript" src="https://ajax.googleapis.com/ajax/libs/jquery/1.8.3/jquery.min.js"></script>
<script type="text/javascript" src="https://cdnjs.cloudflare.com/ajax/libs/pdfmake/0.1.22/pdfmake.min.js"></script>
<script type="text/javascript" src="https://cdnjs.cloudflare.com/ajax/libs/html2canvas/0.4.1/html2canvas.min.js"></script>



<script type="text/javascript">
    $("body").on("click", "#btnExportPDF", function () {
        html2canvas($('#exporttopdf')[0], {
            onrendered: function (canvas) {
                var data = canvas.toDataURL();
                var docDefinition = {
                    content: [{
                        image: data,
                        width: 500
                    }]
                };
                pdfMake.createPdf(docDefinition).download("Report-details.pdf");
            }
        });
    });
</script>
