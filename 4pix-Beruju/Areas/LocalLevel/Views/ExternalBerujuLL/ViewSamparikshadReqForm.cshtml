@model _4pix_Beruju.Models.ExternalBeruju

@{
    ViewBag.Title = "ViewSamparikshadReqForm";
    Layout = "~/Areas/LocalLevel/Views/Shared/_LocalLevelLayout.cshtml";
}
<link href="~/Content/sweetalert/sweet-alert.css" rel="stylesheet" />

<style>
    .logoImg {
    }

        .logoImg img {
            height: 80px;
            width: 80px;
            margin-left: 50px;
        }
</style>

<div class="breadcrumb-holder">
    <div class="container-fluid">
        <ul class="breadcrumb">
            <li class="breadcrumb-item"><a href="index.html">Home</a></li>
            <li class="breadcrumb-item active">सम्परीक्षण अनुरोध फाराम</li>
        </ul>
    </div>
</div>
<section class="forms">
    <div class="container-fluid">
        <!-- Page Header-->
        <div class="row">
            <div class="col-lg-4"></div>

        </div>
        <div class="row">
            <div class="col-lg-12">
                <div class="card-header">

                    <div class="col-sm-12">
                        @*<input type="button" id="btnExport" value="Export-Excel" class="btn btn-info btn-sm" />*@
                        <input type="button" id="btnExportPDF" value="Export-PDF" class="btn btn-info btn-sm" />
                    </div>

                </div>


                <div class="card" id="exporttopdf">
                    <div class="row">

                        <div class="col-md-4">
                            <div class="logoImg">
                                <img src="~/AdminResources/img/nepalsarkarlogo.png" />
                            </div>

                        </div>
                        <div id="Headtitle" class="col-md-4" style="text-align:center;">
                            <p>@_4pix_Beruju.Utilities.GetCurrentLoginOfficeHeadingTitle(Model.ObjSamparikshadRequestMaterDetailVM.OfficeId)</p>

                            <p>
                                @_4pix_Beruju.Utilities.GetCurrentLoginOfficeMinistryName(Model.ObjSamparikshadRequestMaterDetailVM.OfficeId)

                            </p>

                            <p>
                                @_4pix_Beruju.Utilities.GetCurrentLoginOfficeMainOfficenName(Model.ObjSamparikshadRequestMaterDetailVM.OfficeId)

                            </p>

                            <p style="font-weight:bold;font-size:16px;">@_4pix_Beruju.Utilities.GetCurrentLoginOfficeName(Model.ObjSamparikshadRequestMaterDetailVM.OfficeId)</p>

                            <p>
                                @_4pix_Beruju.Utilities.GetCurrentLoginOfficeAddress(Model.ObjSamparikshadRequestMaterDetailVM.OfficeId)

                            </p>


                        </div>
                        <div class="col-md-4">

                        </div>

                    </div>
                    <div class="row">
                        <div class="col-md-4"></div>
                        <div id="rptTitle" class="col-md-4" style="text-align:center;">

                        </div>
                        <div class="col-md-4"></div>
                    </div>
                    <div class="clearfix"></div>
                    <div class="card-header">

                        <div class="row card-header d-flex align-items-center">

                            <div class="col-lg-4">प.स -२०७९/८०</div>
                            <div class="col-lg-4"></div>
                            <div class="col-lg-4">मिति : @Model.ObjSamparikshadRequestMaterDetailVM.RequestedDateNep</div>






                        </div>
                        <div class="row card-header d-flex align-items-center" style="margin-top:10px;">

                            <div class="col-lg-4">च.न.:@Model.ObjSamparikshadRequestMaterDetailVM.LetterNumber</div>
                            <div class="col-lg-4">विषय :बेरुजु सम्परीक्षण गरिदिनुहुन ।</div>
                            <div class="col-lg-4"></div>

                        </div>

                        <div class="row card-header d-flex align-items-center">

                            <div class="col-md-12">@Utilities.GetSamparikshadletterofficenameByOfficeId(Model.ObjSamparikshadRequestMaterDetailVM.ToWhomofficeId)</div>
                            <div class="col-md-12">@Utilities.GetSamparikshadletterofficeaddressByOfficeId(Model.ObjSamparikshadRequestMaterDetailVM.ToWhomofficeId)</div>
                        </div>

                        <div class="card-header d-flex align-items-center">
                            प्रस्तुत विषयमा @Utilities.GetCurrentLoginOfficeName(Model.ObjSamparikshadRequestMaterDetailVM.OfficeId) समेतको आ.व. विभिन्नको आर्थिक कारोवारको लेखा परीक्षण हुँदा बेरुजु प्रतिवेदनको निम्न दफाहरुमा उल्लेख भएका बेरुजु आर्थिक कार्याबिधि तथा वित्तिय उत्तरदायित्व ऐन २०७६ को दफा ४०(२) वमोजिम असुल भै आएकोले रू @Model.ObjSamparikshadRequestMaterDetailVM.TotalAmount  । उक्त बेरुजु रकम आर्थिक कार्याबिधि तथा वित्तीय उत्तरदायित्व ऐन २०७६ को दफा ४०(४) वमोजिम सम्परीक्षण गरिदिनुहुन अनुरोध छ ।
                        </div>


                        <div class="card-header d-flex align-items-center">
                            <div class="table-responsive">
                                <table class="table-bordered" width="100%">
                                    <thead>
                                        <tr>
                                            <th>सि.न</th>
                                            <th>आ.व</th>
                                            <th>बेरुजुको दफा नं.</th>
                                            <th>छोटकारि व्यहोरा</th>
                                            <th>रकम</th>
                                            <th>फछयैाट</th>
                                            <th>रकम</th>
                                            <th>फछयैाट गर्ने जिम्मेवार व्यक्तिको नाम र दर्जा</th>
                                            <th>कैफियत</th>
                                        </tr>
                                    </thead>

                                    <tr>
                                        <td>१</td>
                                        <td>@_4pix_Beruju.Areas.Admin.functions.GetFiscalyearTitleFromExternalBerujuId(Model.ObjSamparikshadRequestMaterDetailVM.ExternalBerujuId)</td>
                                        <td>@Model.ObjSamparikshadRequestMaterDetailVM.BerujuDafaNumber</td>
                                        <td>@Model.ObjSamparikshadRequestMaterDetailVM.BerujuShortDes</td>
                                        <td>@Model.ObjSamparikshadRequestMaterDetailVM.TotalAmount</td>
                                        <td>@Model.ObjSamparikshadRequestMaterDetailVM.BerujuShortDes</td>
                                        <td>@Model.ObjSamparikshadRequestMaterDetailVM.TotalAmount</td>
                                        <td>@Model.ObjSamparikshadRequestMaterDetailVM.ResponsiblePersonName<span>,</span>@Model.ObjSamparikshadRequestMaterDetailVM.Post</td>
                                        <td>@Model.ObjSamparikshadRequestMaterDetailVM.Remarks</td>
                                    </tr>



                                </table>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<link href="~/Content/sweetalert/sweet-alert.css" rel="stylesheet" />
<script src="~/Scripts/jquery-3.3.1.min.js"></script>
<script src="~/Scripts/SweetAlert.min.js"></script>

<script type="text/javascript">
     $(function () {
        var a = '@TempData["Success"]';
        if (a != '') {
            sweetAlert(a, "success", "success");
        }
        else {

        }


    });
</script>

<script type="text/javascript" src="https://ajax.googleapis.com/ajax/libs/jquery/1.8.3/jquery.min.js"></script>
<script type="text/javascript" src="https://cdnjs.cloudflare.com/ajax/libs/pdfmake/0.1.22/pdfmake.min.js"></script>
<script type="text/javascript" src="https://cdnjs.cloudflare.com/ajax/libs/html2canvas/0.4.1/html2canvas.min.js"></script>

<script type="text/javascript">
    $("body").on("click", "#btnExportPDF", function () {
        html2canvas($('#exporttopdf')[0], {
            onrendered: function (canvas) {
                var data = canvas.toDataURL();
                var docDefinition = {
                    content: [{
                        image: data,
                        width: 500
                    }]
                };
                pdfMake.createPdf(docDefinition).download("SamparikshadRequest.pdf");
            }
        });
    });
</script>
