    //function calculateAmount(divId) {
    //    var TotalAmountToAdd = 0;
    //    var bAmount = $("#DivName" + divId).val();
    //    if (bAmount != NaN) {
    //        TotalAmountToAdd += parseFloat(bAmount);
    //        $("#TTSamparikshadAmt").val(TotalAmountToAdd);
    //    };



    //}
    function calculateAmount() {

        var sum = 0;
        $('.price').each(function () {
            sum += Number($(this).val());
        });

        $("#TTSamparikshadAmt").val(sum);

        // here, you have your sum
    };



</script>




<script>
    document.querySelector("form").addEventListener("submit", function (e) {
        var btn = document.getElementById("btnSubmit");

        if (btn.disabled) {
            e.preventDefault(); // prevent multiple submit
            return false;
        }

        btn.disabled = true;
        btn.innerHTML = '<i class="fa fa-spinner fa-spin"></i> Saving...';
    });
</script>






