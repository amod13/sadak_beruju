@model _4pix_Beruju.Models.ExternalBeruju

@{
    ViewBag.Title = "MakeSamparikshad";
    Layout = "~/Areas/LocalLevel/Views/Shared/_LocalLevelLayout.cshtml";
    int i = 1;
}


<div class="breadcrumb-holder">
    <div class="container-fluid">
        <ul class="breadcrumb">
            <li class="breadcrumb-item"><a href="index.html">Home</a></li>
            <li class="breadcrumb-item active">सम्परीक्षण कार्य</li>
        </ul>
    </div>
</div>
<style>
    .greenClass {
        color: black;
        background-color: #e8f4e8;
    }
</style>

<section class="forms">
    <div class="container-fluid">
        <!-- Page Header-->
        <header>
            <h3 class="h3 display">सम्परीक्षण कार्य</h3>
        </header>
        <div class="row">
            <div class="col-lg-12">
                <div class="card">
                    @if (ViewBag.ErrorMessage != null)
                    {
                        <div class="alert alert-warning" role="alert">
                            @ViewBag.ErrorMessage
                        </div>

                    }

                    <div class="card-header d-flex align-items-center">

                    </div>
                    <div class="card-body">

                        <div class="table-responsive table-sm shadow p-3 mb-5 bg-white rounded">
                            <table class="table table-hover table-sm table-bordered">
                                <thead>
                                    <tr>
                                        <th>आर्थिक वर्ष</th>
                                        <th>बेरूजु दफा न</th>
                                        <th>गोश्वारा भौचर नम्बर</th>
                                        <th>भौचर मिति</th>
                                        <th>बेरुजु रकम</th>
                                        <th>बाँकि रकम</th>
                                    </tr>
                                </thead>
                                <tbody>


                                    <tr>

                                        <td>@Model.ExternalBerujuForSamparikshadVMObj.FiscalYearTitle</td>
                                        <td>@Model.ExternalBerujuForSamparikshadVMObj.BerujuNumber</td>

                                        <td>@Model.ExternalBerujuForSamparikshadVMObj.JVNUMBER</td>
                                        <td>@_4pix_Beruju.Utilities.GetNepaliDateFromEng(Model.ExternalBerujuForSamparikshadVMObj.VoucharDate)</td>
                                        <td>@Model.ExternalBerujuForSamparikshadVMObj.VoucharAmunt</td>
                                        <td>@Model.ExternalBerujuForSamparikshadVMObj.RemainingAmount</td>

                                    </tr>
                                </tbody>
                            </table>
                        </div>



                        @using (Html.BeginForm("MakeSamparikshad", "ExternalBerujuLL", FormMethod.Post,
new { enctype = "multipart/form-data" }))
                        {

                            @Html.HiddenFor(m => m.ObjExternalSamparikshadViewModel.ExternalBerujuId)
                            @Html.HiddenFor(m => m.ExternalBerujuForSamparikshadVMObj.VoucharAmunt)
                            @Html.HiddenFor(m => m.ExternalBerujuForSamparikshadVMObj.RemainingAmount)
                            @Html.HiddenFor(m => m.ObjExternalSamparikshadViewModel.SamparikshadReqMasterId)
                            @Html.HiddenFor(m => m.ExternalBerujuId)
                            @Html.ValidationSummary(true)
                            <fieldset>

                                <div class="row">
                                    <table class="table table-responsive-sm table-bordered">
                                        <thead>
                                            <tr>
                                                <th>
                                                    नाम
                                                </th>
                                                <th>
                                                    प्यान नं
                                                </th>
                                                <th>
                                                    मोबाईल
                                                </th>
                                                <th>
                                                    बेरुजु रकम
                                                </th>
                                                <th>अनुरोध रकम</th>
                                                @*<th>बाँकी रकम</th>*@
                                                <th>
                                                    सम्परीक्षण रकम
                                                </th>
                                            </tr>
                                        </thead>

                                        @for (int j = 0; j < Model.SamparikshadTowhomDetailVMListMain.Count; j++)
                                        {
                                            string Divid = Model.SamparikshadTowhomDetailVMListMain[j].EBToWhomId.ToString();
                                            string DividNameVal = string.Empty;
                                            decimal? RequAmount = _4pix_Beruju.Utilities.GetSamparikshadreqamoutByIndividualId(Model.ObjExternalSamparikshadViewModel.ExternalBerujuId, Model.ObjExternalSamparikshadViewModel.SamparikshadReqMasterId, Model.SamparikshadTowhomDetailVMListMain[j].EBToWhomId);
                                            if (RequAmount > 0)
                                            {
                                                DividNameVal = @"greenClass";
                                            }
                                            <tr class="@DividNameVal">
                                                @Html.HiddenFor(model => Model.SamparikshadTowhomDetailVMListMain[j].OfficeId)
                                                @Html.HiddenFor(model => Model.SamparikshadTowhomDetailVMListMain[j].PersonName)
                                                @Html.HiddenFor(model => Model.SamparikshadTowhomDetailVMListMain[j].PanNumber)
                                                @Html.HiddenFor(model => Model.SamparikshadTowhomDetailVMListMain[j].MobielNumber)
                                                @Html.HiddenFor(model => Model.SamparikshadTowhomDetailVMListMain[j].EBToWhomId)
                                                @Html.HiddenFor(model => Model.SamparikshadTowhomDetailVMListMain[j].BerujuAmount)
                                                <td>
                                                    @Model.SamparikshadTowhomDetailVMListMain[j].PersonName
                                                </td>

                                                <td>
                                                    @Model.SamparikshadTowhomDetailVMListMain[j].PanNumber
                                                </td>
                                                <td>
                                                    @Model.SamparikshadTowhomDetailVMListMain[j].MobielNumber
                                                </td>
                                                <td>
                                                    @Model.SamparikshadTowhomDetailVMListMain[j].BerujuAmount
                                                </td>

                                                <td>@RequAmount</td>
                                                @if (RequAmount.HasValue)
                                                {
                                                    if (RequAmount > 0)
                                                    {
                                                        <td>
                                                            @Html.TextBoxFor(model => model.SamparikshadTowhomDetailVMListMain[j].RevisedAmount, new { @class = "price", @onblur = "calculateAmount()" })
                                                        </td>
                                                    }
                                                    else
                                                    {
                                                        <td>
                                                            @Html.TextBoxFor(model => model.SamparikshadTowhomDetailVMListMain[j].RevisedAmount, new { @class = "price", @readonly = "readonly" })
                                                        </td>
                                                    }
                                                }
                                                else
                                                {
                                                    <td></td>
                                                }



                                            </tr>

                                        }


                                    </table>
                                </div>
                                <div class="row">
                                    <div class="col-md-3 col-sm-3 form-group">
                                        <label>सम्परीक्षण रकम</label>
                                        @Html.TextBoxFor(m => m.ObjExternalSamparikshadViewModel.ReviesedVoucherAmount, new { @id = "TTSamparikshadAmt", @class = "form-control form-control-sm", @required = "required", @readonly = "readonly" })
                                    </div>
                                    <div class="col-md-3 col-sm-3 form-group">
                                        <label>चलानी नं</label>
                                        @Html.TextBoxFor(m => m.ObjExternalSamparikshadViewModel.LetterNumber, new { @class = "form-control form-control-sm", @required = "required" })
                                    </div>
                                    <div class="col-md-3 col-sm-3 form-group">
                                        <label>सम्परीक्षण मिति</label>
                                        @Html.TextBoxFor(m => m.ObjExternalSamparikshadViewModel.RevisedDateStr, new { @class = "form-control form-control-sm MaskDate", @required = "required", @id = "VoucharDateNeplai" })
                                    </div>



                                    <div class="col-md-12 col-sm-12 form-group">
                                        <label>विवरण</label>
                                        @Html.TextAreaFor(m => m.ObjExternalSamparikshadViewModel.RevisedRemarks, new { @class = "form-control form-control-sm", @required = "required" })
                                    </div>

                                    <div class="col-md-4 col-sm-4 form-group">
                                        <label>कागजात (JPG/PDF)*</label><br />
                                        @Html.TextBoxFor(
                                                m => m.ObjExternalSamparikshadViewModel.UploadFileDetailsFileType,
                                                new { type = "file", required = "required" }
                                            )
                                    </div>

                                    <div class="col-md-4 col-sm-4 form-group">
                                        <label>बेरुजु कट्टी</label>
                                        @Html.DropDownListFor(m => m.ObjExternalSamparikshadViewModel.MalepaOrKumariChowkId, Utilities.GetSamparikshadDetailToFDD(), new { @class = "form-control form-control-sm", @required = "required" })
                                    </div>
                                </div>





                                <div class="form-group">
                                    @*<button type="submit" class="btn btn-secondary"><i class="fa fa-angle-double-left">&nbsp;</i> Back</button> &nbsp; &nbsp; &nbsp;*@
                                    <button type="submit" id="btnSubmit" class="btn btn-primary btn-sm">
                                        <i class="fa fa-floppy-o">&nbsp;</i>सुरक्षित गर्नुहोस
                                    </button>
                                    <a href="@Url.Action("GetSamparikshadList","ExternalBerujuLL")" , class="btn btn-sm btn-success">
                                        <i class="fa fa-backward"></i>&nbsp;मूख्य मेनु
                                    </a>
                                </div>
                            </fieldset>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>


@*<script src="~/Scripts/jquery.validate.js"></script>
    <script src="~/Scripts/jquery.validate.unobtrusive.js"></script>*@

<script src="~/Scripts/jquery-3.3.1.min.js"></script>
