@model _4pix_Beruju.Models.ExternalBeruju

@{
    ViewBag.Title = "Create";
    Layout = "~/Areas/LocalLevel/Views/Shared/_LocalLevelLayout.cshtml";
}
<script src="~/vendor/CkStandar/ckeditor.js"></script>
<link href="~/Content/sweetalert/sweet-alert.css" rel="stylesheet" />
<div class="breadcrumb-holder">
    <div class="container-fluid">
        <ul class="breadcrumb">
            <li class="breadcrumb-item"><a href="index.html">Home</a></li>
            <li class="breadcrumb-item active">अन्तिम लेखापरीक्षण बेरूजु</li>
        </ul>
    </div>
</div>
<section class="forms">
    <div class="container-fluid">
        <!-- Page Header-->
        <header>
            <h6 class="h3 display">अन्तिम लेखापरीक्षण बेरूजु (@_4pix_Beruju.Areas.Admin.functions.GetKoshTypeFromId(Model.KoshTypeId))</h6>
        </header>
        <div class="row">
            <div class="col-lg-12">
                <div class="card">
                    <div class="card-header d-flex align-items-center">
                        @if (ViewBag.ErrorMessage != null)
                        {
                            <div style="color:red;font-size:15px;font-style:italic;">@ViewBag.ErrorMessage</div>
                        }
                    </div>
                    <div class="card-body">

                        @using (Html.BeginForm("Edit", "ExternalBerujuLL", FormMethod.Post,
new { enctype = "multipart/form-data" }))
                        {
                            @Html.HiddenFor(m => m.ExternalBerujuId)
                            @Html.HiddenFor(m => m.InternalBerujuId)
                            @Html.HiddenFor(m => m.OfficeId)
                            @Html.HiddenFor(m => m.KoshTypeId)
                            @Html.HiddenFor(m=>m.UploadedFileUrl)
                            @Html.ValidationSummary(true)
                            <fieldset>



                                @Html.Partial("_CreateEdit")

                                <div class="well well-small" id="Add-Item" style="width: 990px;">

                                    @Html.ActionLink("विवरण थप्नुहोस", "ToWhomeDetailsList", null, new { @id = "btns", @class = "addProductItem btn btn-primary" })

                                    <table id="tblotm" style="width: 940px; margin-left: 0px !important;margin-top:10px;">
                                        <tr>

                                            <td style="width:197px;font-weight:bold;">सम्बन्धितको नाम</td>
                                            <td style="width:121px;font-weight:bold;">प्यान नं</td>
                                            <td style="width:117px;font-weight:bold;">मोबाईल नं</td>
                                            <td style="width:123px;font-weight:bold;">रकम</td>
                                            <td style="width:127px;font-weight:bold;">भौचर नम्बर</td>
                                            <td style="width:148px;font-weight:bold;">मिति</td>

                                        </tr>


                                    </table>

                                    @try
                                    {
                                        foreach (var item in Model.ToWhomDetailListVMList)
                                        {

                                            @Html.Partial("ToWhomeDetailsList", item)

                                        }
                                    }
                                    catch { }

                                </div>

                                <br />
                                <div class="row">
                                    <div class="col-md-4 col-sm-4 form-group">
                                        <label>बेरूजु रकम</label>
                                        @Html.TextBoxFor(m => m.VoucharAmunt, new { @id = "TTSamparikshadAmt", @class = "form-control form-control-sm", @required = "required", @readonly = "readonly" })
                                    </div>


                                    <div class="col-md-4 col-sm-4 form-group">
                                        <label>कागजात</label><br />
                                        @Html.TextBoxFor(m => m.SupportingDocFiles, new
                                        {
                                            type = "file",
                                            accept = ".png,.jpg,.jpeg,.pdf"
                                        })
                                        <span class="text-danger" id="fileError"></span>


                                    </div>

                                    @if (!string.IsNullOrEmpty(Model.UploadedFileUrl))
                                    {
                                        <div>
                                            <label>Current File:</label>
                                            <a href="@Url.Content("~/RequiredDocs/" + Model.UploadedFileUrl)" target="_blank">
                                                View / Download
                                            </a>
                                        </div>
                                    }


                                </div>
                                <hr />

                                <div class="form-group">
                                    @*<button type="submit" class="btn btn-secondary"><i class="fa fa-angle-double-left">&nbsp;</i> Back</button> &nbsp; &nbsp; &nbsp;*@
                                    <button type="submit" class="btn btn-primary"><i class="fa fa-floppy-o">&nbsp;</i>सच्चाउनुहोस्</button>
                                    <a href="@Url.Action("Index","ExternalBerujuLL", new { @id=Model.KoshTypeId})" , class="btn btn-sm btn-success">
                                        <i class="fa fa-backward"></i>&nbsp;मूख्य मेनु
                                    </a>
                                </div>
                            </fieldset>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>


