@model _4pix_Beruju.Models.DashboardViewModel

@{
    ViewBag.Title = "ChangePassword";
    Layout = "~/Areas/LocalLevel/Views/Shared/_LocalLevelLayout.cshtml";
}

<link href="~/Content/toastr.min.css" rel="stylesheet" />
<div class="breadcrumb-holder">
    <div class="container-fluid">
        <ul class="breadcrumb">
            <li class="breadcrumb-item"><a href="#">Home</a></li>
            <li class="breadcrumb-item active">पासवर्ड परिवर्तन (कार्यालयहरूको)</li>
        </ul>
    </div>
</div>
<section class="forms">
    <div class="container-fluid">
        <!-- Page Header-->
        <header>
            <h1 class="h3 display">पासवर्ड परिवर्तन (कार्यालयहरूको)</h1>
        </header>
        <div class="row">
            <div class="col-lg-12">
                <div class="card">
                    <div class="card-header d-flex align-items-center">
                        @*<h4>form</h4>*@
                    </div>
                    <div class="card-body">

                        @using (Html.BeginForm("ChangePassword", "LocalLevelHome", FormMethod.Post,
new { enctype = "multipart/form-data" }))
                        {

                            @Html.ValidationSummary(true)
                            <fieldset>
                                <div class="row">
                                    <div class="col-md-4 col-sm-6 form-group">
                                        <label>प्रयोगकर्ताको नाम (Username)</label>
                                        @Html.TextBoxFor(m => m.UserEmail, new { @class = "form-control form-control sm", @required = "required" })

                                    </div>
                                </div>
                                <div class="row">
                                    <div class="col-md-4 col-sm-6 form-group" style="font-size:9px!important; font-style:italic;color:red;">
                                        <label>(प्रयोगकर्ताको पासवर्ड पूर्वनिर्धारित Sadak@123# हुन्छ ।)</label>
                                    </div>
                                </div>

                                <div class="form-group">
                                    <button type="submit" class="btn btn-primary"><i class="fa fa-floppy-o">&nbsp;</i>Change Password</button>
                                </div>




                            </fieldset>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>


<link href="~/Content/sweetalert/sweet-alert.css" rel="stylesheet" />
<script src="~/Scripts/jquery-3.3.1.min.js"></script>
<script src="~/Scripts/SweetAlert.min.js"></script>


<script type="text/javascript">
     $(function () {
         var a = '@TempData["Notifications"]';
         var b = '@TempData["ErrorMessage"]';
         if (a != '') {
             sweetAlert(a, "success", "success");
         }
         else if (b != '') {
             sweetAlert(b, "error", "error");
         }


    });


</script>

