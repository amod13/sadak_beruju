@model _4pix_Beruju.Models.DashboardViewModel

@{
    ViewBag.Title = "ViewSamparikshadPage";
    Layout = "~/Areas/LocalLevel/Views/Shared/_LocalLevelLayout.cshtml";
}


<section class="dashboard-counts section-padding">
    <div class="container-fluid">
        <div class="grey-bg container-fluid">

            <div class="row">
                <div class="col-lg-12">
                    @using (Ajax.BeginForm("ViewSamparikshadPartial", "LocalLevelHome", new AjaxOptions { HttpMethod = "POST", InsertionMode = InsertionMode.Replace, UpdateTargetId = "DetailsReportsID", LoadingElementId = "loader" }))
                    {
                        @Html.HiddenFor(m => m.UserTypeId)
                    <div class="row">
                        <div class="col-md-4 col-sm-4" style="margin-bottom:20px;">
                            <label>आर्थिक वर्ष</label>
                            @Html.DropDownListFor(model => model.FiscalYearId, _4pix_Beruju.Areas.Admin.functions.GetFiscalYearListWithDefaultDD(), new { @class = "form-control form-control-sm", id = "dll_FYID" })

                        </div>

                        <div class="col-md-3 col-sm-6 form-group">
                            <label>कार्यालय प्रकार</label>
                            @Html.DropDownListFor(m => m.OfficeTypeSearchId, Utilities.GetOfficeTypeDDWithDefaultForSuperAdmin(), new { @class = "form-control form-control sm", @id = "dll_OfficeType" })

                        </div>
                        <div class="col-md-3 col-sm-6 form-group">
                            <label>आन्तरीक/अन्तिम</label>
                            @Html.DropDownListFor(m => m.InternalOrExternalBerujuTypeId, _4pix_Beruju.Areas.Admin.functions.GetInternalOrExternalTitleDD(), new { @class = "form-control form-control sm", @id = "dll_OfficeType" })

                        </div>

                        <div class="col-md-2 col-sm-4" style="margin-bottom:20px;">
                            <label>&nbsp;</label>
                            <button type="submit" class="form-control form-control-sm btn btn-warning"><i class="fa fa-eye">&nbsp;</i>देखाउनुहोस्</button>
                        </div>
                    </div>
                    }
                </div>
                <hr />
                <br />
                <div class="col-sm-12" style="margin-bottom:20px;">
                    <input type="button" id="btnExport" value="Export-Excel" class="btn btn-info btn-sm" />
                    <input type="button" id="print" onclick="PrintElem('DetailsReportsID');" value="Print" class="btn btn-info btn-sm" />
                </div>

                <div class="col-lg-12" id="">

                    <div id="loader" class=" aletr" style="display:none">
                        Loading...
                        <img src="~/AdminResources/img/ajax-loader.gif" />

                    </div>


                    <div id="DetailsReportsID">
                        <table class="table table-sm table-bordered border-primary" style="background:white;">


                            <thead>
                                <tr>
                                    <th>आर्थिक वर्ष</th>
                                    <th>कार्यालयको नाम</th>
                                    <th>कार्यालयको कोड</th>
                                    <th>जम्मा सम्परीक्षण</th>
                                    <th>विवरण</th>


                                </tr>
                            </thead>
                            @foreach (var item in Model.IntExtSamparikshadCountVMList)
                            {


                                <tr>
                                    <td>@item.FiscalYearTitle</td>
                                    <td>@item.OFficeName</td>
                                    <td>@item.OfficeCode</td>
                                    <td>@item.Total</td>
                                    <td>
                                        @Html.ActionLink(" ", "ViewSamparikshadDetailByOfficeId", "LocalLevelHome", new { @id = item.OfficeDetailId, @id1 = Model.FiscalYearId,@id2=Model.InternalOrExternalBerujuTypeId }, new { @class = "edits fa fa-eye" })
                                    </td>

                                </tr>

                            }



                        </table>
                    </div>

                </div>
            </div>


        </div>
    </div>
</section>

<script src="~/Scripts/jquery-3.3.1.min.js"></script>
<script src="~/Scripts/jquery.unobtrusive-ajax.js"></script>
