        <thead>
            <tr>
                <th>आर्थिक वर्ष</th>
                <th>कार्यलयको नाम</th>
                <th>कार्यलयको कोड</th>
                <th>जम्मा सैदान्तिक बेरूजु</th>


            </tr>
        </thead>
        @foreach (var item in Model.SaidantikCountOfficeWiseViewModelList)
        {


            <tr>
                <td>@item.FiscalYearTitle</td>
                <td>@item.OFficeName</td>
                <td>@item.OfficeCode</td>
