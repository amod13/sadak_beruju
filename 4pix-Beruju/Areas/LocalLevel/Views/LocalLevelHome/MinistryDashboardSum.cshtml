@model _4pix_Beruju.Models.DashboardViewModel

@{
    ViewBag.Title = "AdminDashBoard";
    Layout = "~/Areas/LocalLevel/Views/Shared/_LocalLevelLayout.cshtml";
    decimal TotalSumBeruju = 0;
    decimal RemainingAmount = 0;
}

<link href="~/AdminResources/css/DashboardBootstrap.css" rel="stylesheet" />
<link href="https://fonts.googleapis.com/css?family=Montserrat&display=swap" rel="stylesheet">
<script src="~/Scripts/jquery-3.3.1.min.js"></script>
<script src="https://www.gstatic.com/charts/loader.js"></script>
<link href="~/fontawesome5/css/fontawesome.min.css" rel="stylesheet" />
<style>
    .card .fa {
        color: blue;
    }

    .card {
        box-shadow: 10px 10px 5px lightblue;
    }

    .pull-right span {
        font-size: 12px;
        padding: 5px;
    }
</style>

<section class="dashboard-counts section-padding">
    <div class="container-fluid">
        <div class="grey-bg container-fluid">
            <section id="minimal-statistics">

                <div class="row">
                    <div class="col-xl-3 col-sm-6 col-12">
                        <div class="card">
                            <div class="card-content">
                                <div class="card-body">
                                    <div class="media d-flex">
                                        <div class="align-self-center">
                                            <i class="fa fa-chart-bar fa-2x"></i>
                                        </div>
                                        <div class="media-body text-right">
                                            <h5>@_4pix_Beruju.DashboardUtility.Dashboard_GetBerujuSumToMinistryUser(1)</h5>
                                            <span>नियमित गर्नुपर्ने</span>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="col-xl-3 col-sm-6 col-12">
                        <div class="card">
                            <div class="card-content">
                                <div class="card-body">
                                    <div class="media d-flex">
                                        <div class="align-self-center">
                                            <i class="fa fa-chart-bar fa-2x"></i>
                                        </div>
                                        <div class="media-body text-right">
                                            <h5>@_4pix_Beruju.DashboardUtility.Dashboard_GetBerujuSumToMinistryUser(2)</h5>
                                            <span>असुल उपर गर्नुपर्ने</span>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="col-xl-3 col-sm-6 col-12">
                        <div class="card">
                            <div class="card-content">
                                <div class="card-body">
                                    <div class="media d-flex">
                                        <div class="align-self-center">
                                            <i class="fa fa-chart-bar fa-2x"></i>
                                        </div>
                                        <div class="media-body text-right">
                                            <h5>@_4pix_Beruju.DashboardUtility.Dashboard_GetBerujuSumToMinistryUser(3)</h5>
                                            <span>पेस्की</span>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="col-xl-3 col-sm-6 col-12">
                        <div class="card">
                            <div class="card-content">
                                <div class="card-body">
                                    <div class="media d-flex">
                                        <div class="align-self-center">
                                            <i class="fa fa-chart-bar fa-2x"></i>
                                        </div>
                                        <div class="media-body text-right">
                                            <h5>@_4pix_Beruju.DashboardUtility.Dashboard_GetSamparkishadSumToMinistryUser()</h5>
                                            <span>सम्परीक्षण</span>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="row">
                    <div class="col-xl-3 col-sm-6 col-12">
                        <div class="card">
                            <div class="card-content">
                                <div class="card-body">
                                    <div class="media d-flex">
                                        <div class="media-body text-left">
                                            <h5 class="danger">@_4pix_Beruju.DashboardUtility.Dashboard_GetRemainingSumToMinistryUser()</h5>
                                            <span>जम्मा बेरुजु</span>
                                        </div>
                                        <div class="align-self-center">
                                            <i class="fa fa-sticky-note fa-2x"></i>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="row">

                    <div class="col-xl-3 col-sm-6 col-12">
                        <div class="card">
                            <div class="card-content">
                                <div class="card-body">
                                    <div class="media d-flex">
                                        <div class="media-body text-left">
                                            <h3 class="success">@_4pix_Beruju.DashboardUtility.GetTotalOfficeByTypeIdForMinistryUser(3, 6, 1)</h3>
                                            <span>निर्देशाानलाय</span>
                                        </div>
                                        <div class="align-self-center">
                                            <i class="icon-home success font-large-2 float-right"></i>
                                        </div>
                                    </div>
                                    <div class="pull-right">
                                        <a href="@Url.Action("ViewNirdeshOfficeDtl", "LocalLevelHome", new { id = "4" })">
                                            <i class="fa fa-eye"></i><span>विवरण</span>
                                        </a>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="col-xl-3 col-sm-6 col-12">
                        <div class="card">
                            <div class="card-content">
                                <div class="card-body">
                                    <div class="media d-flex">
                                        <div class="media-body text-left">
                                            <h3 class="success">@_4pix_Beruju.DashboardUtility.GetTotalOfficeByTypeIdForMinistryUser(4, 6, 2)</h3>
                                            <span>कार्यालय</span>
                                        </div>
                                        <div class="align-self-center">
                                            <i class="icon-home success font-large-2 float-right"></i>
                                        </div>
                                    </div>
                                    <div class="pull-right">
                                        <a href="@Url.Action("ViewNirdeshOfficeDtl", "LocalLevelHome", new { id = "5" })">
                                            <i class="fa fa-eye"></i><span>विवरण</span>
                                        </a>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>



                </div>
            </section>


            <div class="row">
                <div class="col-lg-6">

                    @Html.Partial("_ColumnChartMinistry")

                </div>

                <div class="col-lg-6">

                    @Html.Partial("_PieChartMinistry")

                </div>
            </div>


            <div class="row">

                <div class="col-lg-12">
                    <div class="box-header with-border">
                        <h5 class="box-title custom-heading" style="text-align:center;">अन्तिम बेरूजु</h5>
                    </div>
                    <table class="table table-sm table-bordered border-primary" style="background:white;">
                        <thead>
                            <tr>
                                <th>आर्थिक वर्ष</th>

                                <th>विनियोजन</th>
                                <th>राजस्व</th>
                                <th>धरौटी</th>
                                <th>अन्य कोष</th>
                                <th>जम्मा</th>
                                <th>समपरिक्षण</th>
                                <th>बाँकी</th>
                            </tr>
                        </thead>
                        @foreach (var item in Model.DashboardkoshwiseTableList)
                        {
                            TotalSumBeruju = item.Biniyojan + item.Rajaswo + item.Dharauti + item.Anyakosh;
                            RemainingAmount = TotalSumBeruju - item.TotalSamparikshad;
                            <tr>
                                <td>@item.FiscalYearTitle</td>

                                <td>@item.Biniyojan</td>
                                <td>@item.Rajaswo</td>
                                <td>@item.Dharauti</td>
                                <td>@item.Anyakosh</td>
                                <td>@TotalSumBeruju</td>
                                <td>@item.TotalSamparikshad</td>
                                <td>@RemainingAmount</td>
                            </tr>
                        }


                    </table>
                </div>
            </div>




        </div>
    </div>
</section>
