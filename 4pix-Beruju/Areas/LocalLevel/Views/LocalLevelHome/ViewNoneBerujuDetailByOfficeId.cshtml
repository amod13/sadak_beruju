@model _4pix_Beruju.Models.DashboardViewModel

@{
    ViewBag.Title = "ViewNoneBerujuDetailByOfficeId";
    Layout = "~/Areas/LocalLevel/Views/Shared/_LocalLevelLayout.cshtml";
    int i = 1;
}

<section class="dashboard-counts section-padding">
    <div class="container-fluid">
        <div class="grey-bg container-fluid">

            <div class="row">
                <h3>कार्यालयको नाम : @Utilities.GetCurrentLoginOfficeName(Model.CurrentLoginUserOfficeId)</h3>
                <hr />
                <br />
                <div class="col-sm-12" style="margin-bottom:20px;">
                    <input type="button" id="btnExport" value="Export-Excel" class="btn btn-info btn-sm" />
                    <input type="button" id="print" onclick="PrintElem('DetailsReportsID');" value="Print" class="btn btn-info btn-sm" />
                </div>

                <div class="col-lg-12" id="">


                    <div id="DetailsReportsID">
                        <table class="table table-sm table-bordered border-primary" style="background:white;">


                            <thead>
                                <tr>
                                    <th>आर्थिक वर्ष</th>
                                    <th>पूर्ण व्यहोरा</th>
                                    <th>कागजात</th>


                                </tr>
                            </thead>
                            @foreach (var item in Model.Admin_BerujuNotDoneListByOfficeIdVMList)
                            {
                                string extn = string.Empty;
                                string imgPath = string.Empty;
                                if (item.UploadFileUrl != "" || !string.IsNullOrEmpty(item.UploadFileUrl))
                                {
                                    FileInfo fi = new FileInfo(item.UploadFileUrl);
                                    extn = fi.Extension;
                                    imgPath = @"~/RequiredDocs/" + item.UploadFileUrl;
                                }


                                <tr>
                                    <td>@item.FiscalYearTitle</td>

                                    <td>@Html.Raw(item.NotDoneRemarks)</td>

                                    @if (item.UploadFileUrl != "" || !string.IsNullOrEmpty(item.UploadFileUrl))
                                    {
                                        if (extn == ".jpg" || extn == ".JPG" || extn == ".jpeg" || extn == ".JPEG" || extn == ".PNG" || extn == ".png" || extn == ".pdf" || extn == ".PDF")
                                        {
                                            <td>
                                                <a target="_blank" href='@Url.Content(imgPath)'>
                                                    <text> अपलोड गरेको कागजात हेर्नुहोस</text>

                                                </a>l
                                            </td>
                                        }
                                        else
                                        {
                                            <td>
                                                @Html.ActionLink(" Download", "Download", "LocalLevelHome", new { @FileName = item.UploadFileUrl }, new { @class = "fa fa-download" })
                                            </td>
                                        }
                                    }
                                    else
                                    {
                                        <td></td>
                                    }

                                </tr>

                            }



                        </table>
                    </div>

                </div>
            </div>


        </div>
    </div>
</section>



