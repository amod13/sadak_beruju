                        <h5 class="box-title custom-heading" style="text-align:center;">अन्तिम बेरूजु</h5>
                    </div>
                    <table class="table table-sm table-bordered border-primary" style="background:white;">
                        <thead>
                            <tr>
                                <th>आर्थिक वर्ष</th>

                                <th>विनियोजन</th>
                                <th>राजस्व</th>
                                <th>धरौटी</th>
                                <th>अन्य कोष</th>
                                <th>जम्मा</th>
                                <th>सम्परीक्षण</th>
                                <th>बाँकी</th>
                            </tr>
                        </thead>
                        @foreach (var item in Model.DashboardkoshwiseTableList)
                        {

                            TotalSumBeruju = item.Biniyojan + item.Rajaswo + item.Dharauti + item.Anyakosh;
                            RemainingAmount = TotalSumBeruju - item.TotalSamparikshad;
                            <tr>
                                <td>@item.FiscalYearTitle</td>

                                <td>@_4pix_Beruju.Utilities.EnglishToNepaliNumber(item.Biniyojan.ToString())</td>
                                <td>
                                    @_4pix_Beruju.Utilities.EnglishToNepaliNumber(item.Rajaswo.ToString())
                                </td>
                                <td>
                                    @_4pix_Beruju.Utilities.EnglishToNepaliNumber(item.Dharauti.ToString())
                                </td>
                                <td>
                                    @_4pix_Beruju.Utilities.EnglishToNepaliNumber(item.Anyakosh.ToString())
                                </td>
                                <td>
                                    @_4pix_Beruju.Utilities.EnglishToNepaliNumber(TotalSumBeruju.ToString())
                                </td>
                                <td>
                                    @_4pix_Beruju.Utilities.EnglishToNepaliNumber(item.TotalSamparikshad.ToString())
                                </td>
                                <td>
                                    @_4pix_Beruju.Utilities.EnglishToNepaliNumber(RemainingAmount.ToString())
                                </td>
                            </tr>
                        }


                    </table>
