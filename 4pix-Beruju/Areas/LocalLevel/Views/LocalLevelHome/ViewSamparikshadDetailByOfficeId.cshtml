@model _4pix_Beruju.Models.DashboardViewModel

@{
    ViewBag.Title = "ViewSamparikshadDetailByOfficeId";
    Layout = "~/Areas/LocalLevel/Views/Shared/_LocalLevelLayout.cshtml";
    int i = 1;
}
<section class="dashboard-counts section-padding">
    <div class="container-fluid">
        <div class="grey-bg container-fluid">

            <div class="row">
                <h3>कार्यालयको नाम : @Utilities.GetCurrentLoginOfficeName(Model.CurrentLoginUserOfficeId)</h3>
                <hr />
                <br />
                <div class="col-sm-12" style="margin-bottom:20px;">
                    <input type="button" id="btnExport" value="Export-Excel" class="btn btn-info btn-sm" />
                    <input type="button" id="print" onclick="PrintElem('DetailsReportsID');" value="Print" class="btn btn-info btn-sm" />
                </div>

                <div class="col-lg-12" id="">


                    <div id="DetailsReportsID">
                        <table class="table table-sm table-bordered border-primary" style="background:white;">


                            <thead>
                                <tr>
                                    <th>आर्थिक वर्ष</th>
                                    <th>बेरूजु प्रकार</th>
                                    <th>सम्परीक्षण रकम</th>
                                    <th>व्यहोरा</th>
                                    <th>कागजात</th>
                                    <th>सम्परीक्षण विवरण</th>
                                    <th>बेरूजु विवरण</th>



                                </tr>
                            </thead>
                            @foreach (var item in Model.Admin_GetInternalExternalSamparikshadListByOfficeIdVMList)
                            {
                                string extn = string.Empty;
                                string imgPath = string.Empty;
                                if (item.UploadFileDetails != "" || !string.IsNullOrEmpty(item.UploadFileDetails))
                                {
                                    FileInfo fi = new FileInfo(item.UploadFileDetails);
                                    extn = fi.Extension;
                                    imgPath = @"~/RequiredDocs/" + item.UploadFileDetails;
                                }


                                <tr>
                                    <td>@item.FiscalYearTitle</td>
                                    <td>@Html.Raw(item.TypeName)</td>
                                    <td>@item.ReviesedVoucherAmount</td>
                                    <td>@item.RevisedRemarks</td>

                                    @if (item.UploadFileDetails != "" || !string.IsNullOrEmpty(item.UploadFileDetails))
                                    {
                                        if (extn == ".jpg" || extn == ".JPG" || extn == ".jpeg" || extn == ".JPEG" || extn == ".PNG" || extn == ".png" || extn == ".pdf" || extn == ".PDF")
                                        {
                                            <td>
                                                <a target="_blank" href='@Url.Content(imgPath)'>
                                                    <text> अपलोड गरेको कागजात हेर्नुहोस</text>

                                                </a>l
                                            </td>
                                        }
                                        else
                                        {
                                            <td>
                                                @Html.ActionLink(" Download", "Download", "LocalLevelHome", new { @FileName = item.UploadFileDetails }, new { @class = "fa fa-download" })
                                            </td>
                                        }
                                    }
                                    else
                                    {
                                        <td></td>
                                    }

                                    @if (Model.InternalOrExternalBerujuTypeId == 1)
                                    {
                                        <td>
                                            @Html.ActionLink(" हेर्नुहोस", "ViewDetailInternalSamparikshadForm", "LocalLevelHome", new { @id = item.InternalSamparishadId, @id1 = item.InternalBerujuId, @id2 = item.OfficeId }, new { @class = "fa fa-eye", target = "_blank" })
                                        </td>
                                        <td>
                                            @Html.ActionLink(" हेर्नुहोस", "ViewInternalBerujuDetails", "LocalLevelHome", new { @id = item.InternalBerujuId, @id1 = item.OfficeId }, new { @class = "fa fa-eye", target = "_blank" })
                                        </td>
                                    }
                                    else
                                    {
                                        <td>
                                            @Html.ActionLink(" हेर्नुहोस", "ViewDetailSamparikshadForm", "LocalLevelHome", new { @id = item.SamparishadId, @id1 = item.ExternalBerujuId, @id2 = item.OfficeId }, new { @class = "fa fa-eye", target = "_blank" })
                                        </td>
                                        <td>
                                            @Html.ActionLink(" हेर्नुहोस", "ViewExternalBerujuDetails", "LocalLevelHome", new { @id = item.ExternalBerujuId, @id1 = item.OfficeId }, new { @class = "fa fa-eye", target = "_blank" })
                                        </td>
                                    }





                                </tr>

                            }



                        </table>
                    </div>

                </div>
            </div>


        </div>
    </div>
</section>


