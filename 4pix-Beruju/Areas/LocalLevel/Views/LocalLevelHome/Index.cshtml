                                <th>विनियोजन</th>
                                <th>राजस्व</th>
                                <th>धरौटी</th>
                                <th>अन्य कोष</th>
                            </tr>
                        </thead>
                        @foreach (var item in Model.DashboardkoshwiseTableList)
