@model _4pix_Beruju.Models.Setups.CurrentOfficeChiefDetails

@{
    ViewBag.Title = "Delete";
    Layout = "~/Areas/LocalLevel/Views/Shared/_LocalLevelLayout.cshtml";

}

<div class="breadcrumb-holder">
    <div class="container-fluid">
        <ul class="breadcrumb">
            <li class="breadcrumb-item"><a href="#">Home</a></li>
            <li class="breadcrumb-item active">सेटअप</li>
        </ul>
    </div>
</div>

<section class="forms">
    <div class="container-fluid">
        <!-- Page Header-->
        <header>
            <h3 class="h3 display">कार्यालय प्रमुख-सम्परीक्षण अनुरोध/कार्यको लागि</h3>
        </header>
        <div class="row">
            <div class="col-lg-12">
                <div class="card">
                    <div class="card-header d-flex align-items-center">

                        <div class="card-body">


                            <div>
                               
                                <dl class="dl-horizontal">
                                    <dt>
                                        @Html.DisplayNameFor(model => model.ChiefName)
                                    </dt>

                                    <dd>
                                        @Html.DisplayFor(model => model.ChiefName)
                                    </dd>

                                    <dt>
                                        @Html.DisplayNameFor(model => model.ChiefPost)
                                    </dt>

                                    <dd>
                                        @Html.DisplayFor(model => model.ChiefPost)
                                    </dd>

                                    <dt>
                                        आर्थिक वर्ष
                                    </dt>

                                    <dd>
                                        @_4pix_Beruju.Areas.Admin.functions.GetFiscalyearTitleFromId(Model.RunnigFiscalYearId)
                                    </dd>

                                </dl>

                                @using (Html.BeginForm())
                                {
                                    @Html.AntiForgeryToken()

                                    <div class="form-actions no-color">
                                        <input type="submit" value="Delete" class="btn btn-default" />
                                        @Html.ActionLink("मुख्य सुची", "Index",null,new { @class="btn btn-primary"})
                                    </div>
                                }
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>