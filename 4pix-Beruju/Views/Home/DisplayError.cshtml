@model _4pix_Beruju.Models.ReturnMessageViewModel
@{
    Layout = null;
}
<!doctype html>
<html lang="en">
<head>
    <title>Error Page 2</title>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <link rel="icon" href="images/favicon.png" type="image/x-icon">

    <!-- Google Fonts -->
    <link href="https://fonts.googleapis.com/css?family=Lato:300,300i,400,400i,700,700i,900,900i%7CMerriweather:300,300i,400,400i,700,700i,900,900i" rel="stylesheet">

    <!-- Bootstrap Stylesheet -->

    <link href="~/ErrorHandlingRes/bootstrap.min.css" rel="stylesheet" />
    <!-- Font Awesome Stylesheet -->

    <link href="~/ErrorHandlingRes/font-awesome.min.css" rel="stylesheet" />
    <!-- Custom Stylesheets -->
    <link href="~/ErrorHandlingRes/style.css" rel="stylesheet" />
    <link href="~/ErrorHandlingRes/orange.css" rel="stylesheet" />
    <link href="~/ErrorHandlingRes/responsive.css" rel="stylesheet" />

</head>


<body>

    <!--====== LOADER =====-->
    <div class="loader"></div>


    <!--======================== ERROR-PAGE-2 =====================-->
    <section id="error-page-2" class="full-page-body full-page-back">
        <div class="full-page-wrapper">
            <div class="full-page-content">
                <div class="container">
                    <div class="row">
                        <div class="col-sm-12">


                            <div class="row">

                                <div class="col-xs-12 col-sm-12 col-md-4 col-lg-4 error-page-2-circle text-center">
                                    <h2>404</h2>
                                </div>

                                <div class="col-xs-12 col-sm-12 col-md-8 col-lg-8 error-page-2-text">


                                    <h2>Something went wrong !</h2>

                                    @if (!string.IsNullOrEmpty(Model.ReturnMessage))
                                    {
                                        <p>@Model.ReturnMessage</p>
                                    }
                                    else

                                    {
                                        <p>We are sorry but it appears that the page you are looking for could not be found. We are working on it and we will get it fixed as soon as possible.</p>

                                    }

                                </div>
                            </div>
                        </div><!-- end columns -->
                    </div><!-- end row -->
                </div><!-- end container -->
            </div><!-- end full-page-content -->
        </div><!-- end full-page-wrapper -->
    </section><!-- end error-page-2 -->
    <!-- Page Scripts Starts -->
    <!-- Page Scripts Ends -->
    <script src="~/ErrorHandlingRes/jquery.min.js"></script>
    <script src="~/ErrorHandlingRes/bootstrap.min.js"></script>
    <script src="~/ErrorHandlingRes/custom-navigation.js"></script>

</body>
</html>
