@model _4pix_Beruju.Areas.Admin.Models.UsersRoleViewModel
@{
    ViewBag.Title = "AddRoleToUser";
    Layout = "~/Views/Shared/_Layout.cshtml";
}


<div class="row">
    <div class="col-lg-12">
        <div class="card">
            <div class="card-header d-flex align-items-center">
                @*<h4>form</h4>*@
            </div>
            <div class="card-body">

                @using (Html.BeginForm())
                {

                    @Html.ValidationSummary(true)
                    <div class="form-group">
                        @Html.Label("Select Your User Type", new { @class = "col-md-2 control-label" })
                        <div class="col-md-10">
                            @Html.DropDownList("Name")
                        </div>
                    </div>
                    <div class="form-group">
                        @Html.Label("Select Your User", new { @class = "col-md-2 control-label" })
                        <div class="col-md-10">
                            @Html.DropDownList("Id")
                        </div>
                    </div>
                    <p>
                        <input type="text" id="nepali-datepicker" placeholder="Select Nepali Date" />
                    </p>




                    <div class="form-group">
                        @*<button type="submit" class="btn btn-secondary"><i class="fa fa-angle-double-left">&nbsp;</i> Back</button> &nbsp; &nbsp; &nbsp;*@
                        <button type="submit" class="btn btn-primary"><i class="fa fa-floppy-o">&nbsp;</i>सुरक्छित गर्नुहोस</button>
                    </div>

                }
            </div>
        </div>
    </div>
</div>
<link href="~/Content/NepaliDatePicker.css" rel="stylesheet" />
<script src="~/Scripts/NepaliDatePicker.min.js"></script>


<script type="text/javascript">
    window.onload = function () {
        var mainInput = document.getElementById("nepali-datepicker");
        mainInput.nepaliDatePicker();
    };
</script>

