## Ignore Visual Studio temporary files, build results, and
## files generated by popular Visual Studio add-ons.

# User-specific files
*.rsuser
*.suo
*.user
*.userosscache
*.sln.docstates

# Build results
[Dd]ebug/
[Rr]elease/
x64/
x86/
[Aa][Rr][Mm]/
[Aa][Rr][Mm]64/
bld/
[Bb]in/
[Oo]bj/
[Ll]og/

# Visual Studio cache/options
.vs/

# ASP.NET Scaffolding
ScaffoldingReadMe.txt

# IIS Express
iisexpress/
*.vspscc
*.vssscc

# Rider
.idea/

# VS Code
.vscode/

# NuGet
*.nupkg
*.snupkg
packages/
!packages/build/
*.nuget.props
*.nuget.targets

# Azure
PublishScripts/
*.azurePubxml

# Entity Framework
*.edmx.diagram

# SQL Server files
*.mdf
*.ldf

# Windows image/file cache
Thumbs.db
ehthumbs.db
Desktop.ini

# OS generated files
.DS_Store

# Test Results
[Tt]est[Rr]esult*/
[Bb]uild[Ll]og.*

# Resharper
_ReSharper*/
*.[Rr]e[Ss]harper
*.DotSettings.user

# DotCover
*.dotCover

# NCrunch
_NCrunch_*
.*crunch*.local.xml

# StyleCop
StyleCopReport.xml

# Logs
*.log

# Temp files
*.tmp
*.temp

# Backup files
*.bak
*.backup

# Node modules (if frontend included)
node_modules/

# npm logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Environment files
.env
.env.*

# Coverage reports
coverage/
*.coverage
*.coveragexml

# Generated files
Generated_Code/

# Publish output
publish/
wwwroot/dist/

# JetBrains Rider
*.sln.iml

# Docker
docker-compose.override.yml

# Local database
App_Data/

# Blazor/WebAssembly cache
service-worker-assets.js

# Certificates
*.pfx

# Secrets
secrets.json
appsettings.Development.json